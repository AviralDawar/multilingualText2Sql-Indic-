{"pair_id": "7a3b84bc", "question": "列出位于state“Andhra Pradesh”的所有district名称，并按district名称的字母顺序排序。", "gold_sql": "SELECT T1.DISTRICT_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID WHERE T2.STATE_NAME = 'Andhra Pradesh' ORDER BY T1.DISTRICT_NAME", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "57e740c7", "question": "列出每个州的名称及其关联的地区 ID 总数，并按地区数量从高到低排序。", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T2.DISTRICT_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T2.DISTRICT_ID) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "cfe28a36", "question": "对于名为“India”的国家，列出每个邦的名称以及该邦内地区的总数，确保只包含至少有一个地区的邦，并按地区数量从高到低排序。", "gold_sql": "SELECT T2.STATE_NAME, COUNT(T3.DISTRICT_ID) FROM DIM_COUNTRY AS T1 JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T1.COUNTRY_NAME = 'India' GROUP BY T2.STATE_NAME HAVING COUNT(T3.DISTRICT_ID) > 0 ORDER BY COUNT(T3.DISTRICT_ID) DESC;", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "58dafef6", "question": "列出各州的州名以及每个州的地区 ID 总数，按地区数量降序排列，并且只显示前 5 条结果。", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T2.DISTRICT_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T2.DISTRICT_ID) DESC LIMIT 5", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "4e414781", "question": "列出名称为“Chittoor”的地区所属的国家名称、州名称和地区名称，确保这些条目中至少存在一条国家记录，并按州名称字母顺序排序，然后按国家名称字母顺序排序。", "gold_sql": "SELECT T3.COUNTRY_NAME, T2.STATE_NAME, T1.DISTRICT_NAME FROM DIM_DISTRICT AS T1 INNER JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID INNER JOIN DIM_COUNTRY AS T3 ON T2.COUNTRY_ID = T3.COUNTRY_ID WHERE T1.DISTRICT_NAME = 'Chittoor' GROUP BY T3.COUNTRY_NAME, T2.STATE_NAME, T1.DISTRICT_NAME HAVING COUNT(T3.COUNTRY_ID) >= 1 ORDER BY T2.STATE_NAME ASC, T3.COUNTRY_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "29c4da79", "question": "列出名为“Andhra Pradesh”的州的各区名称，并按区名的字母顺序分组和排序。", "gold_sql": "SELECT T3.DISTRICT_NAME FROM DIM_COUNTRY AS T1 INNER JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID INNER JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T2.STATE_NAME = 'Andhra Pradesh' GROUP BY T3.DISTRICT_NAME ORDER BY T3.DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "9432abec", "question": "列出所有条目的地区名称、州名称和国家名称，并按地区名称的字母顺序排序。", "gold_sql": "SELECT T1.DISTRICT_NAME, T2.STATE_NAME, T3.COUNTRY_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_COUNTRY AS T3 ON T2.COUNTRY_ID = T3.COUNTRY_ID ORDER BY T1.DISTRICT_NAME", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "c0d57f54", "question": "列出“India”这个国家中各州的州名及其对应的地区 ID 总数，仅包括地区数量大于零的州，并显示地区数量最多的前 5 个州。", "gold_sql": "SELECT T2.STATE_NAME, COUNT(T3.DISTRICT_ID) FROM DIM_COUNTRY AS T1 JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T1.COUNTRY_NAME = 'India' GROUP BY T2.STATE_NAME HAVING COUNT(T3.DISTRICT_ID) > 0 ORDER BY COUNT(T3.DISTRICT_ID) DESC LIMIT 5", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "ca1147c3", "question": "列出位于state“Andhra Pradesh”的ULB、RLB或village名称，按village名称分组并按字母顺序排序。", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "ecf4ae55", "question": "列出位于国家“India”的唯一state名称，并将它们与在state“Andhra Pradesh”内找到的唯一district名称列表合并。", "gold_sql": "SELECT DISTINCT T1.STATE_NAME FROM DIM_STATE AS T1 JOIN DIM_COUNTRY AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID WHERE T2.COUNTRY_NAME = 'India' UNION SELECT DISTINCT T3.DISTRICT_NAME FROM DIM_DISTRICT AS T3 JOIN DIM_STATE AS T4 ON T3.STATE_ID = T4.STATE_ID WHERE T4.STATE_NAME = 'Andhra Pradesh';", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "a6f826b8", "question": "列出位于state“Andhra Pradesh”且district为“Chittoor”的ULB、RLB或village名称，按village名称分组并按字母顺序排序。", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' AND T2.DISTRICT_NAME = 'Chittoor' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "5b6160c2", "question": "列出每个州的名称及其关联的位置 ID 数量，按州名称分组，并按数量从高到低排序。", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T3.LOCATION_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T3.LOCATION_ID) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "bd14e998", "question": "列出位于state“Andhra Pradesh”且district为“Chittoor”的ULB RLB village名称，按village名称分组并按字母顺序排序。", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 INNER JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID INNER JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' AND T2.DISTRICT_NAME = 'Chittoor' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "18a2fb3f", "question": "列出所有地点的州名称、国家/地区 ID、区名称以及 ULB/RLB 村庄名称，并按村庄名称排序，然后按区名称排序。", "gold_sql": "SELECT T3.STATE_NAME, T3.COUNTRY_ID, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID ORDER BY T1.ULB_RLB_VILLAGE_NAME, T2.DISTRICT_NAME", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "a63fc1b8", "question": "对于state“Andhra Pradesh”，列出各district名称以及不同ULB/RLB village名称的数量，按district名称分组，并按village数量从高到低排序，仅显示前10条结果。", "gold_sql": "SELECT T2.DISTRICT_NAME, COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' GROUP BY T2.DISTRICT_NAME ORDER BY COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) DESC LIMIT 10", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "8ec520f2", "question": "对于state“Bihar”，列出每个district名称以及不同ULB/RLB village名称的总数，只包含village数量大于零的district，并显示数量最高的前10个district。", "gold_sql": "SELECT T2.DISTRICT_NAME, COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Bihar' GROUP BY T2.DISTRICT_NAME HAVING COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) > 0 ORDER BY COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) DESC LIMIT 10", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "5fca6279", "question": "列出州名称、地区名称以及 ULB/RLB 村庄名称，按州、地区和村庄名称分组，并按村庄名称的字母顺序排序。", "gold_sql": "SELECT T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID GROUP BY T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME;", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "bc7a27e8", "question": "列出位于state“Assam”、“Andhra Pradesh”或“Bihar”的地点的state名称、district名称以及ULB/RLB village名称，排除district为“Prakasam”的地点；按state、district和village名称分组，并按village和district的字母顺序排序。", "gold_sql": "SELECT T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 INNER JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID INNER JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T3.STATE_NAME IN ('Assam', 'Andhra Pradesh', 'Bihar') AND T2.DISTRICT_NAME NOT IN ('Prakasam') GROUP BY T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC, T2.DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "57faa295", "question": "列出位于“Chittoor”地区的分区名称以及 ULB/RLB 村庄名称，排除同时也出现在“Prakasam”地区的任何分区，并按分区和村庄名称分组，按分区名称字母顺序排序。", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_LOCATION AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID WHERE T1.DISTRICT_NAME = 'Chittoor' AND T2.SUB_DISTRICT_NAME NOT IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_DISTRICT AS T3 JOIN DIM_LOCATION AS T4 ON T3.DISTRICT_ID = T4.DISTRICT_ID WHERE T3.DISTRICT_NAME = 'Prakasam') GROUP BY T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME ORDER BY T2.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "4ba18ccf", "question": "列出按字母顺序排序的sub-district名称，这些sub-district中至少包含一个被归类为“Rural”的sector，并且至少包含一个被归类为“Urban”的sector。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_SECTOR_CATEGORY AS T3 ON T2.SECTOR_ID = T3.SECTOR_ID GROUP BY T1.SUB_DISTRICT_NAME HAVING COUNT(DISTINCT CASE WHEN T3.SECTOR_CATEGORY = 'Rural' THEN T3.SECTOR_CATEGORY END) > 0 AND COUNT(DISTINCT CASE WHEN T3.SECTOR_CATEGORY = 'Urban' THEN T3.SECTOR_CATEGORY END) > 0 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "5d1894c5", "question": "列出位于state“Andhra Pradesh”或“Assam”的所有district的state名称和district名称，并按state名称排序结果。", "gold_sql": "SELECT T1.STATE_NAME, T2.DISTRICT_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' OR T1.STATE_NAME = 'Assam' ORDER BY T1.STATE_NAME", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "2d406297", "question": "对于2013年普查年度，列出establishments总数超过50,000的sector类别，特别筛选住宅或商业状态为0.000的记录，并按所得sector类别降序排序。", "gold_sql": "SELECT T2.SECTOR_CATEGORY FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_SECTOR_CATEGORY AS T2 ON T1.SECTOR_ID = T2.SECTOR_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T1.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T2.SECTOR_CATEGORY HAVING SUM(T1.TOTAL_ESTABLISHMENTS) > 50000 ORDER BY T2.SECTOR_CATEGORY DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "4a0348e2", "question": "对于最近可获得的时间段，列出住宅或商业状态为 0.000 的记录中，总机构数量大于 50,000 的行业类别，并按总机构数量降序排列结果。", "gold_sql": "SELECT T2.SECTOR_CATEGORY FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_SECTOR_CATEGORY AS T2 ON T1.SECTOR_ID = T2.SECTOR_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID WHERE T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) AND T1.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T2.SECTOR_CATEGORY HAVING SUM(T1.TOTAL_ESTABLISHMENTS) > 50000 ORDER BY SUM(T1.TOTAL_ESTABLISHMENTS) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "b353514c", "question": "列出每个年份的人口普查年份和渔业水产养殖总估计值，确保总计至少为 0.000，并按渔业水产养殖总估计值降序排列结果。", "gold_sql": "SELECT T2.CENSUS_YEAR, SUM(T1.EST_FISHING_AQUACULTURE) FROM FACT_PRIMARY_SECTOR AS T1 JOIN DIM_TIME AS T2 ON T1.TIME_ID = T2.TIME_ID JOIN DIM_LOCATION AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID GROUP BY T2.CENSUS_YEAR HAVING SUM(T1.EST_FISHING_AQUACULTURE) >= 0.000 ORDER BY SUM(T1.EST_FISHING_AQUACULTURE) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "9a4faed8", "question": "对于2013年普查年度，列出估算牲畜数量大于零的地点所属的分区名称以及 ULB/RLB 村庄名称，但排除在2013年估算住宅-商业数量也大于零的任何地点；按其分区和村庄名称分组，并按分区名称的字母顺序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_PRIMARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_LIVESTOCK > 0.000 AND T1.LOCATION_ID NOT IN ( SELECT T4.LOCATION_ID FROM FACT_ESTABLISHMENT_TOTALS AS T4 JOIN DIM_TIME AS T5 ON T4.TIME_ID = T5.TIME_ID WHERE T5.CENSUS_YEAR = '2013' AND T4.EST_RESIDENTIAL_COMMERCIAL > 0.000 ) GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING COUNT(T2.FACT_PRIMARY_SECTOR_ID) >= 1 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "db9784c3", "question": "按字母顺序列出ULB、RLB或village的名称，这些地点的livestock establishments总和大于零；具体筛选地点条件为单个livestock establishment计数大于零，且住宅-商业establishments计数恰好为零。", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_PRIMARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_ESTABLISHMENT_TOTALS AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID WHERE T2.EST_LIVESTOCK > 0.000 AND T3.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_LIVESTOCK) > 0.000 ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "f2bb09f0", "question": "对于2013年普查年度，列出分区名称以及 ULB/RLB 村庄名称，其中渔业和水产养殖机构数量大于或等于 0，且居住兼商业机构数量大于或等于 0，并确保只包含在机构总数中至少有一条记录的地点，同时按分区名称的字母顺序对结果进行排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_PRIMARY_SECTOR AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID AND T2.TIME_ID = T3.TIME_ID JOIN DIM_TIME AS T4 ON T2.TIME_ID = T4.TIME_ID WHERE T3.EST_FISHING_AQUACULTURE >= 0.000 AND T2.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T4.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING COUNT(T2.FACT_ESTABLISHMENT_TOTALS_ID) >= 1 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "244da596", "question": "列出林业和伐木机构数量大于零或住宅和商业机构数量大于零的地点对应的 ULB RLB 村庄名称，并按字母顺序排序。", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_PRIMARY_SECTOR AS T3 ON T2.LOCATION_ID = T3.LOCATION_ID WHERE T3.EST_FORESTRY_LOGGING > 0.000 OR T2.EST_RESIDENTIAL_COMMERCIAL > 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "a1c69c64", "question": "列出分区名称和人口普查年份，以及机构总数之和和住宅商业机构数之和，按分区和人口普查年份分组，并按人口普查年份的时间顺序排序。", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME, T3.CENSUS_YEAR, SUM(T1.TOTAL_ESTABLISHMENTS), SUM(T1.EST_RESIDENTIAL_COMMERCIAL) FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_LOCATION AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID GROUP BY T2.SUB_DISTRICT_NAME, T3.CENSUS_YEAR ORDER BY T3.CENSUS_YEAR ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "cd33eb91", "question": "对于最新可用的人口普查年份，列出每个分区名称以及估算住宅商业机构总数之和，筛选估算住宅商业值为 0.000 的记录，并按总和降序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_RESIDENTIAL_COMMERCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) AND T2.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_RESIDENTIAL_COMMERCIAL) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "f387f406", "question": "对于2013年人口普查年度，列出每个分区名称以及住宅或商业状态为0.000时的机构总数之和，仅包括机构总数之和大于0.000的分区，并按机构总数之和降序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.TOTAL_ESTABLISHMENTS) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 ORDER BY SUM(T2.TOTAL_ESTABLISHMENTS) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "e03e8e45", "question": "对于2013年人口普查年度，列出各分区名称以及估算的住宅和商业机构总数之和，并显示总数最高的前10个分区。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_RESIDENTIAL_COMMERCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_RESIDENTIAL_COMMERCIAL) DESC LIMIT 10", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "77a4e2c5", "question": "列出在2013年普查年度中，机构总数大于零但住宅或商业机构数量为零的分区名称，并按字母顺序排列。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 AND SUM(T2.EST_RESIDENTIAL_COMMERCIAL) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "fc696454", "question": "列出2013年普查年度中，机构总数大于零且住宅兼商业机构数量恰好为零的分区名称。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 AND SUM(T2.EST_RESIDENTIAL_COMMERCIAL) = 0.000", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "63892277", "question": "列出人口普查年份为“2013”的分区名称，其中住宅—商业机构数量大于或等于 0.000，并确保这些分区也出现在该年份满足相同条件的分区集合中；结果按分区名称升序显示。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T2.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T3.CENSUS_YEAR = '2013' AND T1.SUB_DISTRICT_NAME IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T4 JOIN FACT_ESTABLISHMENT_TOTALS AS T5 ON T4.LOCATION_ID = T5.LOCATION_ID JOIN DIM_TIME AS T6 ON T5.TIME_ID = T6.TIME_ID WHERE T5.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T6.CENSUS_YEAR = '2013') GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "803f28ef", "question": "对于2013年人口普查年度，请按字母顺序列出满足以下任一条件的分区名称：住宅商业机构总数大于0，或 ULB RLB 村庄名称为“Pilpilow”。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND (T2.EST_RESIDENTIAL_COMMERCIAL > 0.000 OR T1.ULB_RLB_VILLAGE_NAME = 'Pilpilow') GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "3f75c9fb", "question": "对于2013年人口普查年度，列出每个分区的名称以及其制造业和建筑业机构数量之和，并按分区名称分组并按字母顺序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "162deae6", "question": "对于2013年普查年度，列出次级行政区名称以及ULB、RLB或村庄名称，其中第二产业中制造业的估算总量大于50，并按制造业估算总量从高到低排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_MANUFACTURING) > 50 ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "7ead6ddc", "question": "对于最近可获得的时期，请列出总估算制造业产值大于50的 ULB、RLB 或村庄的名称。", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_MANUFACTURING) > 50", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "cc274a6c", "question": "对于可获得的最近一次人口普查年份，列出每个分区的名称以及制造业和建筑业机构数量的总和，仅包括该合计大于零的分区，并按总和降序排列结果。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) > 0.000 ORDER BY SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "3b6a0b2a", "question": "对于最近可获得的时间段，列出总估算制造业价值大于 50 的 ULB、RLB 或村庄名称，并按其总估算制造业价值降序显示这些名称。", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_MANUFACTURING) > 50 ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "5acff517", "question": "对于2013年普查年度，列出每个分区的名称及其制造业估算总值，并按制造业估算总值降序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "34765acb", "question": "对于可获得的最新普查年份，列出每个sub-district名称及其估算制造业总值，并按估算制造业总值从高到低排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "09a75ff6", "question": "对于2013年经济普查年度，列出每个sub-district名称以及估算制造业总值和估算建筑业总值，确保估算制造业总值至少为0.000，并按估算制造业总值降序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING), SUM(T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING) >= 0.000 ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "cf374eef", "question": "列出2013年经济普查中估算制造业总值大于0且估算建筑业总值恰好等于0的sub-district名称，并按sub-district名称分组并按字母顺序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING) > 0.000 AND SUM(T2.EST_CONSTRUCTION) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "6ad0ce72", "question": "列出2013年普查年度中，制造业机构数量大于500或建筑业机构数量大于200的分区名称，并按分区名称分组。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND (T2.EST_MANUFACTURING > 500 OR T2.EST_CONSTRUCTION > 200) GROUP BY T1.SUB_DISTRICT_NAME", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "936c601a", "question": "对于2013年经济普查年度，列出每个sub-district名称以及估算制造业总值和估算建筑业总值，并按sub-district名称分组并按字母顺序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING), SUM(T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "49d857a2", "question": "列出 census year 为“2013”的 sub-district 名称，其中总估计制造业大于500或总估计建筑业大于200，并按 sub-district 名称的字母顺序对结果进行排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING) > 500 UNION SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_CONSTRUCTION) > 200 ORDER BY SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "ff9ec42b", "question": "对于2013年普查年度，列出总估算住宿和餐饮费用至少为0.000的分区名称以及ULB/RLB村庄名称，并按分区名称的字母顺序对结果进行排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_ACCOMMODATION_FOOD) >= 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "f5e1ad47", "question": "对于可获得的最新经济普查年份，列出各sub-district名称以及估算运输和仓储总成本与估算住宿和餐饮总成本；按sub-district分组，并按估算运输和仓储总成本降序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_TRANSPORT_STORAGE), SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_TRANSPORT_STORAGE) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "0fe8bc91", "question": "对于2013年经济普查年度，列出每个sub-district名称，以及估算运输和仓储总成本与估算住宿和餐饮总成本，并按sub-district名称分组并按字母顺序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_TRANSPORT_STORAGE), SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "e1ccb964", "question": "对于2013年经济普查年度，列出每个sub-district名称以及估算住宿和餐饮总成本，并按总成本降序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_ACCOMMODATION_FOOD) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "e7fc6264", "question": "对于2013年经济普查年度，列出估算住宿和餐饮总成本最高的前10个sub-district的名称及其估算住宿和餐饮总成本。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_ACCOMMODATION_FOOD) DESC LIMIT 10", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "579e0a14", "question": "列出2013年普查年度中运输和仓储估算值大于零的所有分区名称，但要明确排除同年住宿和餐饮估算值也大于零的任何分区，并按分区名称的字母顺序对结果进行排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_TRANSPORT_STORAGE) > 0.000 AND T1.SUB_DISTRICT_NAME NOT IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T4 JOIN FACT_TRANSPORT_HOSPITALITY AS T5 ON T4.LOCATION_ID = T5.LOCATION_ID JOIN DIM_TIME AS T6 ON T5.TIME_ID = T6.TIME_ID WHERE T6.CENSUS_YEAR = '2013' AND T5.EST_ACCOMMODATION_FOOD > 0.000) ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "a29de23a", "question": "列出2013年普查年度中，估算运输仓储值和估算住宿餐饮值均大于零的分区名称，并按字母顺序排列。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_TRANSPORT_STORAGE > 0.000 AND T2.EST_ACCOMMODATION_FOOD > 0.000 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "5a214bd0", "question": "列出2013年中估算运输仓储总和至少为0.000且估算住宿餐饮总和大于0.000的sub-district名称，并按sub-district名称的字母顺序对结果进行排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_TRANSPORT_STORAGE) >= 0.000 AND SUM(T2.EST_ACCOMMODATION_FOOD) > 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "f89a1184", "question": "列出每个分区及人口普查年份的分区名称和人口普查年份，以及估算教育值与估算人类健康和社会价值总和；仅包括该总和至少为 0.000 的记录，并按人口普查年份和该总和的降序排列。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T2.CENSUS_YEAR, SUM(T3.EST_EDUCATION + T3.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 INNER JOIN FACT_EDUCATION_HEALTH AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID INNER JOIN DIM_TIME AS T2 ON T3.TIME_ID = T2.TIME_ID GROUP BY T1.SUB_DISTRICT_NAME, T2.CENSUS_YEAR HAVING SUM(T3.EST_EDUCATION + T3.EST_HUMAN_HEALTH_SOCIAL) >= 0.000 ORDER BY T2.CENSUS_YEAR DESC, SUM(T3.EST_EDUCATION + T3.EST_HUMAN_HEALTH_SOCIAL) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "a7c2466f", "question": "列出估计运输和仓储值大于50或估计住宿和餐饮服务值大于50的 ULB、RLB 或村庄名称，并按村庄名称的字母顺序排序。", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.EST_TRANSPORT_STORAGE > 50 OR T2.EST_ACCOMMODATION_FOOD > 50 ORDER BY T1.ULB_RLB_VILLAGE_NAME", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "57101395", "question": "对于2013年经济普查年度，请列出估算人类健康和社会工作值大于50的ULB RLB village名称。", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_HUMAN_HEALTH_SOCIAL > 50", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "e9093393", "question": "对于2013年普查年度，列出总估算人类健康与社会工作值大于50的ULB、RLB或村庄名称，并按该总和值降序排列结果。", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_HUMAN_HEALTH_SOCIAL) > 50 ORDER BY SUM(T2.EST_HUMAN_HEALTH_SOCIAL) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "4b45c0d6", "question": "对于可获得的最新经济普查年份，列出每个ULB RLB village名称及其人类健康和社会establishments总和，并按总和降序排序。", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 INNER JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID INNER JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY SUM(T2.EST_HUMAN_HEALTH_SOCIAL) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "e9ab06a4", "question": "对于2013年经济普查年度，列出各sub-district名称以及估算教育与人类健康和社会服务总和，并按该合计值降序排列，给出前5个sub-district。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) DESC LIMIT 5", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "f9a67de8", "question": "列出2013年普查年度中，总估算人类健康与社会工作值大于0.000且总估算教育值恰好等于0.000的分区名称，并按分区名称的字母顺序排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_HUMAN_HEALTH_SOCIAL) > 0.000 AND SUM(T2.EST_EDUCATION) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "ad513455", "question": "对于2013年人口普查年度，列出估算的人类健康与社会工作数值大于0.000，但估算的教育总和恰好为0.000的分区名称，并按分区名称的字母顺序排列。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_HUMAN_HEALTH_SOCIAL > 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_EDUCATION) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "c197494e", "question": "对于最近可获得的人口普查年份，列出各分区名称以及教育与人类健康和社会服务估算值的总和，并显示合计总数最高的前5个分区。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) DESC LIMIT 5", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "08065fd9", "question": "列出 2013 年人口普查中各分区的名称，按分区名称分组，其中估算教育总和以及估算人类健康与社会工作总和均至少为 0.000，并按分区名称的字母顺序对结果进行排序。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_EDUCATION) >= 0.000 AND SUM(T2.EST_HUMAN_HEALTH_SOCIAL) >= 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "09a62cf5", "question": "对于2013年人口普查年度，请列出ULB RLB村庄名称及其对应的分区名称，具体针对估算教育值总和至少为1.000且估算人类健康与社会服务值总和至少为1.000的地点，并按分区名称的字母顺序排序。", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME, T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.ULB_RLB_VILLAGE_NAME, T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_EDUCATION) >= 1.000 AND SUM(T2.EST_HUMAN_HEALTH_SOCIAL) >= 1.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "d5b2cc85", "question": "列出女性拥有的机构总数大于男性拥有的机构总数的所有分区名称以及对应的 ULB/RLB 村庄名称。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_OWNED_BY_FEMALE) > SUM(T2.EST_OWNED_BY_MALE)", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "3222d0c9", "question": "对于可获得的最新人口普查年份，按次区划分并按总数从高到低排序，列出每个次区名称以及女性拥有的机构总数。", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
{"pair_id": "9e644c4d", "question": "对于 2013 年普查年度，仅考虑可用的最大时间 ID 所对应的记录，列出女性拥有的机构总数恰好为零的 ULB、RLB 或村庄名称。", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_OWNED_BY_FEMALE) = 0.000", "predicted_sql": "", "raw_output": "", "em": 0, "ex": 0, "error": "Empty prediction"}
