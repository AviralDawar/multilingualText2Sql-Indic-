{"pair_id": "57e740c7", "question": "Elenca il nome di ciascuno stato e il conteggio totale degli ID dei distretti ad esso associati, ordinati dal numero più alto di distretti al più basso.", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T2.DISTRICT_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T2.DISTRICT_ID) DESC", "predicted_sql": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nGROUP BY ds.state_id, ds.state_name\nORDER BY total_districts DESC;", "raw_output": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nGROUP BY ds.state_id, ds.state_name\nORDER BY total_districts DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 36. Pred count: 36."}
{"pair_id": "29c4da79", "question": "Elenca i nomi dei distretti dello stato chiamato \"Andhra Pradesh\", raggruppati e ordinati alfabeticamente per nome del distretto.", "gold_sql": "SELECT T3.DISTRICT_NAME FROM DIM_COUNTRY AS T1 INNER JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID INNER JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T2.STATE_NAME = 'Andhra Pradesh' GROUP BY T3.DISTRICT_NAME ORDER BY T3.DISTRICT_NAME ASC", "predicted_sql": "SELECT district_name\nFROM dim_district\nWHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh')\nGROUP BY district_name\nORDER BY district_name;", "raw_output": "SELECT district_name\nFROM dim_district\nWHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh')\nGROUP BY district_name\nORDER BY district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "cfe28a36", "question": "Per il paese denominato \"India\", elenca il nome di ciascuno stato insieme al conteggio totale dei distretti all'interno di quello stato, assicurandoti che siano inclusi solo gli stati con almeno un distretto e che i risultati siano ordinati dal numero più alto al più basso di distretti.", "gold_sql": "SELECT T2.STATE_NAME, COUNT(T3.DISTRICT_ID) FROM DIM_COUNTRY AS T1 JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T1.COUNTRY_NAME = 'India' GROUP BY T2.STATE_NAME HAVING COUNT(T3.DISTRICT_ID) > 0 ORDER BY COUNT(T3.DISTRICT_ID) DESC;", "predicted_sql": "SELECT s.state_name, COUNT(d.district_id) AS total_districts\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_country c ON s.country_id = c.country_id\nWHERE c.country_name ILIKE 'India'\nGROUP BY s.state_id, s.state_name\nHAVING COUNT(d.district_id) > 0\nORDER BY total_districts DESC;", "raw_output": "SELECT s.state_name, COUNT(d.district_id) AS total_districts\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_country c ON s.country_id = c.country_id\nWHERE c.country_name ILIKE 'India'\nGROUP BY s.state_id, s.state_name\nHAVING COUNT(d.district_id) > 0\nORDER BY total_districts DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 36. Pred count: 36."}
{"pair_id": "7a3b84bc", "question": "Elenca i nomi dei distretti di tutti i distretti situati nello stato di 'Andhra Pradesh', ordinati alfabeticamente per nome del distretto.", "gold_sql": "SELECT T1.DISTRICT_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID WHERE T2.STATE_NAME = 'Andhra Pradesh' ORDER BY T1.DISTRICT_NAME", "predicted_sql": "SELECT district_name\nFROM dim_district\nWHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh')\nORDER BY district_name;", "raw_output": "SELECT district_name\nFROM dim_district\nWHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh')\nORDER BY district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "4e414781", "question": "Elenca il nome del paese, il nome dello stato e il nome del distretto per i distretti denominati 'Chittoor', assicurandoti che esista almeno un record del paese per queste voci, e ordina i risultati alfabeticamente prima per nome dello stato e poi per nome del paese.", "gold_sql": "SELECT T3.COUNTRY_NAME, T2.STATE_NAME, T1.DISTRICT_NAME FROM DIM_DISTRICT AS T1 INNER JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID INNER JOIN DIM_COUNTRY AS T3 ON T2.COUNTRY_ID = T3.COUNTRY_ID WHERE T1.DISTRICT_NAME = 'Chittoor' GROUP BY T3.COUNTRY_NAME, T2.STATE_NAME, T1.DISTRICT_NAME HAVING COUNT(T3.COUNTRY_ID) >= 1 ORDER BY T2.STATE_NAME ASC, T3.COUNTRY_NAME ASC", "predicted_sql": "SELECT DISTINCT c.country_name, s.state_name, d.district_name\nFROM dim_country c\nJOIN dim_state s ON c.country_id = s.country_id\nJOIN dim_district d ON s.state_id = d.state_id\nWHERE d.district_name ILIKE 'Chittoor'\nORDER BY s.state_name, c.country_name;", "raw_output": "SELECT DISTINCT c.country_name, s.state_name, d.district_name\nFROM dim_country c\nJOIN dim_state s ON c.country_id = s.country_id\nJOIN dim_district d ON s.state_id = d.state_id\nWHERE d.district_name ILIKE 'Chittoor'\nORDER BY s.state_name, c.country_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "58dafef6", "question": "Elenca i nomi degli stati e il conteggio totale degli ID dei distretti per ciascuno stato, ordinati in base al numero di distretti in ordine decrescente, e mostra solo i primi 5 risultati.", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T2.DISTRICT_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T2.DISTRICT_ID) DESC LIMIT 5", "predicted_sql": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nGROUP BY ds.state_id, ds.state_name\nORDER BY total_districts DESC\nLIMIT 5;", "raw_output": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nGROUP BY ds.state_id, ds.state_name\nORDER BY total_districts DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "c0d57f54", "question": "Elenca i nomi degli stati e il conteggio totale degli ID dei distretti per ciascuno stato del paese \"India\", includendo solo gli stati che hanno più di zero distretti, e mostra i primi 5 stati con il maggior numero di distretti.", "gold_sql": "SELECT T2.STATE_NAME, COUNT(T3.DISTRICT_ID) FROM DIM_COUNTRY AS T1 JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T1.COUNTRY_NAME = 'India' GROUP BY T2.STATE_NAME HAVING COUNT(T3.DISTRICT_ID) > 0 ORDER BY COUNT(T3.DISTRICT_ID) DESC LIMIT 5", "predicted_sql": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nJOIN dim_district dd ON ds.state_id = dd.state_id\nJOIN dim_country dc ON ds.country_id = dc.country_id\nWHERE dc.country_name ILIKE 'India'\nGROUP BY ds.state_id, ds.state_name\nHAVING COUNT(dd.district_id) > 0\nORDER BY total_districts DESC\nLIMIT 5;", "raw_output": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nJOIN dim_district dd ON ds.state_id = dd.state_id\nJOIN dim_country dc ON ds.country_id = dc.country_id\nWHERE dc.country_name ILIKE 'India'\nGROUP BY ds.state_id, ds.state_name\nHAVING COUNT(dd.district_id) > 0\nORDER BY total_districts DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "9432abec", "question": "Elenca il nome del distretto, il nome dello stato e il nome del paese per tutte le voci, ordinati alfabeticamente in base al nome del distretto.", "gold_sql": "SELECT T1.DISTRICT_NAME, T2.STATE_NAME, T3.COUNTRY_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_COUNTRY AS T3 ON T2.COUNTRY_ID = T3.COUNTRY_ID ORDER BY T1.DISTRICT_NAME", "predicted_sql": "SELECT d.district_name, s.state_name, c.country_name\nFROM dim_district d\nJOIN dim_state s ON d.state_id = s.state_id\nJOIN dim_country c ON s.country_id = c.country_id\nORDER BY d.district_name;", "raw_output": "SELECT d.district_name, s.state_name, c.country_name\nFROM dim_district d\nJOIN dim_state s ON d.state_id = s.state_id\nJOIN dim_country c ON s.country_id = c.country_id\nORDER BY d.district_name;", "em": 1, "ex": 1, "error": null}
{"pair_id": "ecf4ae55", "question": "Elenca i nomi unici degli stati situati nel paese \"India\" e combinali con un elenco dei nomi unici dei distretti presenti nello stato di \"Andhra Pradesh\".", "gold_sql": "SELECT DISTINCT T1.STATE_NAME FROM DIM_STATE AS T1 JOIN DIM_COUNTRY AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID WHERE T2.COUNTRY_NAME = 'India' UNION SELECT DISTINCT T3.DISTRICT_NAME FROM DIM_DISTRICT AS T3 JOIN DIM_STATE AS T4 ON T3.STATE_ID = T4.STATE_ID WHERE T4.STATE_NAME = 'Andhra Pradesh';", "predicted_sql": "SELECT DISTINCT ds.state_name\nFROM dim_state ds\nJOIN dim_country dc ON ds.country_id = dc.country_id\nWHERE dc.country_name ILIKE 'India'\nUNION\nSELECT DISTINCT dd.district_name\nFROM dim_district dd\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh';", "raw_output": "SELECT DISTINCT ds.state_name\nFROM dim_state ds\nJOIN dim_country dc ON ds.country_id = dc.country_id\nWHERE dc.country_name ILIKE 'India'\nUNION\nSELECT DISTINCT dd.district_name\nFROM dim_district dd\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh';", "em": 0, "ex": 1, "error": null}
{"pair_id": "ca1147c3", "question": "Elenca i nomi degli ULB, degli RLB o dei villaggi situati nello stato di \"Andhra Pradesh\", raggruppati e ordinati alfabeticamente per nome del villaggio.", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME", "predicted_sql": "SELECT DISTINCT ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh'\nORDER BY ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh'\nORDER BY ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5b6160c2", "question": "Elenca il nome di ciascuno stato e il numero di ID di località ad esso associati, raggruppati per nome dello stato e ordinati dal conteggio più alto al più basso.", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T3.LOCATION_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T3.LOCATION_ID) DESC", "predicted_sql": "SELECT ds.state_name, COUNT(DISTINCT dl.location_id) AS location_count\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nLEFT JOIN dim_location dl ON dd.district_id = dl.district_id\nGROUP BY ds.state_name\nORDER BY location_count DESC;", "raw_output": "SELECT ds.state_name, COUNT(DISTINCT dl.location_id) AS location_count\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nLEFT JOIN dim_location dl ON dd.district_id = dl.district_id\nGROUP BY ds.state_name\nORDER BY location_count DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a6f826b8", "question": "Elenca i nomi degli ULB, RLB o dei villaggi situati nello stato di 'Andhra Pradesh' e nel distretto di 'Chittoor', raggruppati e ordinati alfabeticamente per nome del villaggio.", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' AND T2.DISTRICT_NAME = 'Chittoor' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh'\n  AND dd.district_name ILIKE 'Chittoor'\nORDER BY ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh'\n  AND dd.district_name ILIKE 'Chittoor'\nORDER BY ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "bd14e998", "question": "Elenca i nomi dei village ULB RLB situati nello state 'Andhra Pradesh' e nel district 'Chittoor', raggruppati e ordinati alfabeticamente per il nome del village.", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 INNER JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID INNER JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' AND T2.DISTRICT_NAME = 'Chittoor' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh'\n  AND dd.district_name ILIKE 'Chittoor'\nORDER BY ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh'\n  AND dd.district_name ILIKE 'Chittoor'\nORDER BY ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a63fc1b8", "question": "Per lo stato dell'Andhra Pradesh, elenca i nomi dei distretti e il conteggio dei nomi di villaggi ULB/RLB distinti, raggruppati per nome del distretto e ordinati in base al numero più alto di villaggi, mostrando solo i primi 10 risultati.", "gold_sql": "SELECT T2.DISTRICT_NAME, COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' GROUP BY T2.DISTRICT_NAME ORDER BY COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) DESC LIMIT 10", "predicted_sql": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS distinct_village_count\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Andhra Pradesh'\nGROUP BY d.district_name\nORDER BY distinct_village_count DESC\nLIMIT 10;", "raw_output": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS distinct_village_count\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Andhra Pradesh'\nGROUP BY d.district_name\nORDER BY distinct_village_count DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "8ec520f2", "question": "Per lo stato del 'Bihar', elenca il nome di ciascun distretto e il conteggio totale dei nomi di villaggi ULB/RLB distinti, assicurandoti di includere solo i distretti con più di zero villaggi, e mostra i primi 10 distretti con i conteggi più alti.", "gold_sql": "SELECT T2.DISTRICT_NAME, COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Bihar' GROUP BY T2.DISTRICT_NAME HAVING COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) > 0 ORDER BY COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) DESC LIMIT 10", "predicted_sql": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS total_villages\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Bihar'\nGROUP BY d.district_id, d.district_name\nHAVING COUNT(DISTINCT l.ulb_rlb_village_name) > 0\nORDER BY total_villages DESC\nLIMIT 10;", "raw_output": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS total_villages\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Bihar'\nGROUP BY d.district_id, d.district_name\nHAVING COUNT(DISTINCT l.ulb_rlb_village_name) > 0\nORDER BY total_villages DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "18a2fb3f", "question": "Elenca il nome dello stato, l'ID del paese, il nome del distretto e il nome del villaggio ULB/RLB per tutte le località, ordinati per nome del villaggio e poi per nome del distretto.", "gold_sql": "SELECT T3.STATE_NAME, T3.COUNTRY_ID, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID ORDER BY T1.ULB_RLB_VILLAGE_NAME, T2.DISTRICT_NAME", "predicted_sql": "SELECT ds.state_name, dc.country_id, dd.district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nJOIN dim_country dc ON ds.country_id = dc.country_id\nORDER BY dl.ulb_rlb_village_name, dd.district_name;", "raw_output": "SELECT ds.state_name, dc.country_id, dd.district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nJOIN dim_country dc ON ds.country_id = dc.country_id\nORDER BY dl.ulb_rlb_village_name, dd.district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5fca6279", "question": "Elenca il nome dello stato, il nome del distretto e il nome del villaggio ULB/RLB, raggruppati per stato, distretto e nome del villaggio, e ordinati alfabeticamente per nome del villaggio.", "gold_sql": "SELECT T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID GROUP BY T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME;", "predicted_sql": "SELECT ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nGROUP BY ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nORDER BY dl.ulb_rlb_village_name;", "raw_output": "SELECT ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nGROUP BY ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nORDER BY dl.ulb_rlb_village_name;", "em": 1, "ex": 1, "error": null}
{"pair_id": "57faa295", "question": "Elenca i nomi dei sotto-distretti e i nomi dei villaggi ULB/RLB situati nel distretto di \"Chittoor\", escludendo eventuali sotto-distretti presenti anche nel distretto di \"Prakasam\", raggruppati per sotto-distretto e nome del villaggio e ordinati alfabeticamente per sotto-distretto.", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_LOCATION AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID WHERE T1.DISTRICT_NAME = 'Chittoor' AND T2.SUB_DISTRICT_NAME NOT IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_DISTRICT AS T3 JOIN DIM_LOCATION AS T4 ON T3.DISTRICT_ID = T4.DISTRICT_ID WHERE T3.DISTRICT_NAME = 'Prakasam') GROUP BY T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME ORDER BY T2.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nWHERE dd.district_name ILIKE 'Chittoor'\nAND dl.sub_district_name NOT IN (\n    SELECT DISTINCT dl2.sub_district_name\n    FROM dim_location dl2\n    JOIN dim_district dd2 ON dl2.district_id = dd2.district_id\n    WHERE dd2.district_name ILIKE 'Prakasam'\n)\nORDER BY dl.sub_district_name, dl.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nWHERE dd.district_name ILIKE 'Chittoor'\nAND dl.sub_district_name NOT IN (\n    SELECT DISTINCT dl2.sub_district_name\n    FROM dim_location dl2\n    JOIN dim_district dd2 ON dl2.district_id = dd2.district_id\n    WHERE dd2.district_name ILIKE 'Prakasam'\n)\nORDER BY dl.sub_district_name, dl.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "4ba18ccf", "question": "Elenca i nomi dei sub-district, ordinati alfabeticamente, che contengono almeno un settore classificato come 'Rural' e almeno un settore classificato come 'Urban'.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_SECTOR_CATEGORY AS T3 ON T2.SECTOR_ID = T3.SECTOR_ID GROUP BY T1.SUB_DISTRICT_NAME HAVING COUNT(DISTINCT CASE WHEN T3.SECTOR_CATEGORY = 'Rural' THEN T3.SECTOR_CATEGORY END) > 0 AND COUNT(DISTINCT CASE WHEN T3.SECTOR_CATEGORY = 'Urban' THEN T3.SECTOR_CATEGORY END) > 0 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nWHERE dsc.sector_category ILIKE 'Rural'\nINTERSECT\nSELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nWHERE dsc.sector_category ILIKE 'Urban'\nORDER BY sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nWHERE dsc.sector_category ILIKE 'Rural'\nINTERSECT\nSELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nWHERE dsc.sector_category ILIKE 'Urban'\nORDER BY sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "bc7a27e8", "question": "Elenca il nome dello stato, il nome del distretto e il nome del villaggio ULB/RLB per le località negli stati di Assam, Andhra Pradesh o Bihar, escludendo quelle nel distretto di Prakasam, raggruppati per stato, distretto e nome del villaggio e ordinati alfabeticamente per villaggio e distretto.", "gold_sql": "SELECT T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 INNER JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID INNER JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T3.STATE_NAME IN ('Assam', 'Andhra Pradesh', 'Bihar') AND T2.DISTRICT_NAME NOT IN ('Prakasam') GROUP BY T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC, T2.DISTRICT_NAME ASC", "predicted_sql": "SELECT ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE ANY (ARRAY['Assam', 'Andhra Pradesh', 'Bihar'])\n  AND dd.district_name NOT ILIKE 'Prakasam'\nGROUP BY ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nORDER BY dl.ulb_rlb_village_name, dd.district_name;", "raw_output": "SELECT ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE ANY (ARRAY['Assam', 'Andhra Pradesh', 'Bihar'])\n  AND dd.district_name NOT ILIKE 'Prakasam'\nGROUP BY ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nORDER BY dl.ulb_rlb_village_name, dd.district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5d1894c5", "question": "Elenca il nome dello stato e il nome del distretto per tutti i distretti situati negli stati di 'Andhra Pradesh' o 'Assam' e ordina i risultati per nome dello stato.", "gold_sql": "SELECT T1.STATE_NAME, T2.DISTRICT_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' OR T1.STATE_NAME = 'Assam' ORDER BY T1.STATE_NAME", "predicted_sql": "SELECT ds.state_name, dd.district_name\nFROM dim_state ds\nJOIN dim_district dd ON ds.state_id = dd.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh' OR ds.state_name ILIKE 'Assam'\nORDER BY ds.state_name;", "raw_output": "SELECT ds.state_name, dd.district_name\nFROM dim_state ds\nJOIN dim_district dd ON ds.state_id = dd.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh' OR ds.state_name ILIKE 'Assam'\nORDER BY ds.state_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "2d406297", "question": "Per l'anno di censimento 2013, elenca le categorie di settore in cui il numero totale di establishments supera 50,000, filtrando specificamente i record in cui lo stato residenziale o commerciale è 0.000, e ordina le categorie di settore risultanti in ordine decrescente.", "gold_sql": "SELECT T2.SECTOR_CATEGORY FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_SECTOR_CATEGORY AS T2 ON T1.SECTOR_ID = T2.SECTOR_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T1.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T2.SECTOR_CATEGORY HAVING SUM(T1.TOTAL_ESTABLISHMENTS) > 50000 ORDER BY T2.SECTOR_CATEGORY DESC", "predicted_sql": "SELECT dsc.sector_category\nFROM dim_sector_category dsc\nJOIN fact_establishment_totals fet ON dsc.sector_id = fet.sector_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.est_residential_commercial = 0.000\nGROUP BY dsc.sector_category\nHAVING SUM(fet.total_establishments) > 50000\nORDER BY SUM(fet.total_establishments) DESC;", "raw_output": "SELECT dsc.sector_category\nFROM dim_sector_category dsc\nJOIN fact_establishment_totals fet ON dsc.sector_id = fet.sector_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.est_residential_commercial = 0.000\nGROUP BY dsc.sector_category\nHAVING SUM(fet.total_establishments) > 50000\nORDER BY SUM(fet.total_establishments) DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 2. Pred count: 2."}
{"pair_id": "4a0348e2", "question": "Per il periodo di tempo più recente disponibile, elenca le categorie di settore in cui il numero totale di establishments è superiore a 50,000, specificamente per i record in cui lo stato residenziale o commerciale è 0.000, e ordina i risultati in base al numero totale di establishments in ordine decrescente.", "gold_sql": "SELECT T2.SECTOR_CATEGORY FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_SECTOR_CATEGORY AS T2 ON T1.SECTOR_ID = T2.SECTOR_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID WHERE T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) AND T1.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T2.SECTOR_CATEGORY HAVING SUM(T1.TOTAL_ESTABLISHMENTS) > 50000 ORDER BY SUM(T1.TOTAL_ESTABLISHMENTS) DESC", "predicted_sql": "SELECT dsc.sector_category, SUM(fet.total_establishments) AS total_establishments\nFROM fact_establishment_totals fet\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fet.est_residential_commercial = 0.000\nGROUP BY dsc.sector_category\nHAVING SUM(fet.total_establishments) > 50000\nORDER BY total_establishments DESC;", "raw_output": "SELECT dsc.sector_category, SUM(fet.total_establishments) AS total_establishments\nFROM fact_establishment_totals fet\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fet.est_residential_commercial = 0.000\nGROUP BY dsc.sector_category\nHAVING SUM(fet.total_establishments) > 50000\nORDER BY total_establishments DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 2. Pred count: 2."}
{"pair_id": "b353514c", "question": "Elenca l'anno del censimento e il totale stimato della pesca e acquacoltura per ciascun anno, assicurandoti che il totale sia almeno 0.000, e ordina i risultati in base al totale stimato della pesca e acquacoltura in ordine decrescente.", "gold_sql": "SELECT T2.CENSUS_YEAR, SUM(T1.EST_FISHING_AQUACULTURE) FROM FACT_PRIMARY_SECTOR AS T1 JOIN DIM_TIME AS T2 ON T1.TIME_ID = T2.TIME_ID JOIN DIM_LOCATION AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID GROUP BY T2.CENSUS_YEAR HAVING SUM(T1.EST_FISHING_AQUACULTURE) >= 0.000 ORDER BY SUM(T1.EST_FISHING_AQUACULTURE) DESC", "predicted_sql": "SELECT dt.census_year, COALESCE(SUM(fps.est_fishing_aquaculture), 0.000) AS total_estimated_fishing_aquaculture\nFROM dim_time dt\nLEFT JOIN fact_primary_sector fps ON dt.time_id = fps.time_id\nGROUP BY dt.census_year\nHAVING COALESCE(SUM(fps.est_fishing_aquaculture), 0.000) >= 0.000\nORDER BY total_estimated_fishing_aquaculture DESC;", "raw_output": "SELECT dt.census_year, COALESCE(SUM(fps.est_fishing_aquaculture), 0.000) AS total_estimated_fishing_aquaculture\nFROM dim_time dt\nLEFT JOIN fact_primary_sector fps ON dt.time_id = fps.time_id\nGROUP BY dt.census_year\nHAVING COALESCE(SUM(fps.est_fishing_aquaculture), 0.000) >= 0.000\nORDER BY total_estimated_fishing_aquaculture DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "9a4faed8", "question": "Per l'anno di censimento 2013, elenca i nomi dei sotto-distretti e i nomi dei villaggi ULB/RLB per le località in cui il numero stimato di bestiame è maggiore di zero, escludendo qualsiasi località che nel 2013 abbia avuto anche un numero stimato di unità residenziali-commerciali maggiore di zero, raggruppati per i rispettivi nomi di sotto-distretto e villaggio e ordinati alfabeticamente per sotto-distretto.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_PRIMARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_LIVESTOCK > 0.000 AND T1.LOCATION_ID NOT IN ( SELECT T4.LOCATION_ID FROM FACT_ESTABLISHMENT_TOTALS AS T4 JOIN DIM_TIME AS T5 ON T4.TIME_ID = T5.TIME_ID WHERE T5.CENSUS_YEAR = '2013' AND T4.EST_RESIDENTIAL_COMMERCIAL > 0.000 ) GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING COUNT(T2.FACT_PRIMARY_SECTOR_ID) >= 1 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id\nJOIN dim_time dt ON fps.time_id = dt.time_id\nLEFT JOIN fact_establishment_totals fet ON dl.location_id = fet.location_id AND fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fps.est_livestock > 0\n  AND (fet.est_residential_commercial IS NULL OR fet.est_residential_commercial = 0)\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id\nJOIN dim_time dt ON fps.time_id = dt.time_id\nLEFT JOIN fact_establishment_totals fet ON dl.location_id = fet.location_id AND fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fps.est_livestock > 0\n  AND (fet.est_residential_commercial IS NULL OR fet.est_residential_commercial = 0)\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 9973. Pred count: 9973."}
{"pair_id": "db9784c3", "question": "Elenca i nomi degli ULB, RLB o dei villaggi, ordinati alfabeticamente, che hanno una somma totale di stabilimenti zootecnici maggiore di zero, filtrando specificamente le località in cui i singoli conteggi degli stabilimenti zootecnici sono maggiori di zero e il numero di stabilimenti residenziali-commerciali è esattamente zero.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_PRIMARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_ESTABLISHMENT_TOTALS AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID WHERE T2.EST_LIVESTOCK > 0.000 AND T3.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_LIVESTOCK) > 0.000 ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id AND fet.time_id = fps.time_id AND fet.sector_id = fps.sector_id\nWHERE fps.est_livestock > 0\n  AND fet.est_residential_commercial = 0\nORDER BY dl.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id AND fet.time_id = fps.time_id AND fet.sector_id = fps.sector_id\nWHERE fps.est_livestock > 0\n  AND fet.est_residential_commercial = 0\nORDER BY dl.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "244da596", "question": "Elenca i nomi dei villaggi ULB RLB, ordinati alfabeticamente, per le località in cui il numero di stabilimenti di silvicoltura e disboscamento è maggiore di zero oppure il numero di stabilimenti residenziali e commerciali è maggiore di zero.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_PRIMARY_SECTOR AS T3 ON T2.LOCATION_ID = T3.LOCATION_ID WHERE T3.EST_FORESTRY_LOGGING > 0.000 OR T2.EST_RESIDENTIAL_COMMERCIAL > 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id AND fet.time_id = fps.time_id AND fet.sector_id = fps.sector_id\nWHERE fps.est_forestry_logging > 0 OR fet.est_residential_commercial > 0\nORDER BY dl.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id AND fet.time_id = fps.time_id AND fet.sector_id = fps.sector_id\nWHERE fps.est_forestry_logging > 0 OR fet.est_residential_commercial > 0\nORDER BY dl.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "f2bb09f0", "question": "Per l'anno di censimento 2013, elenca i nomi dei sotto-distretti e i nomi dei villaggi ULB/RLB in cui il numero di stabilimenti di pesca e acquacoltura è pari o superiore a 0 e il numero di stabilimenti commerciali residenziali è pari o superiore a 0, assicurandoti che siano incluse solo le località con almeno un record nei totali degli stabilimenti, e ordina i risultati alfabeticamente per nome del sotto-distretto.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_PRIMARY_SECTOR AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID AND T2.TIME_ID = T3.TIME_ID JOIN DIM_TIME AS T4 ON T2.TIME_ID = T4.TIME_ID WHERE T3.EST_FISHING_AQUACULTURE >= 0.000 AND T2.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T4.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING COUNT(T2.FACT_ESTABLISHMENT_TOTALS_ID) >= 1 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id AND fet.time_id = fps.time_id AND fet.sector_id = fps.sector_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fps.est_fishing_aquaculture >= 0\n  AND fet.est_residential_commercial >= 0\n  AND fet.total_establishments >= 1\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id AND fet.time_id = fps.time_id AND fet.sector_id = fps.sector_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fps.est_fishing_aquaculture >= 0\n  AND fet.est_residential_commercial >= 0\n  AND fet.total_establishments >= 1\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 29896. Pred count: 23554."}
{"pair_id": "e03e8e45", "question": "Per l'anno del censimento 2013, elenca i nomi dei sottodistretti e la somma totale stimata degli stabilimenti residenziali e commerciali, mostrando i primi 10 sottodistretti con i totali più elevati.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_RESIDENTIAL_COMMERCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_RESIDENTIAL_COMMERCIAL) DESC LIMIT 10", "predicted_sql": "SELECT dl.sub_district_name, SUM(fet.est_residential_commercial) AS total_residential_commercial\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_residential_commercial DESC\nLIMIT 10;", "raw_output": "SELECT dl.sub_district_name, SUM(fet.est_residential_commercial) AS total_residential_commercial\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_residential_commercial DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "cd33eb91", "question": "Per l'anno di censimento più recente disponibile, elenca il nome di ciascun sub-district e la somma totale stimata dei residential commercial establishments, filtrando i record in cui il valore residential commercial stimato è 0.000, e ordina i risultati in base alla somma in ordine decrescente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_RESIDENTIAL_COMMERCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) AND T2.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_RESIDENTIAL_COMMERCIAL) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fet.est_residential_commercial) AS total_residential_commercial\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fet.est_residential_commercial > 0.000\nGROUP BY dl.sub_district_name\nORDER BY total_residential_commercial DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fet.est_residential_commercial) AS total_residential_commercial\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fet.est_residential_commercial > 0.000\nGROUP BY dl.sub_district_name\nORDER BY total_residential_commercial DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 5346. Pred count: 0."}
{"pair_id": "a1c69c64", "question": "Elenca il nome del sottodistretto e l'anno del censimento, insieme alla somma del totale degli esercizi e alla somma degli esercizi residenziali-commerciali, raggruppati sia per sottodistretto sia per anno del censimento e ordinati cronologicamente per anno del censimento.", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME, T3.CENSUS_YEAR, SUM(T1.TOTAL_ESTABLISHMENTS), SUM(T1.EST_RESIDENTIAL_COMMERCIAL) FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_LOCATION AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID GROUP BY T2.SUB_DISTRICT_NAME, T3.CENSUS_YEAR ORDER BY T3.CENSUS_YEAR ASC", "predicted_sql": "SELECT dl.sub_district_name, dt.census_year, SUM(fet.total_establishments) AS sum_total_establishments, SUM(fet.est_residential_commercial) AS sum_est_residential_commercial\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nGROUP BY dl.sub_district_name, dt.census_year\nORDER BY dt.census_year;", "raw_output": "SELECT dl.sub_district_name, dt.census_year, SUM(fet.total_establishments) AS sum_total_establishments, SUM(fet.est_residential_commercial) AS sum_est_residential_commercial\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nGROUP BY dl.sub_district_name, dt.census_year\nORDER BY dt.census_year;", "em": 0, "ex": 1, "error": null}
{"pair_id": "fc696454", "question": "Elenca i nomi dei sottodistretti per l'anno di censimento 2013 in cui il numero totale di stabilimenti è maggiore di zero e il numero di stabilimenti residenziali-commerciali è esattamente zero.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 AND SUM(T2.EST_RESIDENTIAL_COMMERCIAL) = 0.000", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0;", "em": 0, "ex": 1, "error": null}
{"pair_id": "f387f406", "question": "Per l'anno di censimento 2013, elenca il nome di ciascun sub-district e la somma totale degli establishments in cui lo stato residenziale o commerciale è pari a 0.000, includendo solo i sub-district con una somma totale maggiore di 0.000, e ordina i risultati in base alla somma degli establishments in ordine decrescente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.TOTAL_ESTABLISHMENTS) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 ORDER BY SUM(T2.TOTAL_ESTABLISHMENTS) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fet.total_establishments) AS total_establishments_sum\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fet.est_residential_commercial = 0.000\nGROUP BY dl.sub_district_name\nHAVING SUM(fet.total_establishments) > 0.000\nORDER BY total_establishments_sum DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fet.total_establishments) AS total_establishments_sum\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fet.est_residential_commercial = 0.000\nGROUP BY dl.sub_district_name\nHAVING SUM(fet.total_establishments) > 0.000\nORDER BY total_establishments_sum DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "77a4e2c5", "question": "Elenca i nomi dei sottodistretti, ordinati alfabeticamente, che durante l’anno del censimento 2013 avevano un numero totale di stabilimenti maggiore di zero ma zero stabilimenti residenziali o commerciali.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 AND SUM(T2.EST_RESIDENTIAL_COMMERCIAL) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "803f28ef", "question": "Per l'anno del censimento 2013, elenca i nomi dei sotto-distretti, ordinati alfabeticamente, in cui il totale degli esercizi commerciali residenziali è maggiore di 0 oppure il nome del villaggio ULB RLB è 'Pilpilow'.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND (T2.EST_RESIDENTIAL_COMMERCIAL > 0.000 OR T1.ULB_RLB_VILLAGE_NAME = 'Pilpilow') GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND (fet.est_residential_commercial > 0 OR dl.ulb_rlb_village_name ILIKE 'Pilpilow')\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND (fet.est_residential_commercial > 0 OR dl.ulb_rlb_village_name ILIKE 'Pilpilow')\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "162deae6", "question": "Per l'anno del censimento 2013, elenca i nomi dei sotto-distretti e i nomi degli ULB, RLB o dei villaggi in cui il totale stimato della produzione manifatturiera nel settore secondario è superiore a 50, ordinati dal totale stimato della produzione manifatturiera più alto al più basso.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_MANUFACTURING) > 50 ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fss.est_manufacturing > 50\nORDER BY fss.est_manufacturing DESC;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fss.est_manufacturing > 50\nORDER BY fss.est_manufacturing DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 774. Pred count: 779."}
{"pair_id": "63892277", "question": "Elenca i nomi dei sub-district per l'anno di censimento '2013' in cui il numero di establishments residenziali-commerciali è pari o superiore a 0.000, assicurandoti che questi sub-district compaiano anche nell'insieme dei sub-district che soddisfano gli stessi criteri per quell'anno, e visualizza i risultati in ordine crescente per nome del sub-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T2.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T3.CENSUS_YEAR = '2013' AND T1.SUB_DISTRICT_NAME IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T4 JOIN FACT_ESTABLISHMENT_TOTALS AS T5 ON T4.LOCATION_ID = T5.LOCATION_ID JOIN DIM_TIME AS T6 ON T5.TIME_ID = T6.TIME_ID WHERE T5.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T6.CENSUS_YEAR = '2013') GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.est_residential_commercial >= 0.000\n  AND dl.sub_district_name IN (\n      SELECT dl2.sub_district_name\n      FROM dim_location dl2\n      JOIN fact_establishment_totals fet2 ON dl2.location_id = fet2.location_id\n      JOIN dim_time dt2 ON fet2.time_id = dt2.time_id\n      WHERE dt2.census_year = 2013\n        AND fet2.est_residential_commercial >= 0.000\n  )\nORDER BY dl.sub_district_name ASC;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.est_residential_commercial >= 0.000\n  AND dl.sub_district_name IN (\n      SELECT dl2.sub_district_name\n      FROM dim_location dl2\n      JOIN fact_establishment_totals fet2 ON dl2.location_id = fet2.location_id\n      JOIN dim_time dt2 ON fet2.time_id = dt2.time_id\n      WHERE dt2.census_year = 2013\n        AND fet2.est_residential_commercial >= 0.000\n  )\nORDER BY dl.sub_district_name ASC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "3f75c9fb", "question": "Per l'anno del censimento 2013, elenca il nome di ciascun sottodistretto e la somma dei rispettivi stabilimenti manifatturieri e di costruzione, raggruppati e ordinati alfabeticamente per nome del sottodistretto.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing + fss.est_construction) AS total_manufacturing_construction\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing + fss.est_construction) AS total_manufacturing_construction\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
