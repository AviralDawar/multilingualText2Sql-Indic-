{"pair_id": "29c4da79", "question": "Listez les noms des districts de l’État nommé « Andhra Pradesh », regroupés et classés par ordre alphabétique selon le nom du district.", "gold_sql": "SELECT T3.DISTRICT_NAME FROM DIM_COUNTRY AS T1 INNER JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID INNER JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T2.STATE_NAME = 'Andhra Pradesh' GROUP BY T3.DISTRICT_NAME ORDER BY T3.DISTRICT_NAME ASC", "predicted_sql": "SELECT district_name\nFROM dim_district\nWHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh')\nGROUP BY district_name\nORDER BY district_name;", "raw_output": "SELECT district_name\nFROM dim_district\nWHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh')\nGROUP BY district_name\nORDER BY district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "58dafef6", "question": "Listez les noms des États et le nombre total d’identifiants de district pour chaque État, classés par nombre de districts en ordre décroissant, et affichez uniquement les 5 premiers résultats.", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T2.DISTRICT_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T2.DISTRICT_ID) DESC LIMIT 5", "predicted_sql": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nGROUP BY ds.state_id, ds.state_name\nORDER BY total_districts DESC\nLIMIT 5;", "raw_output": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nGROUP BY ds.state_id, ds.state_name\nORDER BY total_districts DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "4e414781", "question": "Listez le nom du pays, le nom de l’État et le nom du district pour les districts nommés « Chittoor », en veillant à ce qu’au moins un enregistrement de pays existe pour ces entrées, et triez les résultats par ordre alphabétique d’abord selon le nom de l’État, puis selon le nom du pays.", "gold_sql": "SELECT T3.COUNTRY_NAME, T2.STATE_NAME, T1.DISTRICT_NAME FROM DIM_DISTRICT AS T1 INNER JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID INNER JOIN DIM_COUNTRY AS T3 ON T2.COUNTRY_ID = T3.COUNTRY_ID WHERE T1.DISTRICT_NAME = 'Chittoor' GROUP BY T3.COUNTRY_NAME, T2.STATE_NAME, T1.DISTRICT_NAME HAVING COUNT(T3.COUNTRY_ID) >= 1 ORDER BY T2.STATE_NAME ASC, T3.COUNTRY_NAME ASC", "predicted_sql": "SELECT c.country_name, s.state_name, d.district_name\nFROM dim_district d\nJOIN dim_state s ON d.state_id = s.state_id\nJOIN dim_country c ON s.country_id = c.country_id\nWHERE d.district_name ILIKE 'Chittoor'\nORDER BY s.state_name, c.country_name;", "raw_output": "SELECT c.country_name, s.state_name, d.district_name\nFROM dim_district d\nJOIN dim_state s ON d.state_id = s.state_id\nJOIN dim_country c ON s.country_id = c.country_id\nWHERE d.district_name ILIKE 'Chittoor'\nORDER BY s.state_name, c.country_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "cfe28a36", "question": "Pour le pays nommé 'India', listez le nom de chaque state ainsi que le nombre total de district dans ce state, en veillant à n’inclure que les states ayant au moins un district, et en ordonnant les résultats du plus grand au plus petit nombre de district.", "gold_sql": "SELECT T2.STATE_NAME, COUNT(T3.DISTRICT_ID) FROM DIM_COUNTRY AS T1 JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T1.COUNTRY_NAME = 'India' GROUP BY T2.STATE_NAME HAVING COUNT(T3.DISTRICT_ID) > 0 ORDER BY COUNT(T3.DISTRICT_ID) DESC;", "predicted_sql": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nJOIN dim_district dd ON ds.state_id = dd.state_id\nJOIN dim_country dc ON ds.country_id = dc.country_id\nWHERE dc.country_name ILIKE 'India'\nGROUP BY ds.state_id, ds.state_name\nHAVING COUNT(dd.district_id) > 0\nORDER BY total_districts DESC;", "raw_output": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nJOIN dim_district dd ON ds.state_id = dd.state_id\nJOIN dim_country dc ON ds.country_id = dc.country_id\nWHERE dc.country_name ILIKE 'India'\nGROUP BY ds.state_id, ds.state_name\nHAVING COUNT(dd.district_id) > 0\nORDER BY total_districts DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 36. Pred count: 36."}
{"pair_id": "57e740c7", "question": "Listez le nom de chaque État ainsi que le nombre total d’identifiants de district qui lui sont associés, classés du plus grand nombre de districts au plus petit.", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T2.DISTRICT_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T2.DISTRICT_ID) DESC", "predicted_sql": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nGROUP BY ds.state_id, ds.state_name\nORDER BY total_districts DESC;", "raw_output": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nGROUP BY ds.state_id, ds.state_name\nORDER BY total_districts DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 36. Pred count: 36."}
{"pair_id": "7a3b84bc", "question": "Listez les noms des districts de tous les districts situés dans l'État d'« Andhra Pradesh », classés par ordre alphabétique selon le nom du district.", "gold_sql": "SELECT T1.DISTRICT_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID WHERE T2.STATE_NAME = 'Andhra Pradesh' ORDER BY T1.DISTRICT_NAME", "predicted_sql": "SELECT district_name FROM dim_district WHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh') ORDER BY district_name;", "raw_output": "SELECT district_name FROM dim_district WHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh') ORDER BY district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "c0d57f54", "question": "Listez les noms des states et le nombre total d’identifiants de district pour chaque state du pays 'India', en n’incluant que les states ayant plus de zéro district, et affichez les 5 states ayant le plus grand nombre de district.", "gold_sql": "SELECT T2.STATE_NAME, COUNT(T3.DISTRICT_ID) FROM DIM_COUNTRY AS T1 JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T1.COUNTRY_NAME = 'India' GROUP BY T2.STATE_NAME HAVING COUNT(T3.DISTRICT_ID) > 0 ORDER BY COUNT(T3.DISTRICT_ID) DESC LIMIT 5", "predicted_sql": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nJOIN dim_country dc ON ds.country_id = dc.country_id\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nWHERE dc.country_name ILIKE 'India'\nGROUP BY ds.state_id, ds.state_name\nHAVING COUNT(dd.district_id) > 0\nORDER BY total_districts DESC\nLIMIT 5;", "raw_output": "SELECT ds.state_name, COUNT(dd.district_id) AS total_districts\nFROM dim_state ds\nJOIN dim_country dc ON ds.country_id = dc.country_id\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nWHERE dc.country_name ILIKE 'India'\nGROUP BY ds.state_id, ds.state_name\nHAVING COUNT(dd.district_id) > 0\nORDER BY total_districts DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "ecf4ae55", "question": "Listez les noms uniques des state situés dans le pays « India » et combinez-les avec une liste des noms uniques des district se trouvant dans le state « Andhra Pradesh ».", "gold_sql": "SELECT DISTINCT T1.STATE_NAME FROM DIM_STATE AS T1 JOIN DIM_COUNTRY AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID WHERE T2.COUNTRY_NAME = 'India' UNION SELECT DISTINCT T3.DISTRICT_NAME FROM DIM_DISTRICT AS T3 JOIN DIM_STATE AS T4 ON T3.STATE_ID = T4.STATE_ID WHERE T4.STATE_NAME = 'Andhra Pradesh';", "predicted_sql": "SELECT state_name FROM dim_state WHERE country_id = (SELECT country_id FROM dim_country WHERE country_name ILIKE 'India') UNION SELECT district_name FROM dim_district WHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh');", "raw_output": "SELECT state_name FROM dim_state WHERE country_id = (SELECT country_id FROM dim_country WHERE country_name ILIKE 'India') UNION SELECT district_name FROM dim_district WHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh');", "em": 0, "ex": 1, "error": null}
{"pair_id": "ca1147c3", "question": "Listez les noms des ULB, des RLB ou des villages situés dans l’État d’« Andhra Pradesh », regroupés et classés par ordre alphabétique selon le nom du village.", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME", "predicted_sql": "SELECT ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh'\nGROUP BY ulb_rlb_village_name\nORDER BY ulb_rlb_village_name;", "raw_output": "SELECT ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh'\nGROUP BY ulb_rlb_village_name\nORDER BY ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a6f826b8", "question": "Listez les noms des ULB, des RLB ou des villages situés dans l’État d’« Andhra Pradesh » et dans le district de « Chittoor », regroupés et classés par ordre alphabétique selon le nom du village.", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' AND T2.DISTRICT_NAME = 'Chittoor' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district USING (district_id)\nJOIN dim_state USING (state_id)\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh'\n  AND dim_district.district_name ILIKE 'Chittoor'\nGROUP BY ulb_rlb_village_name\nORDER BY ulb_rlb_village_name;", "raw_output": "SELECT ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district USING (district_id)\nJOIN dim_state USING (state_id)\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh'\n  AND dim_district.district_name ILIKE 'Chittoor'\nGROUP BY ulb_rlb_village_name\nORDER BY ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "9432abec", "question": "Listez le nom du district, le nom de l’État et le nom du pays pour toutes les entrées, classés par ordre alphabétique selon le nom du district.", "gold_sql": "SELECT T1.DISTRICT_NAME, T2.STATE_NAME, T3.COUNTRY_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_COUNTRY AS T3 ON T2.COUNTRY_ID = T3.COUNTRY_ID ORDER BY T1.DISTRICT_NAME", "predicted_sql": "SELECT d.district_name, s.state_name, c.country_name\nFROM dim_district d\nJOIN dim_state s ON d.state_id = s.state_id\nJOIN dim_country c ON s.country_id = c.country_id\nORDER BY d.district_name;", "raw_output": "SELECT d.district_name, s.state_name, c.country_name\nFROM dim_district d\nJOIN dim_state s ON d.state_id = s.state_id\nJOIN dim_country c ON s.country_id = c.country_id\nORDER BY d.district_name;", "em": 1, "ex": 1, "error": null}
{"pair_id": "bd14e998", "question": "Listez les noms des ULB, des RLB ou des village situés dans le state « Andhra Pradesh » et le district « Chittoor », regroupés et classés par ordre alphabétique selon le nom du village.", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 INNER JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID INNER JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' AND T2.DISTRICT_NAME = 'Chittoor' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh'\nAND dim_district.district_name ILIKE 'Chittoor'\nGROUP BY ulb_rlb_village_name\nORDER BY ulb_rlb_village_name;", "raw_output": "SELECT ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh'\nAND dim_district.district_name ILIKE 'Chittoor'\nGROUP BY ulb_rlb_village_name\nORDER BY ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "18a2fb3f", "question": "Listez le nom de l’État, l’identifiant du pays, le nom du district et le nom du village ULB/RLB pour tous les emplacements, triés par le nom du village puis par le nom du district.", "gold_sql": "SELECT T3.STATE_NAME, T3.COUNTRY_ID, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID ORDER BY T1.ULB_RLB_VILLAGE_NAME, T2.DISTRICT_NAME", "predicted_sql": "SELECT ds.state_name, dc.country_id, dd.district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nJOIN dim_country dc ON ds.country_id = dc.country_id\nORDER BY dl.ulb_rlb_village_name, dd.district_name;", "raw_output": "SELECT ds.state_name, dc.country_id, dd.district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nJOIN dim_state ds ON dd.state_id = ds.state_id\nJOIN dim_country dc ON ds.country_id = dc.country_id\nORDER BY dl.ulb_rlb_village_name, dd.district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5b6160c2", "question": "Listez chaque nom d’État ainsi que le nombre d’identifiants de localisation qui lui sont associés, regroupés par nom d’État et classés du nombre le plus élevé au plus faible.", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T3.LOCATION_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T3.LOCATION_ID) DESC", "predicted_sql": "SELECT ds.state_name, COUNT(DISTINCT dl.location_id) AS location_count\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nLEFT JOIN dim_location dl ON dd.district_id = dl.district_id\nGROUP BY ds.state_name\nORDER BY location_count DESC;", "raw_output": "SELECT ds.state_name, COUNT(DISTINCT dl.location_id) AS location_count\nFROM dim_state ds\nLEFT JOIN dim_district dd ON ds.state_id = dd.state_id\nLEFT JOIN dim_location dl ON dd.district_id = dl.district_id\nGROUP BY ds.state_name\nORDER BY location_count DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a63fc1b8", "question": "Pour l’État de l’Andhra Pradesh, listez les noms des districts ainsi que le nombre de noms de villages ULB/RLB distincts, regroupés par nom de district et classés par le nombre de villages le plus élevé, en affichant uniquement les 10 premiers résultats.", "gold_sql": "SELECT T2.DISTRICT_NAME, COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' GROUP BY T2.DISTRICT_NAME ORDER BY COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) DESC LIMIT 10", "predicted_sql": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS distinct_village_count\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Andhra Pradesh'\nGROUP BY d.district_name\nORDER BY distinct_village_count DESC\nLIMIT 10;", "raw_output": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS distinct_village_count\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Andhra Pradesh'\nGROUP BY d.district_name\nORDER BY distinct_village_count DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "8ec520f2", "question": "Pour le state « Bihar », listez le nom de chaque district ainsi que le nombre total de noms de village ULB/RLB distincts, en veillant à n’inclure que les district comptant plus de zéro village, et affichez les 10 district ayant les nombres les plus élevés.", "gold_sql": "SELECT T2.DISTRICT_NAME, COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Bihar' GROUP BY T2.DISTRICT_NAME HAVING COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) > 0 ORDER BY COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) DESC LIMIT 10", "predicted_sql": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS distinct_village_count\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Bihar'\nGROUP BY d.district_id, d.district_name\nHAVING COUNT(DISTINCT l.ulb_rlb_village_name) > 0\nORDER BY distinct_village_count DESC\nLIMIT 10;", "raw_output": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS distinct_village_count\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Bihar'\nGROUP BY d.district_id, d.district_name\nHAVING COUNT(DISTINCT l.ulb_rlb_village_name) > 0\nORDER BY distinct_village_count DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "bc7a27e8", "question": "Listez le nom du state, le nom du district et le nom du village ULB/RLB pour les localités situées dans les states « Assam », « Andhra Pradesh » ou « Bihar », en excluant celles du district « Prakasam », regroupées par state, district et nom du village, et classées par ordre alphabétique du village puis du district.", "gold_sql": "SELECT T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 INNER JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID INNER JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T3.STATE_NAME IN ('Assam', 'Andhra Pradesh', 'Bihar') AND T2.DISTRICT_NAME NOT IN ('Prakasam') GROUP BY T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC, T2.DISTRICT_NAME ASC", "predicted_sql": "SELECT s.state_name, d.district_name, l.ulb_rlb_village_name\nFROM dim_location l\nJOIN dim_district d ON l.district_id = d.district_id\nJOIN dim_state s ON d.state_id = s.state_id\nWHERE s.state_name ILIKE ANY (ARRAY['Assam', 'Andhra Pradesh', 'Bihar'])\n  AND d.district_name NOT ILIKE 'Prakasam'\nGROUP BY s.state_name, d.district_name, l.ulb_rlb_village_name\nORDER BY l.ulb_rlb_village_name, d.district_name;", "raw_output": "SELECT s.state_name, d.district_name, l.ulb_rlb_village_name\nFROM dim_location l\nJOIN dim_district d ON l.district_id = d.district_id\nJOIN dim_state s ON d.state_id = s.state_id\nWHERE s.state_name ILIKE ANY (ARRAY['Assam', 'Andhra Pradesh', 'Bihar'])\n  AND d.district_name NOT ILIKE 'Prakasam'\nGROUP BY s.state_name, d.district_name, l.ulb_rlb_village_name\nORDER BY l.ulb_rlb_village_name, d.district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "4ba18ccf", "question": "Listez les noms des sub-district, classés par ordre alphabétique, qui contiennent au moins un secteur classé comme « Rural » et au moins un secteur classé comme « Urban ».", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_SECTOR_CATEGORY AS T3 ON T2.SECTOR_ID = T3.SECTOR_ID GROUP BY T1.SUB_DISTRICT_NAME HAVING COUNT(DISTINCT CASE WHEN T3.SECTOR_CATEGORY = 'Rural' THEN T3.SECTOR_CATEGORY END) > 0 AND COUNT(DISTINCT CASE WHEN T3.SECTOR_CATEGORY = 'Urban' THEN T3.SECTOR_CATEGORY END) > 0 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nWHERE dsc.sector_category ILIKE 'Rural'\nINTERSECT\nSELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nWHERE dsc.sector_category ILIKE 'Urban'\nORDER BY sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nWHERE dsc.sector_category ILIKE 'Rural'\nINTERSECT\nSELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nWHERE dsc.sector_category ILIKE 'Urban'\nORDER BY sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5d1894c5", "question": "Listez le nom du state et le nom du district pour tous les district situés dans les states « Andhra Pradesh » ou « Assam », et triez les résultats par le nom du state.", "gold_sql": "SELECT T1.STATE_NAME, T2.DISTRICT_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' OR T1.STATE_NAME = 'Assam' ORDER BY T1.STATE_NAME", "predicted_sql": "SELECT ds.state_name, dd.district_name\nFROM dim_state ds\nJOIN dim_district dd ON ds.state_id = dd.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh' OR ds.state_name ILIKE 'Assam'\nORDER BY ds.state_name;", "raw_output": "SELECT ds.state_name, dd.district_name\nFROM dim_state ds\nJOIN dim_district dd ON ds.state_id = dd.state_id\nWHERE ds.state_name ILIKE 'Andhra Pradesh' OR ds.state_name ILIKE 'Assam'\nORDER BY ds.state_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5fca6279", "question": "Listez le nom de l’État, le nom du district et le nom du village ULB/RLB, regroupés par État, district et nom du village, et classés par ordre alphabétique du nom du village.", "gold_sql": "SELECT T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID GROUP BY T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME;", "predicted_sql": "SELECT ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nFROM dim_state ds\nJOIN dim_district dd ON ds.state_id = dd.state_id\nJOIN dim_location dl ON dd.district_id = dl.district_id\nGROUP BY ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nORDER BY dl.ulb_rlb_village_name;", "raw_output": "SELECT ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nFROM dim_state ds\nJOIN dim_district dd ON ds.state_id = dd.state_id\nJOIN dim_location dl ON dd.district_id = dl.district_id\nGROUP BY ds.state_name, dd.district_name, dl.ulb_rlb_village_name\nORDER BY dl.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "57faa295", "question": "Listez les noms des sous-districts ainsi que les noms des villages ULB/RLB situés dans le district de « Chittoor », en excluant tous les sous-districts qui se trouvent également dans le district de « Prakasam », regroupés par sous-district et par nom de village, et classés par ordre alphabétique des sous-districts.", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_LOCATION AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID WHERE T1.DISTRICT_NAME = 'Chittoor' AND T2.SUB_DISTRICT_NAME NOT IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_DISTRICT AS T3 JOIN DIM_LOCATION AS T4 ON T3.DISTRICT_ID = T4.DISTRICT_ID WHERE T3.DISTRICT_NAME = 'Prakasam') GROUP BY T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME ORDER BY T2.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nWHERE dd.district_name ILIKE 'Chittoor'\nAND dl.sub_district_name NOT IN (\n    SELECT DISTINCT dl2.sub_district_name\n    FROM dim_location dl2\n    JOIN dim_district dd2 ON dl2.district_id = dd2.district_id\n    WHERE dd2.district_name ILIKE 'Prakasam'\n)\nORDER BY dl.sub_district_name, dl.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nWHERE dd.district_name ILIKE 'Chittoor'\nAND dl.sub_district_name NOT IN (\n    SELECT DISTINCT dl2.sub_district_name\n    FROM dim_location dl2\n    JOIN dim_district dd2 ON dl2.district_id = dd2.district_id\n    WHERE dd2.district_name ILIKE 'Prakasam'\n)\nORDER BY dl.sub_district_name, dl.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "2d406297", "question": "Pour l’année de recensement 2013, listez les catégories de secteur pour lesquelles le nombre total d’établissements dépasse 50,000, en filtrant spécifiquement les enregistrements où le statut résidentiel ou commercial est égal à 0.000, et triez les catégories de secteur obtenues par ordre décroissant.", "gold_sql": "SELECT T2.SECTOR_CATEGORY FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_SECTOR_CATEGORY AS T2 ON T1.SECTOR_ID = T2.SECTOR_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T1.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T2.SECTOR_CATEGORY HAVING SUM(T1.TOTAL_ESTABLISHMENTS) > 50000 ORDER BY T2.SECTOR_CATEGORY DESC", "predicted_sql": "SELECT dsc.sector_category\nFROM dim_sector_category dsc\nJOIN fact_establishment_totals fet ON dsc.sector_id = fet.sector_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.est_residential_commercial = 0.000\nGROUP BY dsc.sector_category\nHAVING SUM(fet.total_establishments) > 50000\nORDER BY SUM(fet.total_establishments) DESC;", "raw_output": "SELECT dsc.sector_category\nFROM dim_sector_category dsc\nJOIN fact_establishment_totals fet ON dsc.sector_id = fet.sector_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.est_residential_commercial = 0.000\nGROUP BY dsc.sector_category\nHAVING SUM(fet.total_establishments) > 50000\nORDER BY SUM(fet.total_establishments) DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 2. Pred count: 2."}
{"pair_id": "db9784c3", "question": "Listez les noms des ULB, des RLB ou des villages, triés par ordre alphabétique, dont la somme totale des établissements d’élevage est supérieure à zéro, en filtrant spécifiquement les localités où les nombres individuels d’établissements d’élevage sont supérieurs à zéro et où le nombre d’établissements résidentiels-commerciaux est exactement égal à zéro.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_PRIMARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_ESTABLISHMENT_TOTALS AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID WHERE T2.EST_LIVESTOCK > 0.000 AND T3.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_LIVESTOCK) > 0.000 ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN fact_establishment_totals ON dim_location.location_id = fact_establishment_totals.location_id\nJOIN fact_primary_sector ON dim_location.location_id = fact_primary_sector.location_id\nWHERE fact_primary_sector.est_livestock > 0\nAND fact_establishment_totals.est_residential_commercial = 0\nORDER BY dim_location.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN fact_establishment_totals ON dim_location.location_id = fact_establishment_totals.location_id\nJOIN fact_primary_sector ON dim_location.location_id = fact_primary_sector.location_id\nWHERE fact_primary_sector.est_livestock > 0\nAND fact_establishment_totals.est_residential_commercial = 0\nORDER BY dim_location.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "4a0348e2", "question": "Pour la période la plus récente disponible, listez les catégories sectorielles pour lesquelles le nombre total d’établissements est supérieur à 50,000, spécifiquement pour les enregistrements où le statut résidentiel ou commercial est égal à 0.000, et classez les résultats par nombre total d’établissements par ordre décroissant.", "gold_sql": "SELECT T2.SECTOR_CATEGORY FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_SECTOR_CATEGORY AS T2 ON T1.SECTOR_ID = T2.SECTOR_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID WHERE T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) AND T1.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T2.SECTOR_CATEGORY HAVING SUM(T1.TOTAL_ESTABLISHMENTS) > 50000 ORDER BY SUM(T1.TOTAL_ESTABLISHMENTS) DESC", "predicted_sql": "SELECT ds.sector_category\nFROM dim_sector_category ds\nJOIN fact_establishment_totals fet ON ds.sector_id = fet.sector_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fet.est_residential_commercial = 0.000\nGROUP BY ds.sector_id, ds.sector_category\nHAVING SUM(fet.total_establishments) > 50000\nORDER BY SUM(fet.total_establishments) DESC;", "raw_output": "SELECT ds.sector_category\nFROM dim_sector_category ds\nJOIN fact_establishment_totals fet ON ds.sector_id = fet.sector_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fet.est_residential_commercial = 0.000\nGROUP BY ds.sector_id, ds.sector_category\nHAVING SUM(fet.total_establishments) > 50000\nORDER BY SUM(fet.total_establishments) DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "b353514c", "question": "Listez l’année du recensement et le total estimé de l’aquaculture de pêche pour chaque année, en veillant à ce que le total soit au moins égal à 0.000, et classez les résultats par total estimé de l’aquaculture de pêche par ordre décroissant.", "gold_sql": "SELECT T2.CENSUS_YEAR, SUM(T1.EST_FISHING_AQUACULTURE) FROM FACT_PRIMARY_SECTOR AS T1 JOIN DIM_TIME AS T2 ON T1.TIME_ID = T2.TIME_ID JOIN DIM_LOCATION AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID GROUP BY T2.CENSUS_YEAR HAVING SUM(T1.EST_FISHING_AQUACULTURE) >= 0.000 ORDER BY SUM(T1.EST_FISHING_AQUACULTURE) DESC", "predicted_sql": "SELECT dt.census_year, SUM(fps.est_fishing_aquaculture) AS total_estimated_fishing_aquaculture\nFROM dim_time dt\nJOIN fact_primary_sector fps ON dt.time_id = fps.time_id\nWHERE fps.est_fishing_aquaculture >= 0.000\nGROUP BY dt.census_year\nHAVING SUM(fps.est_fishing_aquaculture) >= 0.000\nORDER BY total_estimated_fishing_aquaculture DESC;", "raw_output": "SELECT dt.census_year, SUM(fps.est_fishing_aquaculture) AS total_estimated_fishing_aquaculture\nFROM dim_time dt\nJOIN fact_primary_sector fps ON dt.time_id = fps.time_id\nWHERE fps.est_fishing_aquaculture >= 0.000\nGROUP BY dt.census_year\nHAVING SUM(fps.est_fishing_aquaculture) >= 0.000\nORDER BY total_estimated_fishing_aquaculture DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "244da596", "question": "Listez les noms des villages ULB RLB, triés par ordre alphabétique, pour les localités où le nombre d’établissements de sylviculture et d’exploitation forestière est supérieur à zéro ou le nombre d’établissements résidentiels et commerciaux est supérieur à zéro.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_PRIMARY_SECTOR AS T3 ON T2.LOCATION_ID = T3.LOCATION_ID WHERE T3.EST_FORESTRY_LOGGING > 0.000 OR T2.EST_RESIDENTIAL_COMMERCIAL > 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN fact_establishment_totals ON dim_location.location_id = fact_establishment_totals.location_id\nJOIN fact_primary_sector ON dim_location.location_id = fact_primary_sector.location_id\nWHERE fact_primary_sector.est_forestry_logging > 0 OR fact_establishment_totals.est_residential_commercial > 0\nORDER BY dim_location.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN fact_establishment_totals ON dim_location.location_id = fact_establishment_totals.location_id\nJOIN fact_primary_sector ON dim_location.location_id = fact_primary_sector.location_id\nWHERE fact_primary_sector.est_forestry_logging > 0 OR fact_establishment_totals.est_residential_commercial > 0\nORDER BY dim_location.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "f2bb09f0", "question": "Pour l’année de recensement 2013, listez les noms des sous-districts et les noms des villages ULB/RLB où le nombre d’établissements de pêche et d’aquaculture est supérieur ou égal à 0 et le nombre d’établissements commerciaux résidentiels est supérieur ou égal à 0, en veillant à n’inclure que les localités ayant au moins un enregistrement dans les totaux des établissements, et triez les résultats par ordre alphabétique selon le nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_PRIMARY_SECTOR AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID AND T2.TIME_ID = T3.TIME_ID JOIN DIM_TIME AS T4 ON T2.TIME_ID = T4.TIME_ID WHERE T3.EST_FISHING_AQUACULTURE >= 0.000 AND T2.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T4.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING COUNT(T2.FACT_ESTABLISHMENT_TOTALS_ID) >= 1 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fps.est_fishing_aquaculture >= 0\n  AND fet.est_residential_commercial >= 0\n  AND fet.total_establishments > 0\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fps.est_fishing_aquaculture >= 0\n  AND fet.est_residential_commercial >= 0\n  AND fet.total_establishments > 0\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 29896. Pred count: 23554."}
{"pair_id": "a1c69c64", "question": "Indiquez le nom du sous-district et l’année du recensement, ainsi que la somme du nombre total d’établissements et la somme du nombre d’établissements résidentiels-commerciaux, regroupés à la fois par sous-district et par année de recensement, et classés par ordre chronologique selon l’année de recensement.", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME, T3.CENSUS_YEAR, SUM(T1.TOTAL_ESTABLISHMENTS), SUM(T1.EST_RESIDENTIAL_COMMERCIAL) FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_LOCATION AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID GROUP BY T2.SUB_DISTRICT_NAME, T3.CENSUS_YEAR ORDER BY T3.CENSUS_YEAR ASC", "predicted_sql": "SELECT dim_location.sub_district_name, dim_time.census_year, SUM(fact_establishment_totals.total_establishments), SUM(fact_establishment_totals.est_residential_commercial)\nFROM fact_establishment_totals\nJOIN dim_location ON fact_establishment_totals.location_id = dim_location.location_id\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nGROUP BY dim_location.sub_district_name, dim_time.census_year\nORDER BY dim_time.census_year;", "raw_output": "SELECT dim_location.sub_district_name, dim_time.census_year, SUM(fact_establishment_totals.total_establishments), SUM(fact_establishment_totals.est_residential_commercial)\nFROM fact_establishment_totals\nJOIN dim_location ON fact_establishment_totals.location_id = dim_location.location_id\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nGROUP BY dim_location.sub_district_name, dim_time.census_year\nORDER BY dim_time.census_year;", "em": 1, "ex": 1, "error": null}
{"pair_id": "9a4faed8", "question": "Pour l’année de recensement 2013, listez les noms des sous-districts et les noms des villages ULB/RLB pour les localités où le nombre estimé de têtes de bétail est supérieur à zéro, en excluant toute localité ayant également eu un nombre estimé de résidences/commerces supérieur à zéro en 2013, regroupés par leurs noms de sous-district et de village et classés par ordre alphabétique des sous-districts.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_PRIMARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_LIVESTOCK > 0.000 AND T1.LOCATION_ID NOT IN ( SELECT T4.LOCATION_ID FROM FACT_ESTABLISHMENT_TOTALS AS T4 JOIN DIM_TIME AS T5 ON T4.TIME_ID = T5.TIME_ID WHERE T5.CENSUS_YEAR = '2013' AND T4.EST_RESIDENTIAL_COMMERCIAL > 0.000 ) GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING COUNT(T2.FACT_PRIMARY_SECTOR_ID) >= 1 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id AND fet.time_id = fps.time_id AND fet.sector_id = fps.sector_id\nWHERE dt.census_year = 2013\n  AND fps.est_livestock > 0\n  AND fet.est_residential_commercial = 0\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id AND fet.time_id = fps.time_id AND fet.sector_id = fps.sector_id\nWHERE dt.census_year = 2013\n  AND fps.est_livestock > 0\n  AND fet.est_residential_commercial = 0\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 9973. Pred count: 9973."}
{"pair_id": "e03e8e45", "question": "Pour l’année de recensement 2013, listez les noms des sous-districts et la somme totale estimée des établissements résidentiels et commerciaux, en affichant les 10 sous-districts ayant les totaux les plus élevés.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_RESIDENTIAL_COMMERCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_RESIDENTIAL_COMMERCIAL) DESC LIMIT 10", "predicted_sql": "SELECT dl.sub_district_name, SUM(fet.est_residential_commercial) AS total_residential_commercial\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_residential_commercial DESC\nLIMIT 10;", "raw_output": "SELECT dl.sub_district_name, SUM(fet.est_residential_commercial) AS total_residential_commercial\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_residential_commercial DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "cd33eb91", "question": "Pour l’année de recensement la plus récente disponible, listez le nom de chaque sous-district ainsi que la somme totale estimée des établissements commerciaux résidentiels, en filtrant les enregistrements où la valeur commerciale résidentielle estimée est de 0.000, et classez les résultats par somme en ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_RESIDENTIAL_COMMERCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) AND T2.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_RESIDENTIAL_COMMERCIAL) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fet.est_residential_commercial) AS total_residential_commercial\nFROM fact_establishment_totals fet\nJOIN dim_location dl ON fet.location_id = dl.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fet.est_residential_commercial > 0.000\nGROUP BY dl.sub_district_name\nORDER BY total_residential_commercial DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fet.est_residential_commercial) AS total_residential_commercial\nFROM fact_establishment_totals fet\nJOIN dim_location dl ON fet.location_id = dl.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fet.est_residential_commercial > 0.000\nGROUP BY dl.sub_district_name\nORDER BY total_residential_commercial DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 5346. Pred count: 0."}
{"pair_id": "f387f406", "question": "Pour l’année de recensement 2013, listez le nom de chaque sous-district ainsi que la somme totale des établissements dont le statut résidentiel ou commercial est égal à 0.000, en incluant uniquement les sous-districts dont la somme totale est supérieure à 0.000, et triez les résultats par la somme des établissements par ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.TOTAL_ESTABLISHMENTS) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 ORDER BY SUM(T2.TOTAL_ESTABLISHMENTS) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fet.total_establishments) AS total_establishments_sum\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fet.est_residential_commercial = 0.000\nGROUP BY dl.sub_district_name\nHAVING SUM(fet.total_establishments) > 0.000\nORDER BY total_establishments_sum DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fet.total_establishments) AS total_establishments_sum\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fet.est_residential_commercial = 0.000\nGROUP BY dl.sub_district_name\nHAVING SUM(fet.total_establishments) > 0.000\nORDER BY total_establishments_sum DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "fc696454", "question": "Listez les noms des sous-districts pour l’année de recensement 2013 où le nombre total d’établissements est supérieur à zéro et où le nombre d’établissements résidentiels-commerciaux est exactement égal à zéro.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 AND SUM(T2.EST_RESIDENTIAL_COMMERCIAL) = 0.000", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0;", "em": 0, "ex": 1, "error": null}
{"pair_id": "63892277", "question": "Listez les noms des sous-districts pour l’année de recensement « 2013 » où le nombre d’établissements résidentiels-commerciaux est supérieur ou égal à 0.000, en veillant à ce que ces sous-districts figurent également dans l’ensemble des sous-districts répondant à ces mêmes critères pour cette année, et affichez les résultats par ordre croissant du nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T2.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T3.CENSUS_YEAR = '2013' AND T1.SUB_DISTRICT_NAME IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T4 JOIN FACT_ESTABLISHMENT_TOTALS AS T5 ON T4.LOCATION_ID = T5.LOCATION_ID JOIN DIM_TIME AS T6 ON T5.TIME_ID = T6.TIME_ID WHERE T5.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T6.CENSUS_YEAR = '2013') GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\nAND fet.est_residential_commercial >= 0.000\nORDER BY dl.sub_district_name ASC;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\nAND fet.est_residential_commercial >= 0.000\nORDER BY dl.sub_district_name ASC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "803f28ef", "question": "Pour l’année de recensement 2013, listez les noms des sous-districts, classés par ordre alphabétique, où soit le total des établissements commerciaux résidentiels est supérieur à 0, soit le nom du village ULB RLB est « Pilpilow ».", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND (T2.EST_RESIDENTIAL_COMMERCIAL > 0.000 OR T1.ULB_RLB_VILLAGE_NAME = 'Pilpilow') GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_tots fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND (fet.est_residential_commercial > 0 OR dl.ulb_rlb_village_name ILIKE 'Pilpilow')\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_tots fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND (fet.est_residential_commercial > 0 OR dl.ulb_rlb_village_name ILIKE 'Pilpilow')\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Pred SQL Error: relation \"fact_establishment_tots\" does not exist\nLINE 3: JOIN fact_establishment_tots fet ON dl.location_id = fet.loc...\n             ^"}
{"pair_id": "77a4e2c5", "question": "Listez les noms des sous-districts, classés par ordre alphabétique, qui avaient un nombre total d’établissements supérieur à zéro mais aucun établissement résidentiel ou commercial lors de l’année de recensement 2013.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 AND SUM(T2.EST_RESIDENTIAL_COMMERCIAL) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "162deae6", "question": "Pour l’année de recensement 2013, listez les noms des sous-districts ainsi que les noms des ULB, RLB ou villages où le total estimé de la fabrication dans le secteur secondaire est supérieur à 50, classés du total estimé de fabrication le plus élevé au plus faible.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_MANUFACTURING) > 50 ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fss.est_manufacturing > 50\nORDER BY fss.est_manufacturing DESC;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fss.est_manufacturing > 50\nORDER BY fss.est_manufacturing DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 774. Pred count: 779."}
{"pair_id": "cc274a6c", "question": "Pour l’année de recensement la plus récente disponible, indiquez le nom de chaque sous-district ainsi que la somme totale des établissements de fabrication et de construction, en incluant uniquement les sous-districts pour lesquels cette somme combinée est supérieure à zéro, et classez les résultats par somme totale en ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) > 0.000 ORDER BY SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing + fss.est_construction) AS total_manufacturing_construction\nFROM dim_time dt\nJOIN fact_secondary_sector fss ON dt.time_id = fss.time_id\nJOIN dim_location dl ON fss.location_id = dl.location_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nHAVING SUM(fss.est_manufacturing + fss.est_construction) > 0\nORDER BY total_manufacturing_construction DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing + fss.est_construction) AS total_manufacturing_construction\nFROM dim_time dt\nJOIN fact_secondary_sector fss ON dt.time_id = fss.time_id\nJOIN dim_location dl ON fss.location_id = dl.location_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nHAVING SUM(fss.est_manufacturing + fss.est_construction) > 0\nORDER BY total_manufacturing_construction DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "7ead6ddc", "question": "Pour la période la plus récente disponible, listez les noms des ULB, des RLB ou des villages où la valeur manufacturière totale estimée est supérieure à 50.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_MANUFACTURING) > 50", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fss.est_manufacturing > 50;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fss.est_manufacturing > 50;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 790. Pred count: 773."}
{"pair_id": "3f75c9fb", "question": "Pour l’année de recensement 2013, indiquez le nom de chaque sous-district ainsi que la somme de leurs établissements de fabrication et de construction, regroupés et classés par ordre alphabétique selon le nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing + fss.est_construction) AS sum_manufacturing_construction\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing + fss.est_construction) AS sum_manufacturing_construction\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5acff517", "question": "Pour l’année de recensement 2013, indiquez le nom de chaque sous-district ainsi que la valeur manufacturière totale estimée, triés par valeur manufacturière totale estimée par ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing) AS total_manufacturing_value\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_manufacturing_value DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing) AS total_manufacturing_value\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_manufacturing_value DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "3b6a0b2a", "question": "Pour la période la plus récente disponible, listez les noms des ULB, des RLB ou des villages dont la valeur manufacturière totale estimée est supérieure à 50, et affichez ces noms par ordre décroissant de leur valeur manufacturière totale estimée.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_MANUFACTURING) > 50 ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fss.est_manufacturing > 50\nORDER BY fss.est_manufacturing DESC;", "raw_output": "SELECT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fss.est_manufacturing > 50\nORDER BY fss.est_manufacturing DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 790. Pred count: 779."}
{"pair_id": "cf374eef", "question": "Listez les noms des sous-districts pour l’année de recensement 2013 où le total estimé de la fabrication est supérieur à 0 et le total estimé de la construction est exactement égal à 0, regroupés et classés par ordre alphabétique selon le nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING) > 0.000 AND SUM(T2.EST_CONSTRUCTION) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN dim_time dt ON dl.location_id IN (\n    SELECT location_id FROM fact_secondary_sector WHERE est_manufacturing > 0 AND est_construction = 0\n)\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id AND fss.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fss.est_manufacturing > 0 AND fss.est_construction = 0\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN dim_time dt ON dl.location_id IN (\n    SELECT location_id FROM fact_secondary_sector WHERE est_manufacturing > 0 AND est_construction = 0\n)\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id AND fss.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fss.est_manufacturing > 0 AND fss.est_construction = 0\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 3540. Pred count: 4355."}
{"pair_id": "09a75ff6", "question": "Pour l’année de recensement 2013, indiquez le nom de chaque sub-district ainsi que les valeurs totales estimées de la fabrication et de la construction, en veillant à ce que la valeur totale estimée de la fabrication soit au moins égale à 0.000, et triez les résultats par la valeur totale estimée de la fabrication par ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING), SUM(T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING) >= 0.000 ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing) AS total_manufacturing, SUM(fss.est_construction) AS total_construction\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fss.est_manufacturing >= 0.000\nGROUP BY dl.sub_district_name\nORDER BY total_manufacturing DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing) AS total_manufacturing, SUM(fss.est_construction) AS total_construction\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fss.est_manufacturing >= 0.000\nGROUP BY dl.sub_district_name\nORDER BY total_manufacturing DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "6ad0ce72", "question": "Listez les noms des sous-districts pour l’année de recensement 2013 où le nombre d’établissements manufacturiers est supérieur à 500 ou le nombre d’établissements de construction est supérieur à 200, regroupés par nom de sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND (T2.EST_MANUFACTURING > 500 OR T2.EST_CONSTRUCTION > 200) GROUP BY T1.SUB_DISTRICT_NAME", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\nAND (fss.est_manufacturing > 500 OR fss.est_construction > 200);", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\nAND (fss.est_manufacturing > 500 OR fss.est_construction > 200);", "em": 0, "ex": 1, "error": null}
{"pair_id": "34765acb", "question": "Pour l’année de recensement la plus récente disponible, indiquez le nom de chaque sous-district et la valeur manufacturière totale estimée, classés de la valeur manufacturière totale estimée la plus élevée à la plus faible.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing) AS total_manufacturing_value\nFROM dim_time dt\nJOIN fact_secondary_sector fss ON dt.time_id = fss.time_id\nJOIN dim_location dl ON fss.location_id = dl.location_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_manufacturing_value DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing) AS total_manufacturing_value\nFROM dim_time dt\nJOIN fact_secondary_sector fss ON dt.time_id = fss.time_id\nJOIN dim_location dl ON fss.location_id = dl.location_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_manufacturing_value DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "936c601a", "question": "Pour l’année de recensement 2013, indiquez le nom de chaque sous-district ainsi que les valeurs totales estimées de la fabrication et de la construction, regroupées et classées par ordre alphabétique du nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING), SUM(T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.sub_district_name,\n       SUM(fss.est_manufacturing) AS total_manufacturing,\n       SUM(fss.est_construction) AS total_construction\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name,\n       SUM(fss.est_manufacturing) AS total_manufacturing,\n       SUM(fss.est_construction) AS total_construction\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "0fe8bc91", "question": "Pour l’année de recensement 2013, indiquez le nom de chaque sous-district ainsi que le total estimé des coûts de transport et de stockage et le total estimé des coûts d’hébergement et de restauration, regroupés et classés par ordre alphabétique selon le nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_TRANSPORT_STORAGE), SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fth.est_transport_storage) AS total_transport_storage, SUM(fth.est_accommodation_food) AS total_accommodation_food\nFROM fact_transport_hospitality fth\nJOIN dim_location dl ON fth.location_id = dl.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name, SUM(fth.est_transport_storage) AS total_transport_storage, SUM(fth.est_accommodation_food) AS total_accommodation_food\nFROM fact_transport_hospitality fth\nJOIN dim_location dl ON fth.location_id = dl.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "49d857a2", "question": "Listez les noms des sous-districts pour l’année de recensement « 2013 » où soit le total estimé de la fabrication est supérieur à 500, soit le total estimé de la construction est supérieur à 200, et ordonnez les résultats par ordre alphabétique selon le nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING) > 500 UNION SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_CONSTRUCTION) > 200 ORDER BY SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND (fss.est_manufacturing > 500 OR fss.est_construction > 200)\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_secondary_sector fss ON dl.location_id = fss.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND (fss.est_manufacturing > 500 OR fss.est_construction > 200)\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 64. Pred count: 41."}
{"pair_id": "ff9ec42b", "question": "Pour l’année de recensement 2013, listez les noms des sub-district et les noms des village ULB/RLB où le total estimé des dépenses d’hébergement et de restauration est d’au moins 0.000, et triez les résultats par ordre alphabétique selon le nom du sub-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_ACCOMMODATION_FOOD) >= 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fth.est_accommodation_food >= 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fth.est_accommodation_food >= 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 29896. Pred count: 29998."}
{"pair_id": "e7fc6264", "question": "Pour l’année de recensement 2013, listez les noms des sous-districts ainsi que le coût total estimé de l’hébergement et de la restauration pour les 10 sous-districts ayant les coûts totaux les plus élevés.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_ACCOMMODATION_FOOD) DESC LIMIT 10", "predicted_sql": "SELECT dl.sub_district_name, SUM(fth.est_accommodation_food) AS total_accommodation_food_cost\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_accommodation_food_cost DESC\nLIMIT 10;", "raw_output": "SELECT dl.sub_district_name, SUM(fth.est_accommodation_food) AS total_accommodation_food_cost\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_accommodation_food_cost DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "f5e1ad47", "question": "Pour l’année de recensement la plus récente disponible, listez les noms des sous-districts ainsi que le total estimé des coûts de transport et de stockage et le total estimé des coûts d’hébergement et de restauration, regroupés par sous-district et classés par le total estimé des coûts de transport et de stockage par ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_TRANSPORT_STORAGE), SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_TRANSPORT_STORAGE) DESC", "predicted_sql": "SELECT dl.sub_district_name,\n       SUM(fth.est_transport_storage) AS total_estimated_transport_storage,\n       SUM(fth.est_accommodation_food) AS total_estimated_accommodation_food\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_estimated_transport_storage DESC;", "raw_output": "SELECT dl.sub_district_name,\n       SUM(fth.est_transport_storage) AS total_estimated_transport_storage,\n       SUM(fth.est_accommodation_food) AS total_estimated_accommodation_food\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_estimated_transport_storage DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "579e0a14", "question": "Listez les noms des sous-districts de l’année de recensement 2013 dont la valeur totale estimée du transport et de l’entreposage était supérieure à zéro, en excluant spécifiquement les sous-districts qui ont également déclaré une valeur estimée de l’hébergement et de la restauration supérieure à zéro au cours de cette même année, et classez les résultats par ordre alphabétique du nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_TRANSPORT_STORAGE) > 0.000 AND T1.SUB_DISTRICT_NAME NOT IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T4 JOIN FACT_TRANSPORT_HOSPITALITY AS T5 ON T4.LOCATION_ID = T5.LOCATION_ID JOIN DIM_TIME AS T6 ON T5.TIME_ID = T6.TIME_ID WHERE T6.CENSUS_YEAR = '2013' AND T5.EST_ACCOMMODATION_FOOD > 0.000) ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nAND fth.est_transport_storage > 0\nAND fth.est_accommodation_food = 0\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nAND fth.est_transport_storage > 0\nAND fth.est_accommodation_food = 0\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 533. Pred count: 1201."}
{"pair_id": "e1ccb964", "question": "Pour l’année de recensement 2013, indiquez le nom de chaque sous-district ainsi que le coût total estimé de l’hébergement et de la restauration, triés par coût total par ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_ACCOMMODATION_FOOD) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fth.est_accommodation_food) AS total_accommodation_food_cost\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_accommodation_food_cost DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fth.est_accommodation_food) AS total_accommodation_food_cost\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_accommodation_food_cost DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a29de23a", "question": "Listez les noms des sous-districts par ordre alphabétique pour l’année de recensement 2013 où les valeurs estimées du transport et de l’entreposage ainsi que de l’hébergement et de la restauration sont toutes deux supérieures à zéro.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_TRANSPORT_STORAGE > 0.000 AND T2.EST_ACCOMMODATION_FOOD > 0.000 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nAND fth.est_transport_storage > 0\nAND fth.est_accommodation_food > 0\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nAND fth.est_transport_storage > 0\nAND fth.est_accommodation_food > 0\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5a214bd0", "question": "Listez les noms des sub-district de l’année 2013 pour lesquels la somme estimée du transport et du stockage est au moins égale à 0.000 et la somme estimée de l’hébergement et de la restauration est supérieure à 0.000, puis triez les résultats par ordre alphabétique selon le nom du sub-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_TRANSPORT_STORAGE) >= 0.000 AND SUM(T2.EST_ACCOMMODATION_FOOD) > 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fth.est_transport_storage >= 0.000\n  AND fth.est_accommodation_food > 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fth.est_transport_storage >= 0.000\n  AND fth.est_accommodation_food > 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a7c2466f", "question": "Listez les noms des ULB, des RLB ou des villages où la valeur estimée du transport et du stockage est supérieure à 50 ou la valeur estimée de l’hébergement et des services de restauration est supérieure à 50, classés par ordre alphabétique du nom du village.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.EST_TRANSPORT_STORAGE > 50 OR T2.EST_ACCOMMODATION_FOOD > 50 ORDER BY T1.ULB_RLB_VILLAGE_NAME", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nWHERE fth.est_transport_storage > 50 OR fth.est_accommodation_food > 50\nORDER BY dl.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nWHERE fth.est_transport_storage > 50 OR fth.est_accommodation_food > 50\nORDER BY dl.ulb_rlb_village_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 45. Pred count: 44."}
{"pair_id": "57101395", "question": "Pour l’année de recensement 2013, listez les noms des villages ULB RLB où la valeur estimée de la santé humaine et de l’action sociale est supérieure à 50.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_HUMAN_HEALTH_SOCIAL > 50", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND feh.est_human_health_social > 50;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND feh.est_human_health_social > 50;", "em": 0, "ex": 1, "error": null}
{"pair_id": "e9093393", "question": "Pour l’année de recensement 2013, listez les noms des ULB, RLB ou villages dont la valeur totale estimée des activités de santé humaine et d’action sociale est supérieure à 50, et classez les résultats par cette somme par ordre décroissant.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_HUMAN_HEALTH_SOCIAL) > 50 ORDER BY SUM(T2.EST_HUMAN_HEALTH_SOCIAL) DESC", "predicted_sql": "SELECT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND feh.est_human_health_social > 50\nORDER BY feh.est_human_health_social DESC;", "raw_output": "SELECT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND feh.est_human_health_social > 50\nORDER BY feh.est_human_health_social DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "4b45c0d6", "question": "Pour l’année de recensement la plus récente disponible, indiquez le nom de chaque village ULB RLB ainsi que la somme totale des établissements de santé humaine et d’action sociale, triés par somme totale en ordre décroissant.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 INNER JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID INNER JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY SUM(T2.EST_HUMAN_HEALTH_SOCIAL) DESC", "predicted_sql": "SELECT dl.ulb_rlb_village_name, SUM(feh.est_human_health_social) AS total_human_health_social_establishments\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.ulb_rlb_village_name\nORDER BY total_human_health_social_establishments DESC;", "raw_output": "SELECT dl.ulb_rlb_village_name, SUM(feh.est_human_health_social) AS total_human_health_social_establishments\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.ulb_rlb_village_name\nORDER BY total_human_health_social_establishments DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "e9ab06a4", "question": "Pour l’année de recensement 2013, listez les noms des sous-districts ainsi que la somme totale estimée de l’éducation et de la santé humaine et des services sociaux, classées par cette somme combinée par ordre décroissant pour les 5 principaux sous-districts.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) DESC LIMIT 5", "predicted_sql": "SELECT dl.sub_district_name, SUM(feh.est_education + feh.est_human_health_social) AS total_education_health\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_education_health DESC\nLIMIT 5;", "raw_output": "SELECT dl.sub_district_name, SUM(feh.est_education + feh.est_human_health_social) AS total_education_health\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_education_health DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "c197494e", "question": "Pour l’année de recensement la plus récente disponible, listez les noms des sous-districts ainsi que la somme totale estimée de l’éducation et de la santé humaine et des services sociaux, en affichant les 5 sous-districts ayant les totaux combinés les plus élevés.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) DESC LIMIT 5", "predicted_sql": "SELECT dl.sub_district_name, SUM(feh.est_education + feh.est_human_health_social) AS total_combined\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_combined DESC\nLIMIT 5;", "raw_output": "SELECT dl.sub_district_name, SUM(feh.est_education + feh.est_human_health_social) AS total_combined\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_combined DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "08065fd9", "question": "Listez les noms des sous-districts pour l’année de recensement 2013, regroupés par nom de sous-district, où la somme estimée de l’éducation et la somme estimée de la santé humaine et de l’action sociale sont toutes deux au moins égales à 0.000, et triez les résultats par ordre alphabétique selon le nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_EDUCATION) >= 0.000 AND SUM(T2.EST_HUMAN_HEALTH_SOCIAL) >= 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nHAVING SUM(feh.est_education) >= 0.000 AND SUM(feh.est_human_health_social) >= 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nHAVING SUM(feh.est_education) >= 0.000 AND SUM(feh.est_human_health_social) >= 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "ad513455", "question": "Pour l’année de recensement 2013, listez les noms des sous-districts où la valeur estimée de la santé humaine et de l’action sociale est supérieure à 0.000, mais où la somme totale estimée de l’éducation est exactement égale à 0.000, classés par ordre alphabétique selon le nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_HUMAN_HEALTH_SOCIAL > 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_EDUCATION) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND feh.est_human_health_social > 0.000\n  AND feh.est_education = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND feh.est_human_health_social > 0.000\n  AND feh.est_education = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 1141. Pred count: 1378."}
{"pair_id": "d5b2cc85", "question": "Listez les noms des sous-districts et les noms des villages ULB/RLB où le nombre total d’établissements détenus par des femmes est supérieur au nombre total d’établissements détenus par des hommes.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_OWNED_BY_FEMALE) > SUM(T2.EST_OWNED_BY_MALE)", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nWHERE fgo.est_owned_by_female > fgo.est_owned_by_male;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nWHERE fgo.est_owned_by_female > fgo.est_owned_by_male;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 2080. Pred count: 2087."}
{"pair_id": "f89a1184", "question": "Listez le nom du sub-district et l’année du recensement, ainsi que la somme totale des valeurs estimées de l’éducation et des valeurs estimées de la santé humaine et des services sociaux, pour chaque sub-district et année de recensement où cette somme est au moins égale à 0.000, classés par année de recensement et par somme totale en ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T2.CENSUS_YEAR, SUM(T3.EST_EDUCATION + T3.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 INNER JOIN FACT_EDUCATION_HEALTH AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID INNER JOIN DIM_TIME AS T2 ON T3.TIME_ID = T2.TIME_ID GROUP BY T1.SUB_DISTRICT_NAME, T2.CENSUS_YEAR HAVING SUM(T3.EST_EDUCATION + T3.EST_HUMAN_HEALTH_SOCIAL) >= 0.000 ORDER BY T2.CENSUS_YEAR DESC, SUM(T3.EST_EDUCATION + T3.EST_HUMAN_HEALTH_SOCIAL) DESC", "predicted_sql": "SELECT dl.sub_district_name, dt.census_year, SUM(feh.est_education + feh.est_human_health_social) AS total_sum\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nGROUP BY dl.sub_district_name, dt.census_year\nHAVING SUM(feh.est_education + feh.est_human_health_social) >= 0.000\nORDER BY dt.census_year, total_sum DESC;", "raw_output": "SELECT dl.sub_district_name, dt.census_year, SUM(feh.est_education + feh.est_human_health_social) AS total_sum\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nGROUP BY dl.sub_district_name, dt.census_year\nHAVING SUM(feh.est_education + feh.est_human_health_social) >= 0.000\nORDER BY dt.census_year, total_sum DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "09a62cf5", "question": "Pour l’année de recensement 2013, listez les noms des villages ULB RLB et les noms de sous-district correspondants, spécifiquement pour les localités où la somme des valeurs estimées de l’éducation est d’au moins 1.000 et la somme des valeurs estimées de la santé humaine et des services sociaux est d’au moins 1.000, classés par ordre alphabétique du nom du sous-district.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME, T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.ULB_RLB_VILLAGE_NAME, T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_EDUCATION) >= 1.000 AND SUM(T2.EST_HUMAN_HEALTH_SOCIAL) >= 1.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND feh.est_education >= 1.000\n  AND feh.est_human_health_social >= 1.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND feh.est_education >= 1.000\n  AND feh.est_human_health_social >= 1.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 753. Pred count: 757."}
{"pair_id": "f9a67de8", "question": "Listez les noms des sous-districts pour l’année de recensement 2013 où la valeur totale estimée de la santé humaine et de l’action sociale est supérieure à 0.000 et la valeur totale estimée de l’éducation est exactement égale à 0.000, classés par ordre alphabétique selon le nom du sous-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_HUMAN_HEALTH_SOCIAL) > 0.000 AND SUM(T2.EST_EDUCATION) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND feh.est_human_health_social > 0.000\n  AND feh.est_education = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND feh.est_human_health_social > 0.000\n  AND feh.est_education = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 921. Pred count: 1378."}
{"pair_id": "3222d0c9", "question": "Pour l’année de recensement la plus récente disponible, indiquez le nom de chaque sous-district ainsi que la somme totale des établissements appartenant à des femmes, regroupés par sous-district et classés du total le plus élevé au plus faible.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_female_owned_establishments\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_female_owned_establishments DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_female_owned_establishments\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_female_owned_establishments DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "58b60029", "question": "Pour l’année de recensement la plus récente disponible, indiquez le nom de chaque sous-district ainsi que la somme totale des établissements appartenant à des femmes, regroupés par sous-district et classés de la somme la plus élevée à la plus faible.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_female_owned_establishments\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_female_owned_establishments DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_female_owned_establishments\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_female_owned_establishments DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "79e89edd", "question": "Pour l’année de recensement 2013, indiquez le nom de chaque sous-district ainsi que la somme totale des établissements détenus par des femmes, regroupés par sous-district et classés du total le plus élevé au plus faible.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_est_owned_by_female\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_est_owned_by_female DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_est_owned_by_female\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_est_owned_by_female DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "64e64570", "question": "Pour l’année de recensement la plus récente disponible, indiquez le nom de chaque sous-district ainsi que la somme totale des établissements appartenant à des femmes, regroupés par sous-district et classés du nombre le plus élevé au plus faible.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_female_owned_establishments\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_female_owned_establishments DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_female_owned_establishments\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_female_owned_establishments DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "9e644c4d", "question": "Pour l’année de recensement 2013, en ne considérant que l’enregistrement avec l’identifiant temporel maximal disponible, listez les noms des ULB, RLB ou villages où la somme totale des établissements appartenant à des femmes est exactement égale à zéro.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_OWNED_BY_FEMALE) = 0.000", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fgo.time_id = (SELECT MAX(time_id) FROM dim_time WHERE census_year = 2013)\n  AND fgo.est_owned_by_female = 0;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fgo.time_id = (SELECT MAX(time_id) FROM dim_time WHERE census_year = 2013)\n  AND fgo.est_owned_by_female = 0;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 14649. Pred count: 15461."}
{"pair_id": "1d4a3e0b", "question": "Pour l’année de recensement 2013, listez les noms des sous-districts où le nombre d’établissements appartenant à des femmes est supérieur à zéro, en veillant à ce que chaque nom de sous-district ne soit inclus que s’il possède au moins un enregistrement.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_OWNED_BY_FEMALE > 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING COUNT(T1.SUB_DISTRICT_NAME) > 0", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fgo.est_owned_by_female > 0;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND fgo.est_owned_by_female > 0;", "em": 0, "ex": 1, "error": null}
{"pair_id": "0783bd49", "question": "Pour l’année de recensement 2013, listez chaque nom de sub-district et nom de village ULB/RLB ainsi que le nombre total d’establishments détenus par des femmes, en incluant uniquement les localités où ce nombre est supérieur à zéro, et classez les résultats du total le plus élevé au plus faible.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_OWNED_BY_FEMALE) > 0.000 ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fgo.est_owned_by_female) AS total_establishments_owned_by_female\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nHAVING SUM(fgo.est_owned_by_female) > 0\nORDER BY total_establishments_owned_by_female DESC;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fgo.est_owned_by_female) AS total_establishments_owned_by_female\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nHAVING SUM(fgo.est_owned_by_female) > 0\nORDER BY total_establishments_owned_by_female DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "bf70d789", "question": "Pour l’année de recensement 2013, indiquez les noms des sous-districts et le nombre total d’établissements détenus par des femmes pour chaque sous-district, en affichant uniquement les 5 sous-districts ayant les totaux les plus élevés.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC LIMIT 5", "predicted_sql": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establishments_owned_by_females\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_establishments_owned_by_females DESC\nLIMIT 5;", "raw_output": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establishments_owned_by_females\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_establishments_owned_by_females DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "b766b4e4", "question": "Listez les noms des sub-district, classés par ordre alphabétique, pour les enregistrements où soit l’année du recensement est 2013 et le nom du village est « Chouldari (Rv) », soit le nombre de establishments détenus par d’autres genres est 0.000, en veillant à ce qu’au moins un enregistrement temporel existe pour chaque sub-district.", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME FROM FACT_GENDER_OWNERSHIP AS T1 JOIN DIM_LOCATION AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID WHERE (T3.CENSUS_YEAR = '2013' AND T2.ULB_RLB_VILLAGE_NAME = 'Chouldari (Rv)') OR T1.EST_OWNED_BY_OTHER_GENDER = 0.000 GROUP BY T2.SUB_DISTRICT_NAME HAVING COUNT(T3.TIME_ID) > 0 ORDER BY T2.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE (dt.census_year = 2013 AND dl.ulb_rlb_village_name ILIKE 'Chouldari (Rv)')\n   OR fgo.est_owned_by_other_gender = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE (dt.census_year = 2013 AND dl.ulb_rlb_village_name ILIKE 'Chouldari (Rv)')\n   OR fgo.est_owned_by_other_gender = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "cb5b8b67", "question": "Listez les noms des sub-district pour l’année de recensement 2013, classés par le nombre estimé de religious properties détenues par des Sikhs par ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' ORDER BY T2.EST_OWNED_BY_SIKH DESC", "predicted_sql": "SELECT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nORDER BY fro.est_owned_by_sikh DESC;", "raw_output": "SELECT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nORDER BY fro.est_owned_by_sikh DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "e5c96235", "question": "Pour l’année de recensement la plus récente disponible, indiquez le nom de chaque sous-district ainsi que le nombre total d’établissements appartenant à des hindous, le total appartenant à des musulmans et le total appartenant à des chrétiens, classés par ordre décroissant selon la somme combinée de ces trois catégories de propriété religieuse.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_HINDU), SUM(T2.EST_OWNED_BY_ISLAM), SUM(T2.EST_OWNED_BY_CHRISTIAN) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_HINDU + T2.EST_OWNED_BY_ISLAM + T2.EST_OWNED_BY_CHRISTIAN) DESC", "predicted_sql": "SELECT dl.sub_district_name,\n       SUM(fro.est_owned_by_hindu) AS total_hindu,\n       SUM(fro.est_owned_by_islam) AS total_muslim,\n       SUM(fro.est_owned_by_christian) AS total_christian\nFROM dim_time dt\nJOIN fact_religious_ownership fro ON dt.time_id = fro.time_id\nJOIN dim_location dl ON fro.location_id = dl.location_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY (SUM(fro.est_owned_by_hindu) + SUM(fro.est_owned_by_islam) + SUM(fro.est_owned_by_christian)) DESC;", "raw_output": "SELECT dl.sub_district_name,\n       SUM(fro.est_owned_by_hindu) AS total_hindu,\n       SUM(fro.est_owned_by_islam) AS total_muslim,\n       SUM(fro.est_owned_by_christian) AS total_christian\nFROM dim_time dt\nJOIN fact_religious_ownership fro ON dt.time_id = fro.time_id\nJOIN dim_location dl ON fro.location_id = dl.location_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY (SUM(fro.est_owned_by_hindu) + SUM(fro.est_owned_by_islam) + SUM(fro.est_owned_by_christian)) DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "c7d19184", "question": "Pour l’année de recensement 2013, indiquez les noms des sous-districts et les noms des villages ULB/RLB, ainsi que la somme totale des établissements appartenant à des Sikhs, regroupés par sous-district et par nom de village, et classés par somme décroissante.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME ORDER BY SUM(T2.EST_OWNED_BY_SIKH) DESC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_establishments_owned_by_sikhs\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nORDER BY total_establishments_owned_by_sikhs DESC;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_establishments_owned_by_sikhs\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nORDER BY total_establishments_owned_by_sikhs DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "9382a4a2", "question": "Pour l’année de recensement 2013, indiquez le nom de chaque sous-district ainsi que la somme totale des établissements appartenant à des Sikhs, classés par ordre décroissant de cette somme totale.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_SIKH) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_sikh_owned_establishments\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_sikh_owned_establishments DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_sikh_owned_establishments\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_sikh_owned_establishments DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "47e9d55d", "question": "Pour l’année de recensement 2013, listez les noms des sous-districts et les noms des villages ULB/RLB ainsi que la somme totale des établissements appartenant à des Sikhs, regroupés à la fois par sous-district et par nom de village.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_establishments_owned_by_sikhs\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nHAVING SUM(fro.est_owned_by_sikh) > 0;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_establishments_owned_by_sikhs\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nHAVING SUM(fro.est_owned_by_sikh) > 0;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 29896. Pred count: 1008."}
{"pair_id": "ffc386b1", "question": "Listez les noms des sous-districts et le nombre total d’établissements appartenant à des Sikhs, uniquement pour ceux dont le statut du commerce de détail est « 1.000 », regroupés par sous-district et classés par la somme des établissements appartenant à des Sikhs par ordre décroissant pour les 5 premiers résultats.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_TRADE_SECTOR AS T3 ON T2.LOCATION_ID = T3.LOCATION_ID WHERE T3.EST_RETAIL_TRADE = '1.000' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_SIKH) DESC LIMIT 5", "predicted_sql": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_sikh_establishments\nFROM dim_location dl\nJOIN fact_trade_sector fts ON dl.location_id = fts.location_id\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nWHERE fts.est_retail_trade = 1.000\nGROUP BY dl.sub_district_name\nORDER BY total_sikh_establishments DESC\nLIMIT 5;", "raw_output": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_sikh_establishments\nFROM dim_location dl\nJOIN fact_trade_sector fts ON dl.location_id = fts.location_id\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nWHERE fts.est_retail_trade = 1.000\nGROUP BY dl.sub_district_name\nORDER BY total_sikh_establishments DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "b04846f6", "question": "Listez les noms des sous-districts et le nombre total d’établissements appartenant à des Sikhs pour la période ayant l’identifiant 1, regroupés par sous-district et classés par nombre décroissant, en n’affichant que les 5 premiers résultats.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.TIME_ID = 1 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_SIKH) DESC LIMIT 5", "predicted_sql": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_sikh_establishments\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.time_id = 1\nGROUP BY dl.sub_district_name\nORDER BY total_sikh_establishments DESC\nLIMIT 5;", "raw_output": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_sikh_establishments\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.time_id = 1\nGROUP BY dl.sub_district_name\nORDER BY total_sikh_establishments DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "3fffc294", "question": "Listez les noms des sub-district où, pour l’année de recensement 2013, soit le nombre total de establishments détenus par des Sikhs, soit le nombre total de establishments détenus par des Jains est supérieur à 500.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_OWNED_BY_SIKH) > 500 OR SUM(T2.EST_OWNED_BY_JAIN) > 500", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND (fro.est_owned_by_sikh > 500 OR fro.est_owned_by_jain > 500);", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND (fro.est_owned_by_sikh > 500 OR fro.est_owned_by_jain > 500);", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 4. Pred count: 1."}
{"pair_id": "2ad8247d", "question": "Listez les noms des sub-district pour l’année de recensement 2013 où le nombre total de establishments appartenant à des Sikhs est supérieur à zéro et le nombre total de establishments appartenant à des Jains est exactement égal à zéro, regroupés et classés par ordre alphabétique selon le nom du sub-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_OWNED_BY_SIKH) > 0.000 AND SUM(T2.EST_OWNED_BY_JAIN) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n    AND fro.est_owned_by_sikh > 0\n    AND fro.est_owned_by_jain = 0\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n    AND fro.est_owned_by_sikh > 0\n    AND fro.est_owned_by_jain = 0\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 286. Pred count: 374."}
{"pair_id": "a994e9a8", "question": "Pour l’année de recensement 2013, indiquez le nom de chaque sous-district et le nom du village ULB/RLB, ainsi que la somme totale des établissements appartenant à des Sikhs, lorsque cette somme est supérieure ou égale à zéro, et triez les résultats par somme totale par ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_OWNED_BY_SIKH >= 0.000 GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_OWNED_BY_SIKH) >= 0.000 ORDER BY SUM(T2.EST_OWNED_BY_SIKH) DESC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_sikh_owned_establishments\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nHAVING SUM(fro.est_owned_by_sikh) >= 0\nORDER BY total_sikh_owned_establishments DESC;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_sikh_owned_establishments\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nHAVING SUM(fro.est_owned_by_sikh) >= 0\nORDER BY total_sikh_owned_establishments DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "4d623596", "question": "Listez le nom du sous-district, le nom du village ULB/RLB et le nom du district pour les districts de Chittoor, South Andamans et Nicobars, en veillant à ce que chaque combinaison ait au moins un identifiant de localisation, et classez les résultats par ordre alphabétique du nom du sous-district.", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME, T1.DISTRICT_NAME FROM DIM_DISTRICT AS T1 INNER JOIN DIM_LOCATION AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID WHERE T1.DISTRICT_NAME IN ('Chittoor', 'South Andamans', 'Nicobars') GROUP BY T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME, T1.DISTRICT_NAME HAVING COUNT(T2.LOCATION_ID) >= 1 ORDER BY T2.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT l.sub_district_name, l.ulb_rlb_village_name, d.district_name\nFROM dim_location l\nJOIN dim_district d ON l.district_id = d.district_id\nWHERE d.district_name ILIKE 'Chittoor'\n   OR d.district_name ILIKE 'South Andamans'\n   OR d.district_name ILIKE 'Nicobars'\nORDER BY l.sub_district_name;", "raw_output": "SELECT l.sub_district_name, l.ulb_rlb_village_name, d.district_name\nFROM dim_location l\nJOIN dim_district d ON l.district_id = d.district_id\nWHERE d.district_name ILIKE 'Chittoor'\n   OR d.district_name ILIKE 'South Andamans'\n   OR d.district_name ILIKE 'Nicobars'\nORDER BY l.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 95. Pred count: 95."}
{"pair_id": "a80ce3c9", "question": "Pour l’année de recensement 2013, listez les noms des sub-district et les noms des villages ULB/RLB pour les localités où la détention estimée par des Sikhs est supérieure ou égale à 0.000, classés par ordre alphabétique du nom du sub-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T2.EST_OWNED_BY_SIKH >= 0.000 AND T3.CENSUS_YEAR = '2013' ORDER BY T1.SUB_DISTRICT_NAME", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fro.est_owned_by_sikh >= 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fro.est_owned_by_sikh >= 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "e591a0fb", "question": "Listez les noms des sub-district du recensement de 2013 où il existe au moins un establishments appartenant à des Sikhs, mais où la somme totale des establishments appartenant à des Jains dans ce sub-district est exactement nulle.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_OWNED_BY_SIKH > 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_OWNED_BY_JAIN) = 0.000", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fro.est_owned_by_sikh > 0\n  AND dl.location_id IN (\n    SELECT location_id\n    FROM fact_religious_ownership\n    WHERE time_id IN (SELECT time_id FROM dim_time WHERE census_year = 2013)\n    GROUP BY location_id\n    HAVING COALESCE(SUM(est_owned_by_jain), 0) = 0\n  );", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fro.est_owned_by_sikh > 0\n  AND dl.location_id IN (\n    SELECT location_id\n    FROM fact_religious_ownership\n    WHERE time_id IN (SELECT time_id FROM dim_time WHERE census_year = 2013)\n    GROUP BY location_id\n    HAVING COALESCE(SUM(est_owned_by_jain), 0) = 0\n  );", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 351. Pred count: 374."}
{"pair_id": "f279081a", "question": "Pour chaque sous-district, indiquez le nom du sous-district, le total estimé des financements provenant des établissements de prêt et le total estimé des financements provenant des prêts des groupes d’entraide, classés par ordre décroissant du total estimé des financements provenant des établissements de prêt.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_FINANCE_BORROW_INSTITUTION), SUM(T2.EST_FINANCE_LOAN_SELF_HELP_GROUP) FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_FINANCE_BORROW_INSTITUTION) DESC", "predicted_sql": "SELECT dl.sub_district_name,\n       SUM(ffs.est_finance_borrow_institution) AS total_finance_borrow_institution,\n       SUM(ffs.est_finance_loan_self_help_group) AS total_finance_loan_self_help_group\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nGROUP BY dl.sub_district_name\nORDER BY total_finance_borrow_institution DESC;", "raw_output": "SELECT dl.sub_district_name,\n       SUM(ffs.est_finance_borrow_institution) AS total_finance_borrow_institution,\n       SUM(ffs.est_finance_loan_self_help_group) AS total_finance_loan_self_help_group\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nGROUP BY dl.sub_district_name\nORDER BY total_finance_borrow_institution DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "0d4f65de", "question": "Pour chaque nom de sous-district dans la catégorie du secteur rural, indiquez le nom du sous-district ainsi que le financement total estimé provenant des emprunts institutionnels et le financement total estimé provenant des prêts des groupes d’entraide, à condition que le total des emprunts institutionnels soit supérieur à zéro, et triez les résultats par total des emprunts institutionnels par ordre décroissant.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_FINANCE_BORROW_INSTITUTION) AS total_institutional_borrowing, SUM(T2.EST_FINANCE_LOAN_SELF_HELP_GROUP) AS total_shg_loans FROM DIM_LOCATION AS T1 INNER JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID INNER JOIN DIM_SECTOR_CATEGORY AS T3 ON T2.SECTOR_ID = T3.SECTOR_ID WHERE T3.SECTOR_CATEGORY = 'Rural' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_FINANCE_BORROW_INSTITUTION) > 0.000 ORDER BY total_institutional_borrowing DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(f.est_finance_borrow_institution) AS total_institutional_borrow, SUM(f.est_finance_loan_self_help_group) AS total_self_help_group_loan FROM dim_location dl JOIN fact_finance_sources f ON dl.location_id = f.location_id JOIN dim_sector_category dsc ON f.sector_id = dsc.sector_id WHERE dsc.sector_category ILIKE 'Rural' GROUP BY dl.sub_district_name HAVING SUM(f.est_finance_borrow_institution) > 0 ORDER BY total_institutional_borrow DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(f.est_finance_borrow_institution) AS total_institutional_borrow, SUM(f.est_finance_loan_self_help_group) AS total_self_help_group_loan FROM dim_location dl JOIN fact_finance_sources f ON dl.location_id = f.location_id JOIN dim_sector_category dsc ON f.sector_id = dsc.sector_id WHERE dsc.sector_category ILIKE 'Rural' GROUP BY dl.sub_district_name HAVING SUM(f.est_finance_borrow_institution) > 0 ORDER BY total_institutional_borrow DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "414ab4d4", "question": "Listez les noms des ULB, des RLB ou des villages, triés par ordre alphabétique, dont le montant estimé de l’aide financière gouvernementale est de 0.000 et dont le montant estimé du financement par prêt des groupes d’entraide est de 0.000.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.EST_FINANCE_GOVT_ASSISTANCE = 0.000 AND T2.EST_FINANCE_LOAN_SELF_HELP_GROUP = 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN fact_finance_sources ON dim_location.location_id = fact_finance_sources.location_id\nWHERE fact_finance_sources.est_finance_govt_assistance = 0.000\n  AND fact_finance_sources.est_finance_loan_self_help_group = 0.000\nORDER BY dim_location.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN fact_finance_sources ON dim_location.location_id = fact_finance_sources.location_id\nWHERE fact_finance_sources.est_finance_govt_assistance = 0.000\n  AND fact_finance_sources.est_finance_loan_self_help_group = 0.000\nORDER BY dim_location.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "d08fd177", "question": "Pour l’année de recensement la plus récente disponible, indiquez le nom de chaque sous-district ainsi que le montant total estimé de l’aide financière gouvernementale, regroupés par nom de sous-district et classés du montant total d’aide le plus élevé au plus faible.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_FINANCE_GOVT_ASSISTANCE) FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_FINANCE_GOVT_ASSISTANCE) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fs.est_finance_govt_assistance) AS total_aide_gouvernementale\nFROM dim_location dl\nJOIN fact_finance_sources fs ON dl.location_id = fs.location_id\nJOIN dim_time dt ON fs.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_aide_gouvernementale DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fs.est_finance_govt_assistance) AS total_aide_gouvernementale\nFROM dim_location dl\nJOIN fact_finance_sources fs ON dl.location_id = fs.location_id\nJOIN dim_time dt ON fs.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_aide_gouvernementale DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "fba7fb6b", "question": "Listez les noms des ULB, des RLB ou des villages qui ont au moins un enregistrement de source de financement, mais spécifiquement lorsque l’aide gouvernementale estimée est de 0.000 et que le prêt estimé provenant des groupes d’entraide est également de 0.000, classés par ordre alphabétique du nom du village.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.EST_FINANCE_GOVT_ASSISTANCE = 0.000 AND T2.EST_FINANCE_LOAN_SELF_HELP_GROUP = 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING COUNT(T2.FACT_FINANCE_SOURCES_ID) > 0 ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000\nORDER BY dl.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000\nORDER BY dl.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a457d390", "question": "Pour l’année de recensement la plus récente disponible, indiquez le nom de chaque village ULB/RLB ainsi que le montant total estimé de l’aide financière gouvernementale et le montant total estimé du financement provenant des établissements d’emprunt, regroupés par nom de village et classés par ordre décroissant du total de l’aide gouvernementale.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_FINANCE_GOVT_ASSISTANCE), SUM(T2.EST_FINANCE_BORROW_INSTITUTION) FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY SUM(T2.EST_FINANCE_GOVT_ASSISTANCE) DESC", "predicted_sql": "SELECT\n    dl.ulb_rlb_village_name,\n    SUM(ffs.est_finance_govt_assistance) AS total_aide_gouvernementale,\n    SUM(ffs.est_finance_borrow_institution) AS total_financement_emprunt_institution\nFROM dim_time dt\nJOIN fact_finance_sources ffs ON dt.time_id = ffs.time_id\nJOIN dim_location dl ON ffs.location_id = dl.location_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.ulb_rlb_village_name\nORDER BY total_aide_gouvernementale DESC;", "raw_output": "SELECT\n    dl.ulb_rlb_village_name,\n    SUM(ffs.est_finance_govt_assistance) AS total_aide_gouvernementale,\n    SUM(ffs.est_finance_borrow_institution) AS total_financement_emprunt_institution\nFROM dim_time dt\nJOIN fact_finance_sources ffs ON dt.time_id = ffs.time_id\nJOIN dim_location dl ON ffs.location_id = dl.location_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.ulb_rlb_village_name\nORDER BY total_aide_gouvernementale DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "c4e8af4a", "question": "Listez les noms des sub-district, triés par ordre alphabétique, pour tous les sub-district qui ont au moins un enregistrement de source de financement où à la fois l’aide financière gouvernementale estimée et le montant estimé emprunté auprès des institutions sont égaux à 0.000.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T2.EST_FINANCE_GOVT_ASSISTANCE = 0.000 AND T2.EST_FINANCE_BORROW_INSTITUTION = 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING COUNT(T2.FACT_FINANCE_SOURCES_ID) > 0 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000 AND ffs.est_finance_borrow_institution = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000 AND ffs.est_finance_borrow_institution = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "bb7e100c", "question": "Listez les noms des sub-district pour l’année de recensement 2013 où le total estimé de l’aide financière gouvernementale est supérieur à 0.000 et où le total estimé du financement provenant des groupes d’entraide par prêt est exactement égal à 0.000.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_FINANCE_GOVT_ASSISTANCE) > 0.000 AND SUM(T2.EST_FINANCE_LOAN_SELF_HELP_GROUP) = 0.000", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND ffs.est_finance_govt_assistance > 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND ffs.est_finance_govt_assistance > 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 1965. Pred count: 2361."}
{"pair_id": "309a5f49", "question": "Listez les noms des sub-district de l’année de recensement 2013 où le total estimé de l’aide financière gouvernementale est supérieur à 0.000 et où le total estimé du financement provenant des groupes d’entraide par prêt est exactement égal à 0.000, classés par ordre alphabétique selon le nom du sub-district.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_FINANCE_GOVT_ASSISTANCE) > 0.000 AND SUM(T2.EST_FINANCE_LOAN_SELF_HELP_GROUP) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND ffs.est_finance_govt_assistance > 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND ffs.est_finance_govt_assistance > 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 1965. Pred count: 2361."}
{"pair_id": "471bea0a", "question": "Listez les noms des sub-district, classés par ordre alphabétique, pour les zones où le financement estimé provenant de l’aide gouvernementale est de 0.000 et où le financement estimé emprunté auprès d’institutions est également de 0.000.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.EST_FINANCE_GOVT_ASSISTANCE = 0.000 AND T2.EST_FINANCE_BORROW_INSTITUTION = 0.000 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000\n  AND ffs.est_finance_borrow_institution = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000\n  AND ffs.est_finance_borrow_institution = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
