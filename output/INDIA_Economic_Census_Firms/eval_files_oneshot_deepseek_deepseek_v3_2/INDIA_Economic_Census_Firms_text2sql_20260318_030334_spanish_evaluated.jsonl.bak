{"pair_id": "58dafef6", "question": "Enumera los nombres de los estados y el recuento total de IDs de distrito para cada estado, ordenados por el número de distritos en orden descendente, y muestra solo los 5 primeros resultados.", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T2.DISTRICT_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T2.DISTRICT_ID) DESC LIMIT 5", "predicted_sql": "SELECT dim_state.state_name, COUNT(dim_district.district_id) AS district_count\nFROM dim_state\nJOIN dim_district ON dim_state.state_id = dim_district.state_id\nGROUP BY dim_state.state_name\nORDER BY district_count DESC\nLIMIT 5;", "raw_output": "SELECT dim_state.state_name, COUNT(dim_district.district_id) AS district_count\nFROM dim_state\nJOIN dim_district ON dim_state.state_id = dim_district.state_id\nGROUP BY dim_state.state_name\nORDER BY district_count DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "57e740c7", "question": "Enumera el nombre de cada estado y el recuento total de IDs de distrito asociados a él, ordenados del mayor número de distritos al menor.", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T2.DISTRICT_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T2.DISTRICT_ID) DESC", "predicted_sql": "SELECT dim_state.state_name, COUNT(dim_district.district_id) AS district_count FROM dim_state LEFT JOIN dim_district ON dim_state.state_id = dim_district.state_id GROUP BY dim_state.state_name ORDER BY district_count DESC;", "raw_output": "SELECT dim_state.state_name, COUNT(dim_district.district_id) AS district_count FROM dim_state LEFT JOIN dim_district ON dim_state.state_id = dim_district.state_id GROUP BY dim_state.state_name ORDER BY district_count DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "ecf4ae55", "question": "Enumera los nombres únicos de los estados ubicados en el país «India» y combínalos con una lista de los nombres únicos de los distritos que se encuentran dentro del estado de «Andhra Pradesh».", "gold_sql": "SELECT DISTINCT T1.STATE_NAME FROM DIM_STATE AS T1 JOIN DIM_COUNTRY AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID WHERE T2.COUNTRY_NAME = 'India' UNION SELECT DISTINCT T3.DISTRICT_NAME FROM DIM_DISTRICT AS T3 JOIN DIM_STATE AS T4 ON T3.STATE_ID = T4.STATE_ID WHERE T4.STATE_NAME = 'Andhra Pradesh';", "predicted_sql": "SELECT DISTINCT state_name FROM dim_state WHERE country_id = (SELECT country_id FROM dim_country WHERE country_name ILIKE 'India')\nUNION\nSELECT DISTINCT district_name FROM dim_district WHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh');", "raw_output": "SELECT DISTINCT state_name FROM dim_state WHERE country_id = (SELECT country_id FROM dim_country WHERE country_name ILIKE 'India')\nUNION\nSELECT DISTINCT district_name FROM dim_district WHERE state_id = (SELECT state_id FROM dim_state WHERE state_name ILIKE 'Andhra Pradesh');", "em": 0, "ex": 1, "error": null}
{"pair_id": "7a3b84bc", "question": "Enumera los nombres de los distritos de todos los distritos ubicados en el estado de 'Andhra Pradesh', ordenados alfabéticamente por nombre del distrito.", "gold_sql": "SELECT T1.DISTRICT_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID WHERE T2.STATE_NAME = 'Andhra Pradesh' ORDER BY T1.DISTRICT_NAME", "predicted_sql": "SELECT dim_district.district_name FROM dim_district JOIN dim_state ON dim_district.state_id = dim_state.state_id WHERE dim_state.state_name ILIKE 'Andhra Pradesh' ORDER BY dim_district.district_name ASC;", "raw_output": "SELECT dim_district.district_name FROM dim_district JOIN dim_state ON dim_district.state_id = dim_state.state_id WHERE dim_state.state_name ILIKE 'Andhra Pradesh' ORDER BY dim_district.district_name ASC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "9432abec", "question": "Enumera el nombre del distrito, el nombre del estado y el nombre del país para todas las entradas, ordenados alfabéticamente por el nombre del distrito.", "gold_sql": "SELECT T1.DISTRICT_NAME, T2.STATE_NAME, T3.COUNTRY_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_COUNTRY AS T3 ON T2.COUNTRY_ID = T3.COUNTRY_ID ORDER BY T1.DISTRICT_NAME", "predicted_sql": "SELECT dim_district.district_name, dim_state.state_name, dim_country.country_name FROM dim_district JOIN dim_state ON dim_district.state_id = dim_state.state_id JOIN dim_country ON dim_state.country_id = dim_country.country_id ORDER BY dim_district.district_name;", "raw_output": "SELECT dim_district.district_name, dim_state.state_name, dim_country.country_name FROM dim_district JOIN dim_state ON dim_district.state_id = dim_state.state_id JOIN dim_country ON dim_state.country_id = dim_country.country_id ORDER BY dim_district.district_name;", "em": 1, "ex": 1, "error": null}
{"pair_id": "4e414781", "question": "Enumere el nombre del país, el nombre del estado y el nombre del distrito para los distritos llamados 'Chittoor', asegurándose de que exista al menos un registro de país para estas entradas, y ordene los resultados alfabéticamente por el nombre del estado y luego por el nombre del país.", "gold_sql": "SELECT T3.COUNTRY_NAME, T2.STATE_NAME, T1.DISTRICT_NAME FROM DIM_DISTRICT AS T1 INNER JOIN DIM_STATE AS T2 ON T1.STATE_ID = T2.STATE_ID INNER JOIN DIM_COUNTRY AS T3 ON T2.COUNTRY_ID = T3.COUNTRY_ID WHERE T1.DISTRICT_NAME = 'Chittoor' GROUP BY T3.COUNTRY_NAME, T2.STATE_NAME, T1.DISTRICT_NAME HAVING COUNT(T3.COUNTRY_ID) >= 1 ORDER BY T2.STATE_NAME ASC, T3.COUNTRY_NAME ASC", "predicted_sql": "SELECT dim_country.country_name, dim_state.state_name, dim_district.district_name FROM dim_district INNER JOIN dim_state ON dim_district.state_id = dim_state.state_id INNER JOIN dim_country ON dim_state.country_id = dim_country.country_id WHERE dim_district.district_name ILIKE 'Chittoor' ORDER BY dim_state.state_name, dim_country.country_name;", "raw_output": "SELECT dim_country.country_name, dim_state.state_name, dim_district.district_name FROM dim_district INNER JOIN dim_state ON dim_district.state_id = dim_state.state_id INNER JOIN dim_country ON dim_state.country_id = dim_country.country_id WHERE dim_district.district_name ILIKE 'Chittoor' ORDER BY dim_state.state_name, dim_country.country_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "29c4da79", "question": "Enumera los nombres de los distritos del estado llamado 'Andhra Pradesh', agrupados y ordenados alfabéticamente por nombre de distrito.", "gold_sql": "SELECT T3.DISTRICT_NAME FROM DIM_COUNTRY AS T1 INNER JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID INNER JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T2.STATE_NAME = 'Andhra Pradesh' GROUP BY T3.DISTRICT_NAME ORDER BY T3.DISTRICT_NAME ASC", "predicted_sql": "SELECT dim_district.district_name\nFROM dim_district\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh'\nGROUP BY dim_district.district_name\nORDER BY dim_district.district_name ASC;", "raw_output": "SELECT dim_district.district_name\nFROM dim_district\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh'\nGROUP BY dim_district.district_name\nORDER BY dim_district.district_name ASC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "ca1147c3", "question": "Enumere los nombres de los ULB, RLB o pueblos ubicados en el estado de 'Andhra Pradesh', agrupados y ordenados alfabéticamente por el nombre del pueblo.", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME", "predicted_sql": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nINNER JOIN dim_district ON dim_location.district_id = dim_district.district_id\nINNER JOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh'\nORDER BY dim_location.ulb_rlb_village_name ASC;", "raw_output": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nINNER JOIN dim_district ON dim_location.district_id = dim_district.district_id\nINNER JOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh'\nORDER BY dim_location.ulb_rlb_village_name ASC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "cfe28a36", "question": "Para el país llamado 'India', enumera el nombre de cada estado junto con el recuento total de distritos dentro de ese estado, asegurándote de incluir solo los estados con al menos un distrito y de que los resultados estén ordenados de mayor a menor según el número de distritos.", "gold_sql": "SELECT T2.STATE_NAME, COUNT(T3.DISTRICT_ID) FROM DIM_COUNTRY AS T1 JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T1.COUNTRY_NAME = 'India' GROUP BY T2.STATE_NAME HAVING COUNT(T3.DISTRICT_ID) > 0 ORDER BY COUNT(T3.DISTRICT_ID) DESC;", "predicted_sql": "SELECT dim_state.state_name, COUNT(dim_district.district_id) AS district_count\nFROM dim_country\nJOIN dim_state ON dim_state.country_id = dim_country.country_id\nJOIN dim_district ON dim_district.state_id = dim_state.state_id\nWHERE dim_country.country_name ILIKE 'India'\nGROUP BY dim_state.state_name\nHAVING COUNT(dim_district.district_id) > 0\nORDER BY district_count DESC;", "raw_output": "SELECT dim_state.state_name, COUNT(dim_district.district_id) AS district_count\nFROM dim_country\nJOIN dim_state ON dim_state.country_id = dim_country.country_id\nJOIN dim_district ON dim_district.state_id = dim_state.state_id\nWHERE dim_country.country_name ILIKE 'India'\nGROUP BY dim_state.state_name\nHAVING COUNT(dim_district.district_id) > 0\nORDER BY district_count DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a6f826b8", "question": "Enumere los nombres de las ULB, RLB o aldeas ubicadas en el estado de 'Andhra Pradesh' y en el distrito de 'Chittoor', agrupados y ordenados alfabéticamente por el nombre de la aldea.", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' AND T2.DISTRICT_NAME = 'Chittoor' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh'\n  AND dim_district.district_name ILIKE 'Chittoor'\nORDER BY dim_location.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh'\n  AND dim_district.district_name ILIKE 'Chittoor'\nORDER BY dim_location.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "c0d57f54", "question": "Enumera los nombres de los estados y el recuento total de IDs de distrito para cada estado del país 'India', incluyendo solo los estados que tienen más de cero distritos, y muestra los 5 estados principales con el mayor número de distritos.", "gold_sql": "SELECT T2.STATE_NAME, COUNT(T3.DISTRICT_ID) FROM DIM_COUNTRY AS T1 JOIN DIM_STATE AS T2 ON T1.COUNTRY_ID = T2.COUNTRY_ID JOIN DIM_DISTRICT AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T1.COUNTRY_NAME = 'India' GROUP BY T2.STATE_NAME HAVING COUNT(T3.DISTRICT_ID) > 0 ORDER BY COUNT(T3.DISTRICT_ID) DESC LIMIT 5", "predicted_sql": "SELECT dim_state.state_name, COUNT(dim_district.district_id) AS district_count\nFROM dim_country\nJOIN dim_state ON dim_state.country_id = dim_country.country_id\nJOIN dim_district ON dim_district.state_id = dim_state.state_id\nWHERE dim_country.country_name ILIKE 'India'\nGROUP BY dim_state.state_id, dim_state.state_name\nHAVING COUNT(dim_district.district_id) > 0\nORDER BY district_count DESC\nLIMIT 5;", "raw_output": "SELECT dim_state.state_name, COUNT(dim_district.district_id) AS district_count\nFROM dim_country\nJOIN dim_state ON dim_state.country_id = dim_country.country_id\nJOIN dim_district ON dim_district.state_id = dim_state.state_id\nWHERE dim_country.country_name ILIKE 'India'\nGROUP BY dim_state.state_id, dim_state.state_name\nHAVING COUNT(dim_district.district_id) > 0\nORDER BY district_count DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "bd14e998", "question": "Enumera los nombres de ULB, RLB y village ubicados en el state de 'Andhra Pradesh' y el district de 'Chittoor', agrupados y ordenados alfabéticamente por el nombre de village.", "gold_sql": "SELECT T3.ULB_RLB_VILLAGE_NAME FROM DIM_STATE AS T1 INNER JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID INNER JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' AND T2.DISTRICT_NAME = 'Chittoor' GROUP BY T3.ULB_RLB_VILLAGE_NAME ORDER BY T3.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh' AND dim_district.district_name ILIKE 'Chittoor'\nORDER BY dim_location.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh' AND dim_district.district_name ILIKE 'Chittoor'\nORDER BY dim_location.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5b6160c2", "question": "Enumera cada nombre de estado y la cantidad de identificadores de ubicación asociados a él, agrupados por el nombre del estado y ordenados de mayor a menor cantidad.", "gold_sql": "SELECT T1.STATE_NAME, COUNT(T3.LOCATION_ID) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID GROUP BY T1.STATE_NAME ORDER BY COUNT(T3.LOCATION_ID) DESC", "predicted_sql": "SELECT dim_state.state_name, COUNT(dim_location.location_id) AS location_count FROM dim_location JOIN dim_district ON dim_location.district_id = dim_district.district_id JOIN dim_state ON dim_district.state_id = dim_state.state_id GROUP BY dim_state.state_name ORDER BY location_count DESC;", "raw_output": "SELECT dim_state.state_name, COUNT(dim_location.location_id) AS location_count FROM dim_location JOIN dim_district ON dim_location.district_id = dim_district.district_id JOIN dim_state ON dim_district.state_id = dim_state.state_id GROUP BY dim_state.state_name ORDER BY location_count DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a63fc1b8", "question": "Para el estado de Andhra Pradesh, enumere los nombres de los distritos y el recuento de nombres de aldeas ULB/RLB distintos, agrupados por nombre del distrito y ordenados por el mayor número de aldeas, mostrando solo los 10 resultados principales.", "gold_sql": "SELECT T2.DISTRICT_NAME, COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' GROUP BY T2.DISTRICT_NAME ORDER BY COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) DESC LIMIT 10", "predicted_sql": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS distinct_village_count\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Andhra Pradesh'\nGROUP BY d.district_name\nORDER BY distinct_village_count DESC\nLIMIT 10;", "raw_output": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS distinct_village_count\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Andhra Pradesh'\nGROUP BY d.district_name\nORDER BY distinct_village_count DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "bc7a27e8", "question": "Enumere el nombre del estado, el nombre del distrito y el nombre de la aldea ULB/RLB para las ubicaciones en los estados de Assam, Andhra Pradesh o Bihar, excluyendo las que se encuentran en el distrito de Prakasam, agrupadas por estado, distrito y nombre de la aldea, y ordenadas alfabéticamente por aldea y distrito.", "gold_sql": "SELECT T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 INNER JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID INNER JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID WHERE T3.STATE_NAME IN ('Assam', 'Andhra Pradesh', 'Bihar') AND T2.DISTRICT_NAME NOT IN ('Prakasam') GROUP BY T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC, T2.DISTRICT_NAME ASC", "predicted_sql": "SELECT dim_state.state_name, dim_district.district_name, dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name IN ('Assam', 'Andhra Pradesh', 'Bihar')\n  AND dim_district.district_name != 'Prakasam'\nGROUP BY dim_state.state_name, dim_district.district_name, dim_location.ulb_rlb_village_name\nORDER BY dim_location.ulb_rlb_village_name, dim_district.district_name;", "raw_output": "SELECT dim_state.state_name, dim_district.district_name, dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nWHERE dim_state.state_name IN ('Assam', 'Andhra Pradesh', 'Bihar')\n  AND dim_district.district_name != 'Prakasam'\nGROUP BY dim_state.state_name, dim_district.district_name, dim_location.ulb_rlb_village_name\nORDER BY dim_location.ulb_rlb_village_name, dim_district.district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "8ec520f2", "question": "Para el estado de 'Bihar', enumera el nombre de cada distrito y el recuento total de nombres de aldeas ULB/RLB distintos, asegurando que solo se incluyan los distritos con más de cero aldeas, y muestra los 10 distritos principales con los recuentos más altos.", "gold_sql": "SELECT T2.DISTRICT_NAME, COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID JOIN DIM_LOCATION AS T3 ON T2.DISTRICT_ID = T3.DISTRICT_ID WHERE T1.STATE_NAME = 'Bihar' GROUP BY T2.DISTRICT_NAME HAVING COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) > 0 ORDER BY COUNT(DISTINCT T3.ULB_RLB_VILLAGE_NAME) DESC LIMIT 10", "predicted_sql": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS village_count\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Bihar'\nGROUP BY d.district_name\nHAVING COUNT(DISTINCT l.ulb_rlb_village_name) > 0\nORDER BY village_count DESC\nLIMIT 10;", "raw_output": "SELECT d.district_name, COUNT(DISTINCT l.ulb_rlb_village_name) AS village_count\nFROM dim_state s\nJOIN dim_district d ON s.state_id = d.state_id\nJOIN dim_location l ON d.district_id = l.district_id\nWHERE s.state_name ILIKE 'Bihar'\nGROUP BY d.district_name\nHAVING COUNT(DISTINCT l.ulb_rlb_village_name) > 0\nORDER BY village_count DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5d1894c5", "question": "Enumere el nombre del estado y el nombre del distrito para todos los distritos ubicados en los estados de 'Andhra Pradesh' o 'Assam', y ordene los resultados por el nombre del estado.", "gold_sql": "SELECT T1.STATE_NAME, T2.DISTRICT_NAME FROM DIM_STATE AS T1 JOIN DIM_DISTRICT AS T2 ON T1.STATE_ID = T2.STATE_ID WHERE T1.STATE_NAME = 'Andhra Pradesh' OR T1.STATE_NAME = 'Assam' ORDER BY T1.STATE_NAME", "predicted_sql": "SELECT dim_state.state_name, dim_district.district_name\nFROM dim_state\nJOIN dim_district ON dim_state.state_id = dim_district.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh' OR dim_state.state_name ILIKE 'Assam'\nORDER BY dim_state.state_name;", "raw_output": "SELECT dim_state.state_name, dim_district.district_name\nFROM dim_state\nJOIN dim_district ON dim_state.state_id = dim_district.state_id\nWHERE dim_state.state_name ILIKE 'Andhra Pradesh' OR dim_state.state_name ILIKE 'Assam'\nORDER BY dim_state.state_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5fca6279", "question": "Enumere el nombre del estado, el nombre del distrito y el nombre de la aldea ULB/RLB, agrupados por estado, distrito y nombre de la aldea, y ordenados alfabéticamente por el nombre de la aldea.", "gold_sql": "SELECT T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID GROUP BY T3.STATE_NAME, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME;", "predicted_sql": "SELECT DISTINCT dim_state.state_name, dim_district.district_name, dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nGROUP BY dim_state.state_name, dim_district.district_name, dim_location.ulb_rlb_village_name\nORDER BY dim_location.ulb_rlb_village_name ASC;", "raw_output": "SELECT DISTINCT dim_state.state_name, dim_district.district_name, dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nGROUP BY dim_state.state_name, dim_district.district_name, dim_location.ulb_rlb_village_name\nORDER BY dim_location.ulb_rlb_village_name ASC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "b353514c", "question": "Enumera el año del censo y el total estimado de acuicultura pesquera para cada año, asegurándote de que el total sea al menos 0.000, y ordena los resultados por el total estimado de acuicultura pesquera en orden descendente.", "gold_sql": "SELECT T2.CENSUS_YEAR, SUM(T1.EST_FISHING_AQUACULTURE) FROM FACT_PRIMARY_SECTOR AS T1 JOIN DIM_TIME AS T2 ON T1.TIME_ID = T2.TIME_ID JOIN DIM_LOCATION AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID GROUP BY T2.CENSUS_YEAR HAVING SUM(T1.EST_FISHING_AQUACULTURE) >= 0.000 ORDER BY SUM(T1.EST_FISHING_AQUACULTURE) DESC", "predicted_sql": "SELECT dim_time.census_year, SUM(fact_primary_sector.est_fishing_aquaculture) AS total_estimated_fishing_aquaculture FROM fact_primary_sector JOIN dim_time ON fact_primary_sector.time_id = dim_time.time_id GROUP BY dim_time.census_year HAVING SUM(fact_primary_sector.est_fishing_aquaculture) >= 0 ORDER BY total_estimated_fishing_aquaculture DESC;", "raw_output": "SELECT dim_time.census_year, SUM(fact_primary_sector.est_fishing_aquaculture) AS total_estimated_fishing_aquaculture FROM fact_primary_sector JOIN dim_time ON fact_primary_sector.time_id = dim_time.time_id GROUP BY dim_time.census_year HAVING SUM(fact_primary_sector.est_fishing_aquaculture) >= 0 ORDER BY total_estimated_fishing_aquaculture DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "18a2fb3f", "question": "Enumera el nombre del estado, el ID del país, el nombre del distrito y el nombre de la aldea ULB/RLB para todas las ubicaciones, ordenados por el nombre de la aldea y luego por el nombre del distrito.", "gold_sql": "SELECT T3.STATE_NAME, T3.COUNTRY_ID, T2.DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN DIM_DISTRICT AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID JOIN DIM_STATE AS T3 ON T2.STATE_ID = T3.STATE_ID ORDER BY T1.ULB_RLB_VILLAGE_NAME, T2.DISTRICT_NAME", "predicted_sql": "SELECT dim_state.state_name, dim_state.country_id, dim_district.district_name, dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nORDER BY dim_location.ulb_rlb_village_name, dim_district.district_name;", "raw_output": "SELECT dim_state.state_name, dim_state.country_id, dim_district.district_name, dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN dim_district ON dim_location.district_id = dim_district.district_id\nJOIN dim_state ON dim_district.state_id = dim_state.state_id\nORDER BY dim_location.ulb_rlb_village_name, dim_district.district_name;", "em": 1, "ex": 1, "error": null}
{"pair_id": "2d406297", "question": "Para el año censal 2013, enumere las categorías de sector donde el número total de establecimientos supera los 50,000, filtrando específicamente los registros donde el estado residencial o comercial sea 0.000, y ordene las categorías de sector resultantes en orden descendente.", "gold_sql": "SELECT T2.SECTOR_CATEGORY FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_SECTOR_CATEGORY AS T2 ON T1.SECTOR_ID = T2.SECTOR_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T1.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T2.SECTOR_CATEGORY HAVING SUM(T1.TOTAL_ESTABLISHMENTS) > 50000 ORDER BY T2.SECTOR_CATEGORY DESC", "predicted_sql": "SELECT dim_sector_category.sector_category\nFROM fact_establishment_totals\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nJOIN dim_sector_category ON fact_establishment_totals.sector_id = dim_sector_category.sector_id\nWHERE dim_time.census_year = 2013\n  AND fact_establishment_totals.est_residential_commercial = 0.000\nGROUP BY dim_sector_category.sector_category\nHAVING SUM(fact_establishment_totals.total_establishments) > 50000\nORDER BY dim_sector_category.sector_category DESC;", "raw_output": "SELECT dim_sector_category.sector_category\nFROM fact_establishment_totals\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nJOIN dim_sector_category ON fact_establishment_totals.sector_id = dim_sector_category.sector_id\nWHERE dim_time.census_year = 2013\n  AND fact_establishment_totals.est_residential_commercial = 0.000\nGROUP BY dim_sector_category.sector_category\nHAVING SUM(fact_establishment_totals.total_establishments) > 50000\nORDER BY dim_sector_category.sector_category DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "57faa295", "question": "Enumere los nombres de los subdistritos y los nombres de las aldeas ULB/RLB ubicadas en el distrito de 'Chittoor', excluyendo cualquier subdistrito que también se encuentre en el distrito de 'Prakasam', agrupados por subdistrito y nombre de aldea y ordenados alfabéticamente por subdistrito.", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME FROM DIM_DISTRICT AS T1 JOIN DIM_LOCATION AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID WHERE T1.DISTRICT_NAME = 'Chittoor' AND T2.SUB_DISTRICT_NAME NOT IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_DISTRICT AS T3 JOIN DIM_LOCATION AS T4 ON T3.DISTRICT_ID = T4.DISTRICT_ID WHERE T3.DISTRICT_NAME = 'Prakasam') GROUP BY T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME ORDER BY T2.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT l.sub_district_name, l.ulb_rlb_village_name\nFROM dim_location l\nJOIN dim_district d ON l.district_id = d.district_id\nWHERE d.district_name ILIKE 'Chittoor'\n  AND l.sub_district_name NOT IN (\n    SELECT DISTINCT l2.sub_district_name\n    FROM dim_location l2\n    JOIN dim_district d2 ON l2.district_id = d2.district_id\n    WHERE d2.district_name ILIKE 'Prakasam'\n  )\nGROUP BY l.sub_district_name, l.ulb_rlb_village_name\nORDER BY l.sub_district_name;", "raw_output": "SELECT l.sub_district_name, l.ulb_rlb_village_name\nFROM dim_location l\nJOIN dim_district d ON l.district_id = d.district_id\nWHERE d.district_name ILIKE 'Chittoor'\n  AND l.sub_district_name NOT IN (\n    SELECT DISTINCT l2.sub_district_name\n    FROM dim_location l2\n    JOIN dim_district d2 ON l2.district_id = d2.district_id\n    WHERE d2.district_name ILIKE 'Prakasam'\n  )\nGROUP BY l.sub_district_name, l.ulb_rlb_village_name\nORDER BY l.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "4a0348e2", "question": "Para el período de tiempo más reciente disponible, enumere las categorías del sector en las que el número total de establishments sea superior a 50,000, específicamente para los registros en los que el estado residencial o comercial sea 0.000, y ordene los resultados por el número total de establishments en orden descendente.", "gold_sql": "SELECT T2.SECTOR_CATEGORY FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_SECTOR_CATEGORY AS T2 ON T1.SECTOR_ID = T2.SECTOR_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID WHERE T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) AND T1.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T2.SECTOR_CATEGORY HAVING SUM(T1.TOTAL_ESTABLISHMENTS) > 50000 ORDER BY SUM(T1.TOTAL_ESTABLISHMENTS) DESC", "predicted_sql": "SELECT dsc.sector_category, SUM(fet.total_establishments) AS total_establishments_sum\nFROM fact_establishment_totals fet\nJOIN dim_time dt ON fet.time_id = dt.time_id\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fet.est_residential_commercial = 0.000\nGROUP BY dsc.sector_category\nHAVING SUM(fet.total_establishments) > 50000\nORDER BY total_establishments_sum DESC;", "raw_output": "SELECT dsc.sector_category, SUM(fet.total_establishments) AS total_establishments_sum\nFROM fact_establishment_totals fet\nJOIN dim_time dt ON fet.time_id = dt.time_id\nJOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fet.est_residential_commercial = 0.000\nGROUP BY dsc.sector_category\nHAVING SUM(fet.total_establishments) > 50000\nORDER BY total_establishments_sum DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 2. Pred count: 2."}
{"pair_id": "4ba18ccf", "question": "Enumera los nombres de los sub-district, ordenados alfabéticamente, que contengan al menos un sector categorizado como 'Rural' y al menos un sector categorizado como 'Urban'.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_SECTOR_CATEGORY AS T3 ON T2.SECTOR_ID = T3.SECTOR_ID GROUP BY T1.SUB_DISTRICT_NAME HAVING COUNT(DISTINCT CASE WHEN T3.SECTOR_CATEGORY = 'Rural' THEN T3.SECTOR_CATEGORY END) > 0 AND COUNT(DISTINCT CASE WHEN T3.SECTOR_CATEGORY = 'Urban' THEN T3.SECTOR_CATEGORY END) > 0 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nWHERE EXISTS (\n    SELECT 1\n    FROM fact_establishment_totals fet\n    JOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\n    WHERE fet.location_id = dl.location_id\n    AND dsc.sector_category ILIKE 'Rural'\n)\nAND EXISTS (\n    SELECT 1\n    FROM fact_establishment_totals fet\n    JOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\n    WHERE fet.location_id = dl.location_id\n    AND dsc.sector_category ILIKE 'Urban'\n)\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nWHERE EXISTS (\n    SELECT 1\n    FROM fact_establishment_totals fet\n    JOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\n    WHERE fet.location_id = dl.location_id\n    AND dsc.sector_category ILIKE 'Rural'\n)\nAND EXISTS (\n    SELECT 1\n    FROM fact_establishment_totals fet\n    JOIN dim_sector_category dsc ON fet.sector_id = dsc.sector_id\n    WHERE fet.location_id = dl.location_id\n    AND dsc.sector_category ILIKE 'Urban'\n)\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 339. Pred count: 3."}
{"pair_id": "fc696454", "question": "Enumere los nombres de los subdistritos para el año censal 2013 donde el número total de establecimientos sea mayor que cero y la cantidad de establecimientos residenciales-comerciales sea exactamente cero.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 AND SUM(T2.EST_RESIDENTIAL_COMMERCIAL) = 0.000", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0;", "em": 0, "ex": 1, "error": null}
{"pair_id": "cd33eb91", "question": "Para el año censal más reciente disponible, enumere el nombre de cada subdistrito y la suma total estimada de establecimientos comerciales residenciales, filtrando los registros donde el valor comercial residencial estimado sea 0.000, y ordene los resultados por la suma en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_RESIDENTIAL_COMMERCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) AND T2.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_RESIDENTIAL_COMMERCIAL) DESC", "predicted_sql": "SELECT dim_location.sub_district_name, SUM(fact_establishment_totals.est_residential_commercial) AS total_residential_commercial\nFROM fact_establishment_totals\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nJOIN dim_location ON fact_establishment_totals.location_id = dim_location.location_id\nWHERE dim_time.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fact_establishment_totals.est_residential_commercial != 0.000\nGROUP BY dim_location.sub_district_name\nORDER BY total_residential_commercial DESC;", "raw_output": "SELECT dim_location.sub_district_name, SUM(fact_establishment_totals.est_residential_commercial) AS total_residential_commercial\nFROM fact_establishment_totals\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nJOIN dim_location ON fact_establishment_totals.location_id = dim_location.location_id\nWHERE dim_time.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fact_establishment_totals.est_residential_commercial != 0.000\nGROUP BY dim_location.sub_district_name\nORDER BY total_residential_commercial DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 5346. Pred count: 0."}
{"pair_id": "a1c69c64", "question": "Enumere el nombre del subdistrito y el año del censo, junto con la suma del total de establecimientos y la suma de los establecimientos residenciales-comerciales, agrupados tanto por subdistrito como por año del censo, y ordenados cronológicamente por el año del censo.", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME, T3.CENSUS_YEAR, SUM(T1.TOTAL_ESTABLISHMENTS), SUM(T1.EST_RESIDENTIAL_COMMERCIAL) FROM FACT_ESTABLISHMENT_TOTALS AS T1 JOIN DIM_LOCATION AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID GROUP BY T2.SUB_DISTRICT_NAME, T3.CENSUS_YEAR ORDER BY T3.CENSUS_YEAR ASC", "predicted_sql": "SELECT dim_location.sub_district_name, dim_time.census_year, SUM(fact_establishment_totals.total_establishments) AS sum_total_establishments, SUM(fact_establishment_totals.est_residential_commercial) AS sum_residential_commercial FROM fact_establishment_totals JOIN dim_location ON fact_establishment_totals.location_id = dim_location.location_id JOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id GROUP BY dim_location.sub_district_name, dim_time.census_year ORDER BY dim_time.census_year;", "raw_output": "SELECT dim_location.sub_district_name, dim_time.census_year, SUM(fact_establishment_totals.total_establishments) AS sum_total_establishments, SUM(fact_establishment_totals.est_residential_commercial) AS sum_residential_commercial FROM fact_establishment_totals JOIN dim_location ON fact_establishment_totals.location_id = dim_location.location_id JOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id GROUP BY dim_location.sub_district_name, dim_time.census_year ORDER BY dim_time.census_year;", "em": 0, "ex": 1, "error": null}
{"pair_id": "f387f406", "question": "Para el año censal 2013, enumere el nombre de cada subdistrito y la suma total de establecimientos donde el estado residencial o comercial sea 0.000, incluyendo solo aquellos subdistritos con una suma total mayor que 0.000, y ordene los resultados por la suma de establecimientos en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.TOTAL_ESTABLISHMENTS) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 ORDER BY SUM(T2.TOTAL_ESTABLISHMENTS) DESC", "predicted_sql": "SELECT dim_location.sub_district_name, SUM(fact_establishment_totals.total_establishments) AS total_establishments_sum\nFROM fact_establishment_totals\nJOIN dim_location ON fact_establishment_totals.location_id = dim_location.location_id\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013 AND fact_establishment_totals.est_residential_commercial = 0.000\nGROUP BY dim_location.sub_district_name\nHAVING SUM(fact_establishment_totals.total_establishments) > 0.000\nORDER BY total_establishments_sum DESC;", "raw_output": "SELECT dim_location.sub_district_name, SUM(fact_establishment_totals.total_establishments) AS total_establishments_sum\nFROM fact_establishment_totals\nJOIN dim_location ON fact_establishment_totals.location_id = dim_location.location_id\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013 AND fact_establishment_totals.est_residential_commercial = 0.000\nGROUP BY dim_location.sub_district_name\nHAVING SUM(fact_establishment_totals.total_establishments) > 0.000\nORDER BY total_establishments_sum DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "e03e8e45", "question": "Para el año censal 2013, enumera los nombres de los subdistritos y la suma total estimada de establecimientos residenciales y comerciales, mostrando los 10 subdistritos con los totales más altos.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_RESIDENTIAL_COMMERCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_RESIDENTIAL_COMMERCIAL) DESC LIMIT 10", "predicted_sql": "SELECT dim_location.sub_district_name, SUM(fact_establishment_totals.est_residential_commercial) AS total_residential_commercial\nFROM dim_location\nJOIN fact_establishment_totals ON dim_location.location_id = fact_establishment_totals.location_id\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\nGROUP BY dim_location.sub_district_name\nORDER BY total_residential_commercial DESC\nLIMIT 10;", "raw_output": "SELECT dim_location.sub_district_name, SUM(fact_establishment_totals.est_residential_commercial) AS total_residential_commercial\nFROM dim_location\nJOIN fact_establishment_totals ON dim_location.location_id = fact_establishment_totals.location_id\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\nGROUP BY dim_location.sub_district_name\nORDER BY total_residential_commercial DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "244da596", "question": "Enumere los nombres de las aldeas ULB RLB, ordenados alfabéticamente, para las ubicaciones donde el número de establecimientos de silvicultura y tala es mayor que cero o el número de establecimientos residenciales y comerciales es mayor que cero.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_PRIMARY_SECTOR AS T3 ON T2.LOCATION_ID = T3.LOCATION_ID WHERE T3.EST_FORESTRY_LOGGING > 0.000 OR T2.EST_RESIDENTIAL_COMMERCIAL > 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id AND fps.time_id = fet.time_id AND fps.sector_id = fet.sector_id\nWHERE fps.est_forestry_logging > 0 OR fet.est_residential_commercial > 0\nORDER BY dl.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_primary_sector fps ON dl.location_id = fps.location_id\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id AND fps.time_id = fet.time_id AND fps.sector_id = fet.sector_id\nWHERE fps.est_forestry_logging > 0 OR fet.est_residential_commercial > 0\nORDER BY dl.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "77a4e2c5", "question": "Enumere los nombres de los subdistritos, ordenados alfabéticamente, que tuvieron un número total de establecimientos mayor que cero pero cero establecimientos residenciales o comerciales durante el año del censo 2013.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.TOTAL_ESTABLISHMENTS) > 0.000 AND SUM(T2.EST_RESIDENTIAL_COMMERCIAL) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_establishment_totals fet ON dl.location_id = fet.location_id\nJOIN dim_time dt ON fet.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fet.total_establishments > 0\n  AND fet.est_residential_commercial = 0\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "db9784c3", "question": "Enumere los nombres de las ULB, RLB o aldeas, ordenados alfabéticamente, que tengan una suma total de establecimientos ganaderos mayor que cero, filtrando específicamente las ubicaciones donde los recuentos individuales de establecimientos ganaderos sean mayores que cero y el recuento de establecimientos residenciales-comerciales sea exactamente cero.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_PRIMARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_ESTABLISHMENT_TOTALS AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID WHERE T2.EST_LIVESTOCK > 0.000 AND T3.EST_RESIDENTIAL_COMMERCIAL = 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_LIVESTOCK) > 0.000 ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN fact_primary_sector ON dim_location.location_id = fact_primary_sector.location_id\nJOIN fact_establishment_totals ON fact_primary_sector.location_id = fact_establishment_totals.location_id\n    AND fact_primary_sector.time_id = fact_establishment_totals.time_id\n    AND fact_primary_sector.sector_id = fact_establishment_totals.sector_id\nWHERE fact_primary_sector.est_livestock > 0\n    AND fact_establishment_totals.est_residential_commercial = 0\nGROUP BY dim_location.location_id, dim_location.ulb_rlb_village_name\nHAVING SUM(fact_primary_sector.est_livestock) > 0\nORDER BY dim_location.ulb_rlb_village_name;", "raw_output": "SELECT dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN fact_primary_sector ON dim_location.location_id = fact_primary_sector.location_id\nJOIN fact_establishment_totals ON fact_primary_sector.location_id = fact_establishment_totals.location_id\n    AND fact_primary_sector.time_id = fact_establishment_totals.time_id\n    AND fact_primary_sector.sector_id = fact_establishment_totals.sector_id\nWHERE fact_primary_sector.est_livestock > 0\n    AND fact_establishment_totals.est_residential_commercial = 0\nGROUP BY dim_location.location_id, dim_location.ulb_rlb_village_name\nHAVING SUM(fact_primary_sector.est_livestock) > 0\nORDER BY dim_location.ulb_rlb_village_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 9618. Pred count: 9991."}
{"pair_id": "9a4faed8", "question": "Para el año censal 2013, enumere los nombres de los subdistritos y los nombres de las aldeas ULB/RLB para las ubicaciones donde el recuento estimado de ganado sea mayor que cero, excluyendo cualquier ubicación que también haya tenido un recuento estimado residencial-comercial mayor que cero en 2013, agrupados por sus nombres de subdistrito y de aldea y ordenados alfabéticamente por subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_PRIMARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_LIVESTOCK > 0.000 AND T1.LOCATION_ID NOT IN ( SELECT T4.LOCATION_ID FROM FACT_ESTABLISHMENT_TOTALS AS T4 JOIN DIM_TIME AS T5 ON T4.TIME_ID = T5.TIME_ID WHERE T5.CENSUS_YEAR = '2013' AND T4.EST_RESIDENTIAL_COMMERCIAL > 0.000 ) GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING COUNT(T2.FACT_PRIMARY_SECTOR_ID) >= 1 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dim_location.sub_district_name, dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN fact_primary_sector ON dim_location.location_id = fact_primary_sector.location_id\nJOIN dim_time ON fact_primary_sector.time_id = dim_time.time_id\nLEFT JOIN fact_establishment_totals ON dim_location.location_id = fact_establishment_totals.location_id AND dim_time.time_id = fact_establishment_totals.time_id\nWHERE dim_time.census_year = 2013\n  AND fact_primary_sector.est_livestock > 0\n  AND (fact_establishment_totals.est_residential_commercial = 0 OR fact_establishment_totals.est_residential_commercial IS NULL OR fact_establishment_totals.est_residential_commercial <= 0)\nGROUP BY dim_location.sub_district_name, dim_location.ulb_rlb_village_name\nORDER BY dim_location.sub_district_name;", "raw_output": "SELECT dim_location.sub_district_name, dim_location.ulb_rlb_village_name\nFROM dim_location\nJOIN fact_primary_sector ON dim_location.location_id = fact_primary_sector.location_id\nJOIN dim_time ON fact_primary_sector.time_id = dim_time.time_id\nLEFT JOIN fact_establishment_totals ON dim_location.location_id = fact_establishment_totals.location_id AND dim_time.time_id = fact_establishment_totals.time_id\nWHERE dim_time.census_year = 2013\n  AND fact_primary_sector.est_livestock > 0\n  AND (fact_establishment_totals.est_residential_commercial = 0 OR fact_establishment_totals.est_residential_commercial IS NULL OR fact_establishment_totals.est_residential_commercial <= 0)\nGROUP BY dim_location.sub_district_name, dim_location.ulb_rlb_village_name\nORDER BY dim_location.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "63892277", "question": "Enumere los nombres de los subdistritos para el año censal '2013' donde el recuento de establecimientos residenciales-comerciales sea 0.000 o mayor, asegurándose de que estos subdistritos también aparezcan en el conjunto de subdistritos que cumplen esos mismos criterios para ese año, y muestre los resultados en orden ascendente por nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T2.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T3.CENSUS_YEAR = '2013' AND T1.SUB_DISTRICT_NAME IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T4 JOIN FACT_ESTABLISHMENT_TOTALS AS T5 ON T4.LOCATION_ID = T5.LOCATION_ID JOIN DIM_TIME AS T6 ON T5.TIME_ID = T6.TIME_ID WHERE T5.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T6.CENSUS_YEAR = '2013') GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dim_location.sub_district_name\nFROM dim_location\nJOIN fact_establishment_totals ON dim_location.location_id = fact_establishment_totals.location_id\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\n  AND fact_establishment_totals.est_residential_commercial >= 0.000\nORDER BY dim_location.sub_district_name ASC;", "raw_output": "SELECT DISTINCT dim_location.sub_district_name\nFROM dim_location\nJOIN fact_establishment_totals ON dim_location.location_id = fact_establishment_totals.location_id\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\n  AND fact_establishment_totals.est_residential_commercial >= 0.000\nORDER BY dim_location.sub_district_name ASC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "803f28ef", "question": "Para el año censal 2013, enumere los nombres de los subdistritos, ordenados alfabéticamente, donde el total de establecimientos comerciales residenciales sea mayor que 0 o el nombre de la aldea ULB RLB sea 'Pilpilow'.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND (T2.EST_RESIDENTIAL_COMMERCIAL > 0.000 OR T1.ULB_RLB_VILLAGE_NAME = 'Pilpilow') GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dim_location.sub_district_name\nFROM fact_establishment_totals\nJOIN dim_location ON fact_establishment_totals.location_id = dim_location.location_id\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\n  AND (fact_establishment_totals.est_residential_commercial > 0 OR dim_location.ulb_rlb_village_name ILIKE 'Pilpilow')\nORDER BY dim_location.sub_district_name;", "raw_output": "SELECT DISTINCT dim_location.sub_district_name\nFROM fact_establishment_totals\nJOIN dim_location ON fact_establishment_totals.location_id = dim_location.location_id\nJOIN dim_time ON fact_establishment_totals.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\n  AND (fact_establishment_totals.est_residential_commercial > 0 OR dim_location.ulb_rlb_village_name ILIKE 'Pilpilow')\nORDER BY dim_location.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "3f75c9fb", "question": "Para el año censal 2013, enumera el nombre de cada subdistrito y la suma de sus establecimientos de manufactura y construcción, agrupados y ordenados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dim_location.sub_district_name, SUM(fact_secondary_sector.est_manufacturing + fact_secondary_sector.est_construction) AS total_manufacturing_construction\nFROM fact_secondary_sector\nJOIN dim_location ON fact_secondary_sector.location_id = dim_location.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\nGROUP BY dim_location.sub_district_name\nORDER BY dim_location.sub_district_name;", "raw_output": "SELECT dim_location.sub_district_name, SUM(fact_secondary_sector.est_manufacturing + fact_secondary_sector.est_construction) AS total_manufacturing_construction\nFROM fact_secondary_sector\nJOIN dim_location ON fact_secondary_sector.location_id = dim_location.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\nGROUP BY dim_location.sub_district_name\nORDER BY dim_location.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "7ead6ddc", "question": "Para el período de tiempo más reciente disponible, enumere los nombres de las ULB, RLB o aldeas donde el valor total estimado de la manufactura sea superior a 50.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_MANUFACTURING) > 50", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM fact_secondary_sector fss\nJOIN dim_location dl ON fss.location_id = dl.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE fss.est_manufacturing > 50\n  AND dt.census_year = (SELECT MAX(census_year) FROM dim_time);", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM fact_secondary_sector fss\nJOIN dim_location dl ON fss.location_id = dl.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE fss.est_manufacturing > 50\n  AND dt.census_year = (SELECT MAX(census_year) FROM dim_time);", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 790. Pred count: 773."}
{"pair_id": "f2bb09f0", "question": "Para el año censal 2013, enumere los nombres de los subdistritos y los nombres de las aldeas ULB/RLB donde el número de establecimientos de pesca y acuicultura sea 0 o mayor y el número de establecimientos comerciales residenciales sea 0 o mayor, asegurándose de que solo se incluyan las ubicaciones con al menos un registro en los totales de establecimientos, y ordene los resultados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_ESTABLISHMENT_TOTALS AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_PRIMARY_SECTOR AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID AND T2.TIME_ID = T3.TIME_ID JOIN DIM_TIME AS T4 ON T2.TIME_ID = T4.TIME_ID WHERE T3.EST_FISHING_AQUACULTURE >= 0.000 AND T2.EST_RESIDENTIAL_COMMERCIAL >= 0.000 AND T4.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING COUNT(T2.FACT_ESTABLISHMENT_TOTALS_ID) >= 1 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dim_location.sub_district_name, dim_location.ulb_rlb_village_name FROM dim_location INNER JOIN fact_primary_sector ON dim_location.location_id = fact_primary_sector.location_id INNER JOIN fact_establishment_totals ON fact_primary_sector.location_id = fact_establishment_totals.location_id AND fact_primary_sector.time_id = fact_establishment_totals.time_id AND fact_primary_sector.sector_id = fact_establishment_totals.sector_id INNER JOIN dim_time ON fact_primary_sector.time_id = dim_time.time_id WHERE dim_time.census_year = 2013 GROUP BY dim_location.location_id, dim_location.sub_district_name, dim_location.ulb_rlb_village_name HAVING SUM(fact_primary_sector.est_fishing_aquaculture) >= 0 AND SUM(fact_establishment_totals.est_residential_commercial) >= 0 ORDER BY dim_location.sub_district_name;", "raw_output": "SELECT dim_location.sub_district_name, dim_location.ulb_rlb_village_name FROM dim_location INNER JOIN fact_primary_sector ON dim_location.location_id = fact_primary_sector.location_id INNER JOIN fact_establishment_totals ON fact_primary_sector.location_id = fact_establishment_totals.location_id AND fact_primary_sector.time_id = fact_establishment_totals.time_id AND fact_primary_sector.sector_id = fact_establishment_totals.sector_id INNER JOIN dim_time ON fact_primary_sector.time_id = dim_time.time_id WHERE dim_time.census_year = 2013 GROUP BY dim_location.location_id, dim_location.sub_district_name, dim_location.ulb_rlb_village_name HAVING SUM(fact_primary_sector.est_fishing_aquaculture) >= 0 AND SUM(fact_establishment_totals.est_residential_commercial) >= 0 ORDER BY dim_location.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 29896. Pred count: 29960."}
{"pair_id": "cc274a6c", "question": "Para el año censal más reciente disponible, enumera el nombre de cada subdistrito y la suma total de establecimientos de manufactura y construcción, incluyendo solo aquellos subdistritos donde esta suma combinada sea mayor que cero, y ordena los resultados por la suma total en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) > 0.000 ORDER BY SUM(T2.EST_MANUFACTURING + T2.EST_CONSTRUCTION) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing + fss.est_construction) AS total_sum\nFROM fact_secondary_sector fss\nJOIN dim_location dl ON fss.location_id = dl.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nHAVING SUM(fss.est_manufacturing + fss.est_construction) > 0\nORDER BY total_sum DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing + fss.est_construction) AS total_sum\nFROM fact_secondary_sector fss\nJOIN dim_location dl ON fss.location_id = dl.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nHAVING SUM(fss.est_manufacturing + fss.est_construction) > 0\nORDER BY total_sum DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "3b6a0b2a", "question": "Para el período de tiempo más reciente disponible, enumera los nombres de las ULB, RLB o aldeas que tengan un valor total estimado de manufactura superior a 50, y muestra estos nombres en orden descendente según su valor total estimado de manufactura.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_MANUFACTURING) > 50 ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dl.ulb_rlb_village_name, fss.est_manufacturing\nFROM fact_secondary_sector fss\nJOIN dim_location dl ON fss.location_id = dl.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fss.est_manufacturing > 50\nORDER BY fss.est_manufacturing DESC;", "raw_output": "SELECT dl.ulb_rlb_village_name, fss.est_manufacturing\nFROM fact_secondary_sector fss\nJOIN dim_location dl ON fss.location_id = dl.location_id\nJOIN dim_time dt ON fss.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\n  AND fss.est_manufacturing > 50\nORDER BY fss.est_manufacturing DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 790. Pred count: 779."}
{"pair_id": "5acff517", "question": "Para el año censal 2013, enumere el nombre de cada subdistrito y el valor total estimado de manufactura, ordenados por el valor total estimado de manufactura en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dim_location.sub_district_name, SUM(fact_secondary_sector.est_manufacturing) AS total_manufacturing FROM fact_secondary_sector JOIN dim_location ON fact_secondary_sector.location_id = dim_location.location_id JOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id WHERE dim_time.census_year = 2013 GROUP BY dim_location.sub_district_name ORDER BY total_manufacturing DESC;", "raw_output": "SELECT dim_location.sub_district_name, SUM(fact_secondary_sector.est_manufacturing) AS total_manufacturing FROM fact_secondary_sector JOIN dim_location ON fact_secondary_sector.location_id = dim_location.location_id JOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id WHERE dim_time.census_year = 2013 GROUP BY dim_location.sub_district_name ORDER BY total_manufacturing DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "34765acb", "question": "Para el año censal más reciente disponible, enumere el nombre de cada subdistrito y el valor manufacturero total estimado, ordenados de mayor a menor valor manufacturero total.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dim_location.sub_district_name, SUM(fact_secondary_sector.est_manufacturing) AS total_manufacturing_value\nFROM dim_location\nJOIN fact_secondary_sector ON dim_location.location_id = fact_secondary_sector.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dim_location.sub_district_name\nORDER BY total_manufacturing_value DESC;", "raw_output": "SELECT dim_location.sub_district_name, SUM(fact_secondary_sector.est_manufacturing) AS total_manufacturing_value\nFROM dim_location\nJOIN fact_secondary_sector ON dim_location.location_id = fact_secondary_sector.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dim_location.sub_district_name\nORDER BY total_manufacturing_value DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "cf374eef", "question": "Enumere los nombres de los subdistritos para el año censal 2013 donde el total estimado de manufactura sea mayor que 0 y el total estimado de construcción sea exactamente 0, agrupados y ordenados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING) > 0.000 AND SUM(T2.EST_CONSTRUCTION) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dim_location.sub_district_name\nFROM dim_location\nJOIN fact_secondary_sector ON dim_location.location_id = fact_secondary_sector.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\n  AND fact_secondary_sector.est_manufacturing > 0\n  AND fact_secondary_sector.est_construction = 0\nORDER BY dim_location.sub_district_name ASC;", "raw_output": "SELECT DISTINCT dim_location.sub_district_name\nFROM dim_location\nJOIN fact_secondary_sector ON dim_location.location_id = fact_secondary_sector.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\n  AND fact_secondary_sector.est_manufacturing > 0\n  AND fact_secondary_sector.est_construction = 0\nORDER BY dim_location.sub_district_name ASC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 3540. Pred count: 4355."}
{"pair_id": "49d857a2", "question": "Enumera los nombres de los subdistritos para el año censal '2013' donde el total estimado de manufactura sea mayor que 500 o el total estimado de construcción sea mayor que 200, y ordena los resultados alfabéticamente por nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING) > 500 UNION SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_CONSTRUCTION) > 200 ORDER BY SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dim_location.sub_district_name\nFROM dim_location\nJOIN fact_secondary_sector ON dim_location.location_id = fact_secondary_sector.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\n  AND (fact_secondary_sector.est_manufacturing > 500 OR fact_secondary_sector.est_construction > 200)\nORDER BY dim_location.sub_district_name;", "raw_output": "SELECT dim_location.sub_district_name\nFROM dim_location\nJOIN fact_secondary_sector ON dim_location.location_id = fact_secondary_sector.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\n  AND (fact_secondary_sector.est_manufacturing > 500 OR fact_secondary_sector.est_construction > 200)\nORDER BY dim_location.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 64. Pred count: 47."}
{"pair_id": "162deae6", "question": "Para el año censal 2013, enumere los nombres de los subdistritos y los nombres de las ULB, RLB o aldeas donde el total estimado de manufactura en el sector secundario sea superior a 50, ordenados de mayor a menor según el total estimado de manufactura.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_MANUFACTURING) > 50 ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dim_location.sub_district_name, dim_location.ulb_rlb_village_name\nFROM fact_secondary_sector\nJOIN dim_location ON fact_secondary_sector.location_id = dim_location.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013 AND fact_secondary_sector.est_manufacturing > 50\nORDER BY fact_secondary_sector.est_manufacturing DESC;", "raw_output": "SELECT dim_location.sub_district_name, dim_location.ulb_rlb_village_name\nFROM fact_secondary_sector\nJOIN dim_location ON fact_secondary_sector.location_id = dim_location.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013 AND fact_secondary_sector.est_manufacturing > 50\nORDER BY fact_secondary_sector.est_manufacturing DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 774. Pred count: 779."}
{"pair_id": "6ad0ce72", "question": "Enumere los nombres de los subdistritos para el año censal 2013 en los que el número de establecimientos manufactureros sea mayor que 500 o el número de establecimientos de construcción sea mayor que 200, agrupados por nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND (T2.EST_MANUFACTURING > 500 OR T2.EST_CONSTRUCTION > 200) GROUP BY T1.SUB_DISTRICT_NAME", "predicted_sql": "SELECT dim_location.sub_district_name\nFROM fact_secondary_sector\nJOIN dim_location ON fact_secondary_sector.location_id = dim_location.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\n  AND (fact_secondary_sector.est_manufacturing > 500 OR fact_secondary_sector.est_construction > 200)\nGROUP BY dim_location.sub_district_name;", "raw_output": "SELECT dim_location.sub_district_name\nFROM fact_secondary_sector\nJOIN dim_location ON fact_secondary_sector.location_id = dim_location.location_id\nJOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\n  AND (fact_secondary_sector.est_manufacturing > 500 OR fact_secondary_sector.est_construction > 200)\nGROUP BY dim_location.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "936c601a", "question": "Para el año censal 2013, enumera el nombre de cada subdistrito junto con los valores totales estimados de manufactura y de construcción, agrupados y ordenados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING), SUM(T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing) AS total_manufacturing, SUM(fss.est_construction) AS total_construction FROM dim_location dl JOIN fact_secondary_sector fss ON dl.location_id = fss.location_id JOIN dim_time dt ON fss.time_id = dt.time_id WHERE dt.census_year = 2013 GROUP BY dl.sub_district_name ORDER BY dl.sub_district_name ASC;", "raw_output": "SELECT dl.sub_district_name, SUM(fss.est_manufacturing) AS total_manufacturing, SUM(fss.est_construction) AS total_construction FROM dim_location dl JOIN fact_secondary_sector fss ON dl.location_id = fss.location_id JOIN dim_time dt ON fss.time_id = dt.time_id WHERE dt.census_year = 2013 GROUP BY dl.sub_district_name ORDER BY dl.sub_district_name ASC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "09a75ff6", "question": "Para el año censal 2013, enumere el nombre de cada subdistrito junto con los valores totales estimados de manufactura y de construcción, asegurándose de que el total estimado de manufactura sea al menos 0.000, y ordene los resultados por el total estimado de manufactura en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_MANUFACTURING), SUM(T2.EST_CONSTRUCTION) FROM DIM_LOCATION AS T1 JOIN FACT_SECONDARY_SECTOR AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_MANUFACTURING) >= 0.000 ORDER BY SUM(T2.EST_MANUFACTURING) DESC", "predicted_sql": "SELECT dim_location.sub_district_name, SUM(fact_secondary_sector.est_manufacturing) AS total_manufacturing, SUM(fact_secondary_sector.est_construction) AS total_construction FROM dim_location JOIN fact_secondary_sector ON dim_location.location_id = fact_secondary_sector.location_id JOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id WHERE dim_time.census_year = 2013 GROUP BY dim_location.sub_district_name HAVING SUM(fact_secondary_sector.est_manufacturing) >= 0.000 ORDER BY total_manufacturing DESC;", "raw_output": "SELECT dim_location.sub_district_name, SUM(fact_secondary_sector.est_manufacturing) AS total_manufacturing, SUM(fact_secondary_sector.est_construction) AS total_construction FROM dim_location JOIN fact_secondary_sector ON dim_location.location_id = fact_secondary_sector.location_id JOIN dim_time ON fact_secondary_sector.time_id = dim_time.time_id WHERE dim_time.census_year = 2013 GROUP BY dim_location.sub_district_name HAVING SUM(fact_secondary_sector.est_manufacturing) >= 0.000 ORDER BY total_manufacturing DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "ff9ec42b", "question": "Para el año censal 2013, enumere los nombres de los subdistritos y los nombres de las aldeas ULB/RLB donde los gastos totales estimados de alojamiento y alimentación sean al menos 0.000, y ordene los resultados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_ACCOMMODATION_FOOD) >= 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dim_location.sub_district_name, dim_location.ulb_rlb_village_name\nFROM fact_transport_hospitality\nJOIN dim_location ON fact_transport_hospitality.location_id = dim_location.location_id\nJOIN dim_time ON fact_transport_hospitality.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013 AND fact_transport_hospitality.est_accommodation_food >= 0\nORDER BY dim_location.sub_district_name;", "raw_output": "SELECT dim_location.sub_district_name, dim_location.ulb_rlb_village_name\nFROM fact_transport_hospitality\nJOIN dim_location ON fact_transport_hospitality.location_id = dim_location.location_id\nJOIN dim_time ON fact_transport_hospitality.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013 AND fact_transport_hospitality.est_accommodation_food >= 0\nORDER BY dim_location.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 29896. Pred count: 29998."}
{"pair_id": "0fe8bc91", "question": "Para el año censal 2013, enumera el nombre de cada subdistrito junto con los costos totales estimados de transporte y almacenamiento y los costos totales estimados de alojamiento y alimentación, agrupados y ordenados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_TRANSPORT_STORAGE), SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT\n    dl.sub_district_name,\n    SUM(fth.est_transport_storage) AS total_transport_storage_costs,\n    SUM(fth.est_accommodation_food) AS total_accommodation_food_costs\nFROM fact_transport_hospitality fth\nJOIN dim_location dl ON fth.location_id = dl.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY dl.sub_district_name;", "raw_output": "SELECT\n    dl.sub_district_name,\n    SUM(fth.est_transport_storage) AS total_transport_storage_costs,\n    SUM(fth.est_accommodation_food) AS total_accommodation_food_costs\nFROM fact_transport_hospitality fth\nJOIN dim_location dl ON fth.location_id = dl.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "e1ccb964", "question": "Para el año censal 2013, enumera el nombre de cada subdistrito y el costo total estimado de alojamiento y alimentación, ordenados por los costos totales en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_ACCOMMODATION_FOOD) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fth.est_accommodation_food) AS total_cost\nFROM fact_transport_hospitality fth\nJOIN dim_location dl ON fth.location_id = dl.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_cost DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fth.est_accommodation_food) AS total_cost\nFROM fact_transport_hospitality fth\nJOIN dim_location dl ON fth.location_id = dl.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_cost DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "579e0a14", "question": "Enumere los nombres de los subdistritos del año censal 2013 que tenían un valor total estimado de transporte y almacenamiento mayor que cero, excluyendo específicamente cualquier subdistrito que también haya reportado un valor estimado de alojamiento y comida mayor que cero durante ese mismo año, y ordene los resultados alfabéticamente por nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_TRANSPORT_STORAGE) > 0.000 AND T1.SUB_DISTRICT_NAME NOT IN (SELECT T4.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T4 JOIN FACT_TRANSPORT_HOSPITALITY AS T5 ON T4.LOCATION_ID = T5.LOCATION_ID JOIN DIM_TIME AS T6 ON T5.TIME_ID = T6.TIME_ID WHERE T6.CENSUS_YEAR = '2013' AND T5.EST_ACCOMMODATION_FOOD > 0.000) ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fth.est_transport_storage > 0\n  AND fth.est_accommodation_food <= 0\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fth.est_transport_storage > 0\n  AND fth.est_accommodation_food <= 0\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 533. Pred count: 1201."}
{"pair_id": "e7fc6264", "question": "Para el año censal 2013, enumera los nombres de los subdistritos y los costos totales estimados de alojamiento y alimentación de los 10 subdistritos con los costos totales más altos.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_ACCOMMODATION_FOOD) DESC LIMIT 10", "predicted_sql": "SELECT dim_location.sub_district_name, SUM(fact_transport_hospitality.est_accommodation_food) AS total_cost\nFROM fact_transport_hospitality\nJOIN dim_time ON fact_transport_hospitality.time_id = dim_time.time_id\nJOIN dim_location ON fact_transport_hospitality.location_id = dim_location.location_id\nWHERE dim_time.census_year = 2013\nGROUP BY dim_location.sub_district_name\nORDER BY total_cost DESC\nLIMIT 10;", "raw_output": "SELECT dim_location.sub_district_name, SUM(fact_transport_hospitality.est_accommodation_food) AS total_cost\nFROM fact_transport_hospitality\nJOIN dim_time ON fact_transport_hospitality.time_id = dim_time.time_id\nJOIN dim_location ON fact_transport_hospitality.location_id = dim_location.location_id\nWHERE dim_time.census_year = 2013\nGROUP BY dim_location.sub_district_name\nORDER BY total_cost DESC\nLIMIT 10;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a29de23a", "question": "Enumere los nombres de los subdistritos en orden alfabético para el año del censo 2013 donde los valores estimados de almacenamiento de transporte y de alojamiento y comida sean ambos mayores que cero.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_TRANSPORT_STORAGE > 0.000 AND T2.EST_ACCOMMODATION_FOOD > 0.000 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fth.est_transport_storage > 0\n  AND fth.est_accommodation_food > 0\nORDER BY dl.sub_district_name ASC;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_transport_hospitality fth ON dl.location_id = fth.location_id\nJOIN dim_time dt ON fth.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fth.est_transport_storage > 0\n  AND fth.est_accommodation_food > 0\nORDER BY dl.sub_district_name ASC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "f5e1ad47", "question": "Para el año censal más reciente disponible, enumere los nombres de los subdistritos junto con los costos totales estimados de transporte y almacenamiento y los costos totales estimados de alojamiento y alimentación, agrupados por subdistrito y ordenados por los costos totales estimados de transporte y almacenamiento en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_TRANSPORT_STORAGE), SUM(T2.EST_ACCOMMODATION_FOOD) FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_TRANSPORT_STORAGE) DESC", "predicted_sql": "SELECT dim_location.sub_district_name,\n       SUM(fact_transport_hospitality.est_transport_storage) AS total_transport_storage,\n       SUM(fact_transport_hospitality.est_accommodation_food) AS total_accommodation_food\nFROM fact_transport_hospitality\nJOIN dim_location ON fact_transport_hospitality.location_id = dim_location.location_id\nJOIN dim_time ON fact_transport_hospitality.time_id = dim_time.time_id\nWHERE dim_time.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dim_location.sub_district_name\nORDER BY total_transport_storage DESC;", "raw_output": "SELECT dim_location.sub_district_name,\n       SUM(fact_transport_hospitality.est_transport_storage) AS total_transport_storage,\n       SUM(fact_transport_hospitality.est_accommodation_food) AS total_accommodation_food\nFROM fact_transport_hospitality\nJOIN dim_location ON fact_transport_hospitality.location_id = dim_location.location_id\nJOIN dim_time ON fact_transport_hospitality.time_id = dim_time.time_id\nWHERE dim_time.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dim_location.sub_district_name\nORDER BY total_transport_storage DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a7c2466f", "question": "Enumere los nombres de las ULB, RLB o aldeas donde el valor estimado de transporte y almacenamiento sea mayor que 50 o el valor estimado de alojamiento y servicios de comida sea mayor que 50, ordenados alfabéticamente por el nombre de la aldea.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.EST_TRANSPORT_STORAGE > 50 OR T2.EST_ACCOMMODATION_FOOD > 50 ORDER BY T1.ULB_RLB_VILLAGE_NAME", "predicted_sql": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM fact_transport_hospitality\nJOIN dim_location ON fact_transport_hospitality.location_id = dim_location.location_id\nWHERE fact_transport_hospitality.est_transport_storage > 50 OR fact_transport_hospitality.est_accommodation_food > 50\nORDER BY dim_location.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM fact_transport_hospitality\nJOIN dim_location ON fact_transport_hospitality.location_id = dim_location.location_id\nWHERE fact_transport_hospitality.est_transport_storage > 50 OR fact_transport_hospitality.est_accommodation_food > 50\nORDER BY dim_location.ulb_rlb_village_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 45. Pred count: 44."}
{"pair_id": "f89a1184", "question": "Enumere el nombre del subdistrito y el año del censo, junto con la suma total estimada de educación y los valores estimados de salud humana y sociales, para cada subdistrito y año del censo en los que esa suma sea al menos 0.000, ordenados por el año del censo y la suma total en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T2.CENSUS_YEAR, SUM(T3.EST_EDUCATION + T3.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 INNER JOIN FACT_EDUCATION_HEALTH AS T3 ON T1.LOCATION_ID = T3.LOCATION_ID INNER JOIN DIM_TIME AS T2 ON T3.TIME_ID = T2.TIME_ID GROUP BY T1.SUB_DISTRICT_NAME, T2.CENSUS_YEAR HAVING SUM(T3.EST_EDUCATION + T3.EST_HUMAN_HEALTH_SOCIAL) >= 0.000 ORDER BY T2.CENSUS_YEAR DESC, SUM(T3.EST_EDUCATION + T3.EST_HUMAN_HEALTH_SOCIAL) DESC", "predicted_sql": "SELECT dim_location.sub_district_name, dim_time.census_year, SUM(fact_education_health.est_education + fact_education_health.est_human_health_social) AS total_sum FROM fact_education_health JOIN dim_location ON fact_education_health.location_id = dim_location.location_id JOIN dim_time ON fact_education_health.time_id = dim_time.time_id GROUP BY dim_location.sub_district_name, dim_time.census_year HAVING SUM(fact_education_health.est_education + fact_education_health.est_human_health_social) >= 0.000 ORDER BY dim_time.census_year, total_sum DESC;", "raw_output": "SELECT dim_location.sub_district_name, dim_time.census_year, SUM(fact_education_health.est_education + fact_education_health.est_human_health_social) AS total_sum FROM fact_education_health JOIN dim_location ON fact_education_health.location_id = dim_location.location_id JOIN dim_time ON fact_education_health.time_id = dim_time.time_id GROUP BY dim_location.sub_district_name, dim_time.census_year HAVING SUM(fact_education_health.est_education + fact_education_health.est_human_health_social) >= 0.000 ORDER BY dim_time.census_year, total_sum DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "5a214bd0", "question": "Enumera los nombres de los subdistritos del año 2013 donde la suma estimada de almacenamiento de transporte sea al menos 0.000 y la suma estimada de alojamiento y alimentación sea mayor que 0.000, y ordena los resultados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_TRANSPORT_HOSPITALITY AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_TRANSPORT_STORAGE) >= 0.000 AND SUM(T2.EST_ACCOMMODATION_FOOD) > 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dim_location.sub_district_name\nFROM fact_transport_hospitality\nJOIN dim_location ON fact_transport_hospitality.location_id = dim_location.location_id\nJOIN dim_time ON fact_transport_hospitality.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\nGROUP BY dim_location.sub_district_name\nHAVING SUM(fact_transport_hospitality.est_transport_storage) >= 0 AND SUM(fact_transport_hospitality.est_accommodation_food) > 0\nORDER BY dim_location.sub_district_name ASC;", "raw_output": "SELECT dim_location.sub_district_name\nFROM fact_transport_hospitality\nJOIN dim_location ON fact_transport_hospitality.location_id = dim_location.location_id\nJOIN dim_time ON fact_transport_hospitality.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013\nGROUP BY dim_location.sub_district_name\nHAVING SUM(fact_transport_hospitality.est_transport_storage) >= 0 AND SUM(fact_transport_hospitality.est_accommodation_food) > 0\nORDER BY dim_location.sub_district_name ASC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "57101395", "question": "Para el año censal 2013, enumere los nombres de las aldeas ULB RLB donde el valor estimado de salud humana y trabajo social sea superior a 50.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_HUMAN_HEALTH_SOCIAL > 50", "predicted_sql": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM fact_education_health\nJOIN dim_location ON fact_education_health.location_id = dim_location.location_id\nJOIN dim_time ON fact_education_health.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013 AND fact_education_health.est_human_health_social > 50;", "raw_output": "SELECT DISTINCT dim_location.ulb_rlb_village_name\nFROM fact_education_health\nJOIN dim_location ON fact_education_health.location_id = dim_location.location_id\nJOIN dim_time ON fact_education_health.time_id = dim_time.time_id\nWHERE dim_time.census_year = 2013 AND fact_education_health.est_human_health_social > 50;", "em": 0, "ex": 1, "error": null}
{"pair_id": "e9093393", "question": "Para el año censal 2013, enumere los nombres de las ULB, RLB o aldeas que tengan un valor total estimado de salud humana y trabajo social superior a 50, y ordene los resultados por esta suma en orden descendente.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_HUMAN_HEALTH_SOCIAL) > 50 ORDER BY SUM(T2.EST_HUMAN_HEALTH_SOCIAL) DESC", "predicted_sql": "SELECT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND feh.est_human_health_social > 50\nORDER BY feh.est_human_health_social DESC;", "raw_output": "SELECT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013 AND feh.est_human_health_social > 50\nORDER BY feh.est_human_health_social DESC;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 9. Pred count: 9."}
{"pair_id": "e9ab06a4", "question": "Para el año censal 2013, enumera los nombres de los subdistritos y la suma total estimada de educación y de salud humana y servicios sociales, ordenados por esta suma combinada en orden descendente para los 5 subdistritos principales.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) DESC LIMIT 5", "predicted_sql": "SELECT dl.sub_district_name, SUM(feh.est_education + feh.est_human_health_social) AS total_combined\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_combined DESC\nLIMIT 5;", "raw_output": "SELECT dl.sub_district_name, SUM(feh.est_education + feh.est_human_health_social) AS total_combined\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_combined DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "c197494e", "question": "Para el año censal más reciente disponible, enumere los nombres de los subdistritos y la suma total estimada de educación y de salud humana y servicios sociales, mostrando los 5 subdistritos con los totales combinados más altos.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_EDUCATION + T2.EST_HUMAN_HEALTH_SOCIAL) DESC LIMIT 5", "predicted_sql": "SELECT dl.sub_district_name, SUM(feh.est_education + feh.est_human_health_social) AS total_combined\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_combined DESC\nLIMIT 5;", "raw_output": "SELECT dl.sub_district_name, SUM(feh.est_education + feh.est_human_health_social) AS total_combined\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_combined DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "4b45c0d6", "question": "Para el año censal más reciente disponible, enumere el nombre de cada aldea ULB RLB junto con la suma total de establecimientos de salud humana y servicios sociales, ordenados por la suma total en orden descendente.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_HUMAN_HEALTH_SOCIAL) FROM DIM_LOCATION AS T1 INNER JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID INNER JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY SUM(T2.EST_HUMAN_HEALTH_SOCIAL) DESC", "predicted_sql": "SELECT dl.ulb_rlb_village_name, SUM(feh.est_human_health_social) AS total_health_social_establishments\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.ulb_rlb_village_name\nORDER BY total_health_social_establishments DESC;", "raw_output": "SELECT dl.ulb_rlb_village_name, SUM(feh.est_human_health_social) AS total_health_social_establishments\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.ulb_rlb_village_name\nORDER BY total_health_social_establishments DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "ad513455", "question": "Para el año censal 2013, enumere los nombres de los subdistritos donde el valor estimado de salud humana y trabajo social sea mayor que 0.000, pero la suma total estimada de educación sea exactamente 0.000, ordenados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_HUMAN_HEALTH_SOCIAL > 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_EDUCATION) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND feh.est_human_health_social > 0.000\n  AND feh.est_education = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND feh.est_human_health_social > 0.000\n  AND feh.est_education = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 1141. Pred count: 1378."}
{"pair_id": "f9a67de8", "question": "Enumere los nombres de los subdistritos para el año censal 2013 en los que el valor total estimado de salud humana y trabajo social sea mayor que 0.000 y el valor total estimado de educación sea exactamente 0.000, ordenados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_HUMAN_HEALTH_SOCIAL) > 0.000 AND SUM(T2.EST_EDUCATION) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND feh.est_human_health_social > 0.000\n  AND feh.est_education = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND feh.est_human_health_social > 0.000\n  AND feh.est_education = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 921. Pred count: 1378."}
{"pair_id": "08065fd9", "question": "Enumera los nombres de los subdistritos para el año censal 2013, agrupados por nombre de subdistrito, donde la suma estimada de educación y la suma estimada de salud humana y trabajo social sean ambas al menos 0.000, y ordena los resultados alfabéticamente por nombre de subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_EDUCATION) >= 0.000 AND SUM(T2.EST_HUMAN_HEALTH_SOCIAL) >= 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nHAVING SUM(feh.est_education) >= 0.000 AND SUM(feh.est_human_health_social) >= 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nHAVING SUM(feh.est_education) >= 0.000 AND SUM(feh.est_human_health_social) >= 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "d5b2cc85", "question": "Enumere los nombres de los subdistritos y los nombres de las aldeas ULB/RLB donde el número total de establecimientos propiedad de mujeres sea mayor que el número total de establecimientos propiedad de hombres.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_OWNED_BY_FEMALE) > SUM(T2.EST_OWNED_BY_MALE)", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nWHERE fgo.est_owned_by_female > fgo.est_owned_by_male;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nWHERE fgo.est_owned_by_female > fgo.est_owned_by_male;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 2080. Pred count: 2087."}
{"pair_id": "09a62cf5", "question": "Para el año censal 2013, enumere los nombres de las aldeas ULB RLB y los nombres de sus subdistritos correspondientes, específicamente para las localidades donde la suma de los valores estimados de educación sea al menos 1.000 y la suma de los valores estimados de salud humana y servicios sociales sea al menos 1.000, ordenados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME, T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_EDUCATION_HEALTH AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.ULB_RLB_VILLAGE_NAME, T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_EDUCATION) >= 1.000 AND SUM(T2.EST_HUMAN_HEALTH_SOCIAL) >= 1.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.ulb_rlb_village_name, dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.location_id, dl.ulb_rlb_village_name, dl.sub_district_name\nHAVING SUM(feh.est_education) >= 1.000 AND SUM(feh.est_human_health_social) >= 1.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.ulb_rlb_village_name, dl.sub_district_name\nFROM dim_location dl\nJOIN fact_education_health feh ON dl.location_id = feh.location_id\nJOIN dim_time dt ON feh.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.location_id, dl.ulb_rlb_village_name, dl.sub_district_name\nHAVING SUM(feh.est_education) >= 1.000 AND SUM(feh.est_human_health_social) >= 1.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 753. Pred count: 759."}
{"pair_id": "3222d0c9", "question": "Para el año censal más reciente disponible, enumere el nombre de cada subdistrito junto con la suma total de establecimientos propiedad de mujeres, agrupados por subdistrito y ordenados del total más alto al más bajo.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establecimientos_propiedad_mujeres\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_mujeres DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establecimientos_propiedad_mujeres\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_mujeres DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "58b60029", "question": "Para el año censal más reciente disponible, enumere el nombre de cada subdistrito y la suma total de establecimientos propiedad de mujeres, agrupados por subdistrito y ordenados de mayor a menor suma.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establecimientos_propiedad_mujeres\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_mujeres DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establecimientos_propiedad_mujeres\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_mujeres DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "79e89edd", "question": "Para el año censal 2013, enumere el nombre de cada subdistrito y la suma total de establecimientos propiedad de mujeres, agrupados por subdistrito y ordenados del total más alto al más bajo.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establecimientos_propiedad_mujeres\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_mujeres DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establecimientos_propiedad_mujeres\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_mujeres DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "9e644c4d", "question": "Para el año censal 2013, considerando solo el registro con el ID de tiempo máximo disponible, enumere los nombres de las ULB, RLB o aldeas donde la suma total de establecimientos propiedad de mujeres sea exactamente cero.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T3.TIME_ID = (SELECT MAX(TIME_ID) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_OWNED_BY_FEMALE) = 0.000", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fgo.time_id = (SELECT MAX(time_id) FROM dim_time WHERE census_year = 2013)\n  AND fgo.est_owned_by_female = 0;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fgo.time_id = (SELECT MAX(time_id) FROM dim_time WHERE census_year = 2013)\n  AND fgo.est_owned_by_female = 0;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 14649. Pred count: 15461."}
{"pair_id": "bf70d789", "question": "Para el año censal 2013, enumere los nombres de los subdistritos y el número total de establecimientos propiedad de mujeres para cada subdistrito, mostrando solo los 5 subdistritos con los totales más altos.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC LIMIT 5", "predicted_sql": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establecimientos_propiedad_mujeres\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_mujeres DESC\nLIMIT 5;", "raw_output": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establecimientos_propiedad_mujeres\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_mujeres DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "64e64570", "question": "Para el año censal más reciente disponible, enumere el nombre de cada subdistrito y la suma total de establecimientos propiedad de mujeres, agrupados por subdistrito y ordenados de mayor a menor cantidad.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establecimientos_propiedad_mujeres\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_mujeres DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fgo.est_owned_by_female) AS total_establecimientos_propiedad_mujeres\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_mujeres DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "0783bd49", "question": "Para el año censal 2013, enumere el nombre de cada subdistrito y el nombre de la aldea ULB/RLB junto con el número total de establecimientos propiedad de mujeres, incluyendo solo aquellas ubicaciones donde el recuento de propiedad femenina sea mayor que cero, y ordene los resultados del total de propiedad de mayor a menor.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_OWNED_BY_FEMALE) FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_OWNED_BY_FEMALE) > 0.000 ORDER BY SUM(T2.EST_OWNED_BY_FEMALE) DESC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fgo.est_owned_by_female) AS total_female_owned\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nHAVING SUM(fgo.est_owned_by_female) > 0\nORDER BY total_female_owned DESC;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fgo.est_owned_by_female) AS total_female_owned\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nHAVING SUM(fgo.est_owned_by_female) > 0\nORDER BY total_female_owned DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "47e9d55d", "question": "Para el año censal 2013, enumere los nombres de sub-district y los nombres de village ULB/RLB junto con la suma total de establishments propiedad de Sikhs, agrupados tanto por sub-district como por el nombre de village.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_establishments_owned_by_sikhs\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_establishments_owned_by_sikhs\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "b766b4e4", "question": "Enumere los nombres de los subdistritos, ordenados alfabéticamente, para los registros en los que o bien el año del censo es 2013 y el nombre de la aldea es 'Chouldari (Rv)', o bien el número de establecimientos propiedad de otros géneros es 0.000, asegurando que exista al menos un registro temporal para cada subdistrito.", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME FROM FACT_GENDER_OWNERSHIP AS T1 JOIN DIM_LOCATION AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T1.TIME_ID = T3.TIME_ID WHERE (T3.CENSUS_YEAR = '2013' AND T2.ULB_RLB_VILLAGE_NAME = 'Chouldari (Rv)') OR T1.EST_OWNED_BY_OTHER_GENDER = 0.000 GROUP BY T2.SUB_DISTRICT_NAME HAVING COUNT(T3.TIME_ID) > 0 ORDER BY T2.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE (dt.census_year = 2013 AND dl.ulb_rlb_village_name ILIKE 'Chouldari (Rv)')\n   OR fgo.est_owned_by_other_gender = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE (dt.census_year = 2013 AND dl.ulb_rlb_village_name ILIKE 'Chouldari (Rv)')\n   OR fgo.est_owned_by_other_gender = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "e5c96235", "question": "Para el año censal más reciente disponible, enumere el nombre de cada sub-district junto con el número total de establishments propiedad de Hindus, el total propiedad de Muslims y el total propiedad de Christians, ordenados en orden descendente según la suma combinada de estas tres categorías de propiedad religiosa.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_HINDU), SUM(T2.EST_OWNED_BY_ISLAM), SUM(T2.EST_OWNED_BY_CHRISTIAN) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_HINDU + T2.EST_OWNED_BY_ISLAM + T2.EST_OWNED_BY_CHRISTIAN) DESC", "predicted_sql": "SELECT\n    dl.sub_district_name,\n    SUM(fro.est_owned_by_hindu) AS total_hindu_owned,\n    SUM(fro.est_owned_by_islam) AS total_muslim_owned,\n    SUM(fro.est_owned_by_christian) AS total_christian_owned\nFROM dim_time dt\nJOIN fact_religious_ownership fro ON dt.time_id = fro.time_id\nJOIN dim_location dl ON fro.location_id = dl.location_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY (SUM(fro.est_owned_by_hindu) + SUM(fro.est_owned_by_islam) + SUM(fro.est_owned_by_christian)) DESC;", "raw_output": "SELECT\n    dl.sub_district_name,\n    SUM(fro.est_owned_by_hindu) AS total_hindu_owned,\n    SUM(fro.est_owned_by_islam) AS total_muslim_owned,\n    SUM(fro.est_owned_by_christian) AS total_christian_owned\nFROM dim_time dt\nJOIN fact_religious_ownership fro ON dt.time_id = fro.time_id\nJOIN dim_location dl ON fro.location_id = dl.location_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY (SUM(fro.est_owned_by_hindu) + SUM(fro.est_owned_by_islam) + SUM(fro.est_owned_by_christian)) DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "1d4a3e0b", "question": "Para el año censal 2013, enumere los nombres de los subdistritos donde el número de establecimientos propiedad de mujeres sea mayor que cero, asegurándose de que cada nombre de subdistrito se incluya solo si tiene al menos un registro.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_GENDER_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_OWNED_BY_FEMALE > 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING COUNT(T1.SUB_DISTRICT_NAME) > 0", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fgo.est_owned_by_female > 0;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_gender_ownership fgo ON dl.location_id = fgo.location_id\nJOIN dim_time dt ON fgo.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fgo.est_owned_by_female > 0;", "em": 0, "ex": 1, "error": null}
{"pair_id": "b04846f6", "question": "Enumere los nombres de los subdistritos y el número total de establecimientos propiedad de sijes para el período de tiempo con ID 1, agrupados por subdistrito y ordenados por el recuento más alto primero, mostrando solo los 5 resultados principales.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.TIME_ID = 1 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_SIKH) DESC LIMIT 5", "predicted_sql": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_establishments_owned_by_sikh\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nWHERE fro.time_id = 1\nGROUP BY dl.sub_district_name\nORDER BY total_establishments_owned_by_sikh DESC\nLIMIT 5;", "raw_output": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_establishments_owned_by_sikh\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nWHERE fro.time_id = 1\nGROUP BY dl.sub_district_name\nORDER BY total_establishments_owned_by_sikh DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "cb5b8b67", "question": "Enumere los nombres de sub-district para el año censal 2013, ordenados por el número estimado de religious properties propiedad de Sikhs en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' ORDER BY T2.EST_OWNED_BY_SIKH DESC", "predicted_sql": "SELECT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nORDER BY fro.est_owned_by_sikh DESC;", "raw_output": "SELECT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nORDER BY fro.est_owned_by_sikh DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "9382a4a2", "question": "Para el año censal 2013, enumere el nombre de cada sub-district y la suma total de establishments propiedad de Sikhs, ordenados en orden descendente por esa suma total.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_SIKH) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_sikh_owned_establishments\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_sikh_owned_establishments DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_sikh_owned_establishments\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name\nORDER BY total_sikh_owned_establishments DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "c7d19184", "question": "Para el año censal 2013, enumere los nombres de sub-district y los nombres de village ULB/RLB junto con la suma total de establishments propiedad de Sikhs, agrupados por sub-district y nombre de village y ordenados por la suma en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME ORDER BY SUM(T2.EST_OWNED_BY_SIKH) DESC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_establishments_owned_by_sikhs\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nORDER BY total_establishments_owned_by_sikhs DESC;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_establishments_owned_by_sikhs\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nORDER BY total_establishments_owned_by_sikhs DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a80ce3c9", "question": "Para el año censal 2013, enumere los nombres de los subdistritos y los nombres de las aldeas ULB/RLB para las ubicaciones donde la propiedad estimada de los sijes sea mayor o igual a 0.000, ordenados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T2.EST_OWNED_BY_SIKH >= 0.000 AND T3.CENSUS_YEAR = '2013' ORDER BY T1.SUB_DISTRICT_NAME", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fro.est_owned_by_sikh >= 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fro.est_owned_by_sikh >= 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a994e9a8", "question": "Para el año censal 2013, enumere el nombre de cada subdistrito y el nombre de la aldea ULB/RLB, junto con la suma total de establecimientos propiedad de sijes, donde dicha suma sea al menos cero, y ordene los resultados por la suma total en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_OWNED_BY_SIKH >= 0.000 GROUP BY T1.SUB_DISTRICT_NAME, T1.ULB_RLB_VILLAGE_NAME HAVING SUM(T2.EST_OWNED_BY_SIKH) >= 0.000 ORDER BY SUM(T2.EST_OWNED_BY_SIKH) DESC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_establecimientos_sijes\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nHAVING SUM(fro.est_owned_by_sikh) >= 0\nORDER BY total_establecimientos_sijes DESC;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, SUM(fro.est_owned_by_sikh) AS total_establecimientos_sijes\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name\nHAVING SUM(fro.est_owned_by_sikh) >= 0\nORDER BY total_establecimientos_sijes DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "e591a0fb", "question": "Enumera los nombres de los subdistritos del año censal 2013 donde haya al menos un establecimiento propiedad de sijes, pero la suma total de establecimientos propiedad de jainistas en ese subdistrito sea exactamente cero.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' AND T2.EST_OWNED_BY_SIKH > 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_OWNED_BY_JAIN) = 0.000", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fro.est_owned_by_sikh > 0\n  AND dl.location_id IN (\n      SELECT dl2.location_id\n      FROM dim_location dl2\n      JOIN fact_religious_ownership fro2 ON dl2.location_id = fro2.location_id\n      JOIN dim_time dt2 ON fro2.time_id = dt2.time_id\n      WHERE dt2.census_year = 2013\n      GROUP BY dl2.sub_district_name, dl2.location_id\n      HAVING SUM(fro2.est_owned_by_jain) = 0\n  );", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fro.est_owned_by_sikh > 0\n  AND dl.location_id IN (\n      SELECT dl2.location_id\n      FROM dim_location dl2\n      JOIN fact_religious_ownership fro2 ON dl2.location_id = fro2.location_id\n      JOIN dim_time dt2 ON fro2.time_id = dt2.time_id\n      WHERE dt2.census_year = 2013\n      GROUP BY dl2.sub_district_name, dl2.location_id\n      HAVING SUM(fro2.est_owned_by_jain) = 0\n  );", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 351. Pred count: 374."}
{"pair_id": "2ad8247d", "question": "Enumere los nombres de los subdistritos para el año censal 2013 donde el número total de establecimientos propiedad de sijes sea mayor que cero y el número total de establecimientos propiedad de jainistas sea exactamente cero, agrupados y ordenados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_OWNED_BY_SIKH) > 0.000 AND SUM(T2.EST_OWNED_BY_JAIN) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fro.est_owned_by_sikh > 0\n  AND fro.est_owned_by_jain = 0\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND fro.est_owned_by_sikh > 0\n  AND fro.est_owned_by_jain = 0\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 286. Pred count: 374."}
{"pair_id": "3fffc294", "question": "Enumera los nombres de los subdistritos donde, para el año censal 2013, ya sea el número total de establecimientos propiedad de sijes o el número total de establecimientos propiedad de jainistas sea mayor que 500.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_OWNED_BY_SIKH) > 500 OR SUM(T2.EST_OWNED_BY_JAIN) > 500", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND (fro.est_owned_by_sikh > 500 OR fro.est_owned_by_jain > 500);", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nJOIN dim_time dt ON fro.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND (fro.est_owned_by_sikh > 500 OR fro.est_owned_by_jain > 500);", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 4. Pred count: 1."}
{"pair_id": "ffc386b1", "question": "Enumere los nombres de los subdistritos y el número total de establecimientos propiedad de sijes, específicamente para aquellos cuyo estado de comercio minorista es '1.000', agrupados por subdistrito y ordenados por la suma de establecimientos propiedad de sijes en orden descendente para los 5 primeros resultados.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_OWNED_BY_SIKH) FROM DIM_LOCATION AS T1 JOIN FACT_RELIGIOUS_OWNERSHIP AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN FACT_TRADE_SECTOR AS T3 ON T2.LOCATION_ID = T3.LOCATION_ID WHERE T3.EST_RETAIL_TRADE = '1.000' GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_OWNED_BY_SIKH) DESC LIMIT 5", "predicted_sql": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_establecimientos_propiedad_sikh\nFROM dim_location dl\nJOIN fact_trade_sector fts ON dl.location_id = fts.location_id\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nWHERE fts.est_retail_trade = 1.000\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_sikh DESC\nLIMIT 5;", "raw_output": "SELECT dl.sub_district_name, SUM(fro.est_owned_by_sikh) AS total_establecimientos_propiedad_sikh\nFROM dim_location dl\nJOIN fact_trade_sector fts ON dl.location_id = fts.location_id\nJOIN fact_religious_ownership fro ON dl.location_id = fro.location_id\nWHERE fts.est_retail_trade = 1.000\nGROUP BY dl.sub_district_name\nORDER BY total_establecimientos_propiedad_sikh DESC\nLIMIT 5;", "em": 0, "ex": 1, "error": null}
{"pair_id": "f279081a", "question": "Para cada subdistrito, enumere el nombre del subdistrito, el financiamiento total estimado de las instituciones de préstamo y el financiamiento total estimado de los préstamos de grupos de autoayuda, ordenados por el financiamiento total estimado de las instituciones de préstamo en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_FINANCE_BORROW_INSTITUTION), SUM(T2.EST_FINANCE_LOAN_SELF_HELP_GROUP) FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_FINANCE_BORROW_INSTITUTION) DESC", "predicted_sql": "SELECT \n    dl.sub_district_name,\n    SUM(ffs.est_finance_borrow_institution) AS total_finance_borrow_institution,\n    SUM(ffs.est_finance_loan_self_help_group) AS total_finance_loan_self_help_group\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nGROUP BY dl.sub_district_name\nORDER BY total_finance_borrow_institution DESC;", "raw_output": "SELECT \n    dl.sub_district_name,\n    SUM(ffs.est_finance_borrow_institution) AS total_finance_borrow_institution,\n    SUM(ffs.est_finance_loan_self_help_group) AS total_finance_loan_self_help_group\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nGROUP BY dl.sub_district_name\nORDER BY total_finance_borrow_institution DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "4d623596", "question": "Enumere el nombre del subdistrito, el nombre de la aldea ULB/RLB y el nombre del distrito para los distritos de Chittoor, South Andamans y Nicobars, asegurándose de que cada combinación tenga al menos un ID de ubicación, y ordene los resultados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME, T1.DISTRICT_NAME FROM DIM_DISTRICT AS T1 INNER JOIN DIM_LOCATION AS T2 ON T1.DISTRICT_ID = T2.DISTRICT_ID WHERE T1.DISTRICT_NAME IN ('Chittoor', 'South Andamans', 'Nicobars') GROUP BY T2.SUB_DISTRICT_NAME, T2.ULB_RLB_VILLAGE_NAME, T1.DISTRICT_NAME HAVING COUNT(T2.LOCATION_ID) >= 1 ORDER BY T2.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, dd.district_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nWHERE dd.district_name ILIKE 'Chittoor' OR dd.district_name ILIKE 'South Andamans' OR dd.district_name ILIKE 'Nicobars'\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name, dd.district_name\nHAVING COUNT(dl.location_id) >= 1\nORDER BY dl.sub_district_name;", "raw_output": "SELECT dl.sub_district_name, dl.ulb_rlb_village_name, dd.district_name\nFROM dim_location dl\nJOIN dim_district dd ON dl.district_id = dd.district_id\nWHERE dd.district_name ILIKE 'Chittoor' OR dd.district_name ILIKE 'South Andamans' OR dd.district_name ILIKE 'Nicobars'\nGROUP BY dl.sub_district_name, dl.ulb_rlb_village_name, dd.district_name\nHAVING COUNT(dl.location_id) >= 1\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 95. Pred count: 95."}
{"pair_id": "414ab4d4", "question": "Enumere los nombres de las ULB, RLB o aldeas, ordenados alfabéticamente, que tengan un monto estimado de financiamiento de asistencia gubernamental de 0.000 y un monto estimado de financiamiento de préstamo de grupos de autoayuda de 0.000.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.EST_FINANCE_GOVT_ASSISTANCE = 0.000 AND T2.EST_FINANCE_LOAN_SELF_HELP_GROUP = 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000\nORDER BY dl.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000\nORDER BY dl.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "0d4f65de", "question": "Para cada nombre de subdistrito en la categoría del sector rural, enumere el nombre del subdistrito junto con el financiamiento total estimado proveniente de préstamos institucionales y el financiamiento total estimado proveniente de préstamos de grupos de autoayuda, siempre que el total de préstamos institucionales sea mayor que cero, y ordene los resultados por el total de préstamos institucionales en orden descendente.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_FINANCE_BORROW_INSTITUTION) AS total_institutional_borrowing, SUM(T2.EST_FINANCE_LOAN_SELF_HELP_GROUP) AS total_shg_loans FROM DIM_LOCATION AS T1 INNER JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID INNER JOIN DIM_SECTOR_CATEGORY AS T3 ON T2.SECTOR_ID = T3.SECTOR_ID WHERE T3.SECTOR_CATEGORY = 'Rural' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_FINANCE_BORROW_INSTITUTION) > 0.000 ORDER BY total_institutional_borrowing DESC", "predicted_sql": "SELECT dl.sub_district_name,\n       SUM(ffs.est_finance_borrow_institution) AS total_institutional_loans,\n       SUM(ffs.est_finance_loan_self_help_group) AS total_self_help_group_loans\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_sector_category dsc ON ffs.sector_id = dsc.sector_id\nWHERE dsc.sector_category ILIKE 'Rural'\nGROUP BY dl.sub_district_name\nHAVING SUM(ffs.est_finance_borrow_institution) > 0\nORDER BY total_institutional_loans DESC;", "raw_output": "SELECT dl.sub_district_name,\n       SUM(ffs.est_finance_borrow_institution) AS total_institutional_loans,\n       SUM(ffs.est_finance_loan_self_help_group) AS total_self_help_group_loans\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_sector_category dsc ON ffs.sector_id = dsc.sector_id\nWHERE dsc.sector_category ILIKE 'Rural'\nGROUP BY dl.sub_district_name\nHAVING SUM(ffs.est_finance_borrow_institution) > 0\nORDER BY total_institutional_loans DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "fba7fb6b", "question": "Enumera los nombres de las ULB, RLB o aldeas que tengan al menos un registro de fuente de financiamiento, pero específicamente donde la asistencia gubernamental estimada sea 0.000 y el préstamo estimado de los grupos de autoayuda también sea 0.000, ordenados alfabéticamente por el nombre de la aldea.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.EST_FINANCE_GOVT_ASSISTANCE = 0.000 AND T2.EST_FINANCE_LOAN_SELF_HELP_GROUP = 0.000 GROUP BY T1.ULB_RLB_VILLAGE_NAME HAVING COUNT(T2.FACT_FINANCE_SOURCES_ID) > 0 ORDER BY T1.ULB_RLB_VILLAGE_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000\nORDER BY dl.ulb_rlb_village_name;", "raw_output": "SELECT DISTINCT dl.ulb_rlb_village_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000\nORDER BY dl.ulb_rlb_village_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "d08fd177", "question": "Para el año censal más reciente disponible, enumere el nombre de cada subdistrito y el total estimado de la asistencia financiera gubernamental, agrupados por el nombre del subdistrito y ordenados del total de asistencia más alto al más bajo.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME, SUM(T2.EST_FINANCE_GOVT_ASSISTANCE) FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.SUB_DISTRICT_NAME ORDER BY SUM(T2.EST_FINANCE_GOVT_ASSISTANCE) DESC", "predicted_sql": "SELECT dl.sub_district_name, SUM(ffs.est_finance_govt_assistance) AS total_asistencia_gobierno\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_asistencia_gobierno DESC;", "raw_output": "SELECT dl.sub_district_name, SUM(ffs.est_finance_govt_assistance) AS total_asistencia_gobierno\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.sub_district_name\nORDER BY total_asistencia_gobierno DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "bb7e100c", "question": "Enumere los nombres de los subdistritos para el año censal 2013 donde el financiamiento total estimado de asistencia gubernamental sea mayor que 0.000 y el financiamiento total estimado de grupos de autoayuda con préstamos sea exactamente 0.000.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_FINANCE_GOVT_ASSISTANCE) > 0.000 AND SUM(T2.EST_FINANCE_LOAN_SELF_HELP_GROUP) = 0.000", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND ffs.est_finance_govt_assistance > 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND ffs.est_finance_govt_assistance > 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: False). Gold count: 1965. Pred count: 2361."}
{"pair_id": "c4e8af4a", "question": "Enumera los nombres de los subdistritos, ordenados alfabéticamente, de todos los subdistritos que tengan al menos un registro de fuente de financiamiento en el que tanto la asistencia financiera gubernamental estimada como el monto estimado prestado por instituciones sean iguales a 0.000.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T2.EST_FINANCE_GOVT_ASSISTANCE = 0.000 AND T2.EST_FINANCE_BORROW_INSTITUTION = 0.000 GROUP BY T1.SUB_DISTRICT_NAME HAVING COUNT(T2.FACT_FINANCE_SOURCES_ID) > 0 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000 AND ffs.est_finance_borrow_institution = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000 AND ffs.est_finance_borrow_institution = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "471bea0a", "question": "Enumere los nombres de los subdistritos, ordenados alfabéticamente, de las áreas donde la financiación estimada de la asistencia gubernamental es 0.000 y la financiación estimada tomada en préstamo de instituciones también es 0.000.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID WHERE T2.EST_FINANCE_GOVT_ASSISTANCE = 0.000 AND T2.EST_FINANCE_BORROW_INSTITUTION = 0.000 GROUP BY T1.SUB_DISTRICT_NAME ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000\n  AND ffs.est_finance_borrow_institution = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nWHERE ffs.est_finance_govt_assistance = 0.000\n  AND ffs.est_finance_borrow_institution = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 1, "error": null}
{"pair_id": "a457d390", "question": "Para el año censal más reciente disponible, enumere el nombre de cada aldea ULB/RLB junto con la asistencia financiera gubernamental total estimada y el financiamiento total estimado de instituciones de crédito, agrupados por nombre de aldea y ordenados por la asistencia gubernamental total en orden descendente.", "gold_sql": "SELECT T1.ULB_RLB_VILLAGE_NAME, SUM(T2.EST_FINANCE_GOVT_ASSISTANCE), SUM(T2.EST_FINANCE_BORROW_INSTITUTION) FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = (SELECT MAX(CENSUS_YEAR) FROM DIM_TIME) GROUP BY T1.ULB_RLB_VILLAGE_NAME ORDER BY SUM(T2.EST_FINANCE_GOVT_ASSISTANCE) DESC", "predicted_sql": "SELECT\n    dl.ulb_rlb_village_name,\n    SUM(ffs.est_finance_govt_assistance) AS total_government_assistance,\n    SUM(ffs.est_finance_borrow_institution) AS total_institutional_finance\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.ulb_rlb_village_name\nORDER BY total_government_assistance DESC;", "raw_output": "SELECT\n    dl.ulb_rlb_village_name,\n    SUM(ffs.est_finance_govt_assistance) AS total_government_assistance,\n    SUM(ffs.est_finance_borrow_institution) AS total_institutional_finance\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = (SELECT MAX(census_year) FROM dim_time)\nGROUP BY dl.ulb_rlb_village_name\nORDER BY total_government_assistance DESC;", "em": 0, "ex": 1, "error": null}
{"pair_id": "309a5f49", "question": "Enumere los nombres de los subdistritos del año censal 2013 donde el financiamiento total estimado de asistencia gubernamental sea mayor que 0.000 y el financiamiento total estimado de los grupos de autoayuda con préstamos sea exactamente 0.000, ordenados alfabéticamente por el nombre del subdistrito.", "gold_sql": "SELECT T1.SUB_DISTRICT_NAME FROM DIM_LOCATION AS T1 JOIN FACT_FINANCE_SOURCES AS T2 ON T1.LOCATION_ID = T2.LOCATION_ID JOIN DIM_TIME AS T3 ON T2.TIME_ID = T3.TIME_ID WHERE T3.CENSUS_YEAR = '2013' GROUP BY T1.SUB_DISTRICT_NAME HAVING SUM(T2.EST_FINANCE_GOVT_ASSISTANCE) > 0.000 AND SUM(T2.EST_FINANCE_LOAN_SELF_HELP_GROUP) = 0.000 ORDER BY T1.SUB_DISTRICT_NAME ASC", "predicted_sql": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND ffs.est_finance_govt_assistance > 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000\nORDER BY dl.sub_district_name;", "raw_output": "SELECT DISTINCT dl.sub_district_name\nFROM dim_location dl\nJOIN fact_finance_sources ffs ON dl.location_id = ffs.location_id\nJOIN dim_time dt ON ffs.time_id = dt.time_id\nWHERE dt.census_year = 2013\n  AND ffs.est_finance_govt_assistance > 0.000\n  AND ffs.est_finance_loan_self_help_group = 0.000\nORDER BY dl.sub_district_name;", "em": 0, "ex": 0, "error": "Mismatch (Order matters: True). Gold count: 1965. Pred count: 2361."}
